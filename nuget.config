<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come from nuget.org only: a machine-wide or user feed can never supply one (docs/design/diagnostics-and-upkeep.md
     §3.2, dependencies-2). Versions are in Directory.Packages.props; there are no lock files before 1.0.0. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
