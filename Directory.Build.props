<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The channel separates data directory, single-instance identity and credential namespace.
         Without an explicit channel, Release builds (dotnet publish) use "release", the channel of published builds,
         which the interface does not name; every other build uses "dev", so a dev run, test or agent preview never
         opens or migrates a published build's data. scripts/daily.sh stamps the owner's daily channel explicitly. -->
    <MindweaveChannel Condition="'$(MindweaveChannel)' == '' and '$(Configuration)' == 'Release'">release</MindweaveChannel>
    <MindweaveChannel Condition="'$(MindweaveChannel)' == ''">dev</MindweaveChannel>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="MindweaveChannel" Value="$(MindweaveChannel)" />
  </ItemGroup>
</Project>
