<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A fixed number, so a new SDK never brings new analyzer warnings by itself; raising it is one deliberate line
         (docs/design/diagnostics-and-upkeep.md §3.2, ci-build-7). -->
    <AnalysisLevel>10.0</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The channel separates data directory, single-instance identity and credential namespace.
         Without an explicit channel, Release builds (dotnet publish) use "release", the channel of published builds,
         which the interface does not name; every other build uses "dev", so a dev run, test or agent preview never
         opens or migrates a published build's data. scripts/daily.sh stamps the owner's daily channel explicitly. -->
    <MindweaveChannel Condition="'$(MindweaveChannel)' == '' and '$(Configuration)' == 'Release'">release</MindweaveChannel>
    <MindweaveChannel Condition="'$(MindweaveChannel)' == ''">dev</MindweaveChannel>
    <!-- Release builds record source paths as /_/… instead of the folder they were built in, so neither the binaries
         nor stack traces carry the build machine's paths. -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    <!-- The third number rises with every merge into main; the owner calls the second (docs/design/versioning.md).
         The commit tells daily and dev builds apart. -->
    <Version>0.6.33</Version>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="MindweaveChannel" Value="$(MindweaveChannel)" />
  </ItemGroup>
</Project>
