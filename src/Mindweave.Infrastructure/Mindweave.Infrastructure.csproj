<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Source-generated P/Invoke for Keychain and Windows Credential Manager. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mindweave.Application\Mindweave.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Text of PDF files (resources, architecture §15.1). -->
    <PackageReference Include="PdfPig" />
    <!-- Image probing and scaling; the same version Avalonia.Skia brings to the desktop app. -->
    <PackageReference Include="SkiaSharp" />
    <!-- The MCP client (architecture §15.14); only here, behind IMcpConnector. -->
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mindweave.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Mindweave.TestHost" />
    <InternalsVisibleTo Include="Mindweave.Desktop.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The page a shared file shows (docs/design/sharing.md §6.2), filled in by SharePage. -->
    <EmbeddedResource Include="Share\SharePage.html" LogicalName="Share.SharePage.html" />
    <!-- KaTeX 0.19.1 as published: draws the formulas of a shared page (docs/design/sharing.md §6.7). Only a share with a formula carries it. -->
    <EmbeddedResource Include="Share\katex\LICENSE" LogicalName="Share.katex.LICENSE" />
    <EmbeddedResource Include="Share\katex\*.min.*" LogicalName="Share.katex.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Share\katex\fonts\*.woff2" LogicalName="Share.katex.fonts.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
