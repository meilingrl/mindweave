<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Mindweave.Desktop"
             xmlns:lm="using:LiveMarkdown.Avalonia"
             xmlns:ratex="using:RaTeX.Avalonia"
             x:Class="Mindweave.Desktop.App"
             Name="Mindweave"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>
  <Application.Resources>
    <!--
      Every colour is a theme resource (D-022): the light and dark dictionaries define the same keys, pages and the
      network canvas only refer to them (DynamicResource / FindResource), so switching the theme needs no restart.
      Light keeps the warm greys of S1–S6; dark is the network sample's palette (s7-prototype-visual-language.md).
    -->
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- Pages -->
          <SolidColorBrush x:Key="WindowBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBackground">#F5F5F4</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackground">#F5F5F4</SolidColorBrush>
          <SolidColorBrush x:Key="DialogBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="ScrimBrush">#66000000</SolidColorBrush>
          <BoxShadows x:Key="DialogShadow">0 12 32 0 #33000000</BoxShadows>
          <SolidColorBrush x:Key="DividerBrush">#E7E5E4</SolidColorBrush>
          <SolidColorBrush x:Key="OutlineBrush">#D6D3D1</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryText">#1C1917</SolidColorBrush>
          <SolidColorBrush x:Key="MutedText">#78716C</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorText">#B91C1C</SolidColorBrush>
          <SolidColorBrush x:Key="WarningText">#B45309</SolidColorBrush>
          <SolidColorBrush x:Key="DangerText">#B91C1C</SolidColorBrush>
          <SolidColorBrush x:Key="LinkText">#2563EB</SolidColorBrush>
          <SolidColorBrush x:Key="SelectedRow">#E7E5E4</SolidColorBrush>
          <SolidColorBrush x:Key="HoverRow">#EFEEEC</SolidColorBrush>
          <SolidColorBrush x:Key="SourceHighlight">#FDE68A</SolidColorBrush>
          <SolidColorBrush x:Key="QuoteBar">#D6D3D1</SolidColorBrush>
          <!-- Shared styles -->
          <SolidColorBrush x:Key="AccentBrush">#4B6BFB</SolidColorBrush>
          <SolidColorBrush x:Key="AccentHoverBrush">#3756E8</SolidColorBrush>
          <SolidColorBrush x:Key="AccentPressedBrush">#2B47CC</SolidColorBrush>
          <SolidColorBrush x:Key="OnAccentText">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeAccentBackground">#E2E8FF</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeAccentText">#2B47CC</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeNeutralBackground">#EEEDEB</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeNeutralText">#57534E</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeWarningBackground">#FDF0D5</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeWarningText">#92400E</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeInfoBackground">#EEF2FF</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeInfoBorder">#C7D2FE</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeInfoIcon">#4B6BFB</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeWarningBackground">#FEF6E4</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeWarningBorder">#F5D9A3</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeWarningIcon">#B45309</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeErrorBackground">#FDECEC</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeErrorBorder">#F5C2C2</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeErrorIcon">#B91C1C</SolidColorBrush>
          <!-- Conversation page and sidebar (S7 round 2) -->
          <SolidColorBrush x:Key="QuestionBubbleBackground">#F0EFED</SolidColorBrush>
          <SolidColorBrush x:Key="CardBackground">#F7F7F6</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorder">#ECEAE8</SolidColorBrush>
          <SolidColorBrush x:Key="CardHover">#EDECEA</SolidColorBrush>
          <SolidColorBrush x:Key="NavIcon">#8A847F</SolidColorBrush>
          <SolidColorBrush x:Key="TreeGuide">#C4C0BC</SolidColorBrush>
          <SolidColorBrush x:Key="QuietActionText">#57534E</SolidColorBrush>
          <SolidColorBrush x:Key="DisabledButtonBackground">#EEEDEB</SolidColorBrush>
          <!-- Scroll bars: a faint thin thumb at rest, a little stronger when hovered (Fluent's own keys) -->
          <Color x:Key="ScrollBarPanningThumbBackgroundColor">#33000000</Color>
          <SolidColorBrush x:Key="ScrollBarPanningThumbBackground">#2E1C1917</SolidColorBrush>
          <Color x:Key="ScrollBarThumbBackgroundColor">#66000000</Color>
          <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver">#57534E</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollBarThumbFillPressed">#44403C</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver">#0A000000</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver">#0A000000</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollBarButtonArrowForeground">#A8A29E</SolidColorBrush>
          <!-- Network canvas: the sample's behaviour in light colours -->
          <SolidColorBrush x:Key="NetworkBackground">#FCFCFB</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkGridDot">#E2E0DD</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkNode">#4B6BFB</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkNodeRead">#8E99B8</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkNodeTrail">#2B47CC</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkNodeHover">#6F89FF</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkUnreadDot">#2B47CC</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkHaloSelected">#DCE3FF</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkHaloHover">#E9EDFB</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkRingSelected">#2B47CC</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkRingMatch">#D97706</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkLabel">#1F2430</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkLabelRead">#6B7280</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkLabelActive">#0B1020</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkCaption">#8A8F99</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkEdge">#D3D7DE</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkEdgeIndirect">#A3A9B6</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkEdgeNear">#7E8698</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkEdgeTrail">#5B78F5</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkFrame">#E7E5E4</SolidColorBrush>
          <!-- Text fields (Fluent's own keys), so inputs match the page in both themes -->
          <SolidColorBrush x:Key="TextControlBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#FAFAF9</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBackgroundFocused">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBackgroundDisabled">#F5F5F4</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBorderBrush">#D6D3D1</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#A8A29E</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBorderBrushFocused">#4B6BFB</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlForeground">#1C1917</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlForegroundPointerOver">#1C1917</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlForegroundFocused">#1C1917</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlPlaceholderForeground">#A8A29E</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver">#A8A29E</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused">#A8A29E</SolidColorBrush>
          <!-- LiveMarkdown's own keys (its defaults assume a dark surface) -->
          <Color x:Key="ForegroundColor">#1C1917</Color>
          <Color x:Key="BorderColor">#E7E5E4</Color>
          <Color x:Key="CardBackgroundColor">#FAFAF9</Color>
          <Color x:Key="SecondaryCardBackgroundColor">#F3F2F0</Color>
          <Color x:Key="CodeInlineColor">#9D174D</Color>
          <Color x:Key="QuoteBorderColor">#D6D3D1</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBackground">#18191B</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBackground">#1D1E22</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackground">#1D1E22</SolidColorBrush>
          <SolidColorBrush x:Key="DialogBackground">#222327</SolidColorBrush>
          <SolidColorBrush x:Key="ScrimBrush">#99000000</SolidColorBrush>
          <BoxShadows x:Key="DialogShadow">0 16 40 0 #8C000000</BoxShadows>
          <SolidColorBrush x:Key="DividerBrush">#2C2E33</SolidColorBrush>
          <SolidColorBrush x:Key="OutlineBrush">#3A3D45</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryText">#E6E8EE</SolidColorBrush>
          <SolidColorBrush x:Key="MutedText">#9299A6</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorText">#F2A0A0</SolidColorBrush>
          <SolidColorBrush x:Key="WarningText">#DFB87C</SolidColorBrush>
          <SolidColorBrush x:Key="DangerText">#F2A0A0</SolidColorBrush>
          <SolidColorBrush x:Key="LinkText">#A9B8F5</SolidColorBrush>
          <SolidColorBrush x:Key="SelectedRow">#2A2D35</SolidColorBrush>
          <SolidColorBrush x:Key="HoverRow">#24262C</SolidColorBrush>
          <SolidColorBrush x:Key="SourceHighlight">#5A4A1E</SolidColorBrush>
          <SolidColorBrush x:Key="QuoteBar">#3A3D45</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#5A72E6</SolidColorBrush>
          <SolidColorBrush x:Key="AccentHoverBrush">#6C83F2</SolidColorBrush>
          <SolidColorBrush x:Key="AccentPressedBrush">#4C63D2</SolidColorBrush>
          <SolidColorBrush x:Key="OnAccentText">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeAccentBackground">#26324D</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeAccentText">#C1C6FA</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeNeutralBackground">#2A2C31</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeNeutralText">#A3A9B5</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeWarningBackground">#3A2F17</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeWarningText">#DFB87C</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeInfoBackground">#1F2638</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeInfoBorder">#2F3A57</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeInfoIcon">#A9B8F5</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeWarningBackground">#2E2717</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeWarningBorder">#4A3C1E</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeWarningIcon">#DFB87C</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeErrorBackground">#33201F</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeErrorBorder">#55302F</SolidColorBrush>
          <SolidColorBrush x:Key="NoticeErrorIcon">#F2A0A0</SolidColorBrush>
          <SolidColorBrush x:Key="QuestionBubbleBackground">#26282E</SolidColorBrush>
          <SolidColorBrush x:Key="CardBackground">#1E1F23</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorder">#2A2C31</SolidColorBrush>
          <SolidColorBrush x:Key="CardHover">#272A31</SolidColorBrush>
          <SolidColorBrush x:Key="NavIcon">#7E8594</SolidColorBrush>
          <SolidColorBrush x:Key="TreeGuide">#4A4E57</SolidColorBrush>
          <SolidColorBrush x:Key="QuietActionText">#B4BAC6</SolidColorBrush>
          <SolidColorBrush x:Key="DisabledButtonBackground">#2A2C31</SolidColorBrush>
          <Color x:Key="ScrollBarPanningThumbBackgroundColor">#38FFFFFF</Color>
          <SolidColorBrush x:Key="ScrollBarPanningThumbBackground">#2EFFFFFF</SolidColorBrush>
          <Color x:Key="ScrollBarThumbBackgroundColor">#66FFFFFF</Color>
          <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver">#8B919C</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollBarThumbFillPressed">#A3A9B5</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver">#0DFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver">#0DFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollBarButtonArrowForeground">#737985</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkBackground">#18191B</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkGridDot">#292B30</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkNode">#B4BACD</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkNodeRead">#747B88</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkNodeTrail">#BDC9F2</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkNodeHover">#E2E8FF</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkUnreadDot">#A3B8EE</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkHaloSelected">#26324D</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkHaloHover">#282E3C</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkRingSelected">#C1C6FA</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkRingMatch">#DFB87C</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkLabel">#CBD0DA</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkLabelRead">#8B919C</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkLabelActive">#F0F2FF</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkCaption">#858B97</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkEdge">#363A42</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkEdgeIndirect">#626577</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkEdgeNear">#7F899E</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkEdgeTrail">#AAB8F5</SolidColorBrush>
          <SolidColorBrush x:Key="NetworkFrame">Transparent</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBackground">#222327</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#26282D</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBackgroundFocused">#1D1E22</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBackgroundDisabled">#1D1E22</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBorderBrush">#3A3D45</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#4A4E58</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBorderBrushFocused">#6C83F2</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlForeground">#E6E8EE</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlForegroundPointerOver">#E6E8EE</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlForegroundFocused">#E6E8EE</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlPlaceholderForeground">#737985</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver">#737985</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused">#737985</SolidColorBrush>
          <Color x:Key="ForegroundColor">#E6E8EE</Color>
          <Color x:Key="BorderColor">#2C2E33</Color>
          <Color x:Key="CardBackgroundColor">#1D1E22</Color>
          <Color x:Key="SecondaryCardBackgroundColor">#25272C</Color>
          <Color x:Key="CodeInlineColor">#F0A6C8</Color>
          <Color x:Key="QuoteBorderColor">#3A3D45</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="AnswerFontFamily">PingFang SC, Microsoft YaHei UI, Microsoft YaHei, Noto Sans CJK SC, Noto Sans SC, Source Han Sans SC, $Default</FontFamily>
      <x:Double x:Key="DisplayFormulaFontSize">17</x:Double>
      <!-- Icons (16×16, filled; S7 round 2). Shared so a toolbar or list draws each glyph the same everywhere. -->
      <StreamGeometry x:Key="IconRename">M10.6,1.6 L14.4,5.4 L5.4,14.4 L1.5,14.5 L1.6,10.6 Z M3.1,11.2 L3,13 L4.8,12.9 L12.3,5.4 L10.6,3.7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSummary">M3,1 H13 V15 H3 Z M4.5,2.5 V13.5 H11.5 V2.5 Z M6,4.8 H10 V6.1 H6 Z M6,7.4 H10 V8.7 H6 Z M6,10 H8.6 V11.3 H6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSummarize">M2,2.5 H14 V4 H2 Z M2,6.5 H11.5 V8 H2 Z M2,10.5 H9 V12 H2 Z M12.5,9 L15,11.25 L12.5,13.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconArchive">M1,2 H15 V6 H1 Z M2.5,3.4 V4.6 H13.5 V3.4 Z M2,7 H3.5 V13.5 H12.5 V7 H14 V15 H2 Z M6,8.5 H10 V9.9 H6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconDelete">M5.5,1 H10.5 V2.5 H14 V4 H2 V2.5 H5.5 Z M3,5 H13 L12.2,15 H3.8 Z M4.6,6.5 L5.2,13.5 H10.8 L11.4,6.5 Z M6.4,7.5 H7.6 V12.5 H6.4 Z M8.4,7.5 H9.6 V12.5 H8.4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRegenerate">M8,2 A6,6 0 1 0 14,8 H12.5 A4.5,4.5 0 1 1 8,3.5 V5.5 L11,2.75 L8,0 Z</StreamGeometry>
      <StreamGeometry x:Key="IconStop">M3.5,3.5 H12.5 V12.5 H3.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconReturn">M6,2 L1,6.5 L6,11 V8 H10 A3,3 0 0 1 10,14 H8 V15.5 H10 A4.5,4.5 0 0 0 10,6.5 H6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBranch">M3.5,1 H5 V7.5 C5,9.6 6.6,11 8.8,11 H11 V8.6 L14.8,11.75 L11,14.9 V12.5 H8.8 C5.8,12.5 3.5,10.4 3.5,7.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconChevron">M5.5,2.5 L11,8 L5.5,13.5 L4.4,12.4 L8.8,8 L4.4,3.6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPlus">M7.25,2 H8.75 V7.25 H14 V8.75 H8.75 V14 H7.25 V8.75 H2 V7.25 H7.25 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBack">M7,2.5 L1.5,8 L7,13.5 L8.06,12.44 L4.37,8.75 H14.5 V7.25 H4.37 L8.06,3.56 Z</StreamGeometry>
      <StreamGeometry x:Key="IconExplore">M2,2 H14 V11.5 H7 L4,14.5 V11.5 H2 Z M3.5,3.5 V10 H5.5 V10.9 L6.4,10 H12.5 V3.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconNetwork">F1 M3,7.3 L13,2.3 L13,3.7 L3,8.7 Z M3,7.3 L13,12.3 L13,13.7 L3,8.7 Z M3,5.5 A2.5,2.5 0 1 1 3,10.5 A2.5,2.5 0 1 1 3,5.5 Z M13,1 A2,2 0 1 1 13,5 A2,2 0 1 1 13,1 Z M13,11 A2,2 0 1 1 13,15 A2,2 0 1 1 13,11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">F1 M1.5,3.25 H14.5 V4.75 H1.5 Z M1.5,11.25 H14.5 V12.75 H1.5 Z M5,1.75 A2.25,2.25 0 1 1 5,6.25 A2.25,2.25 0 1 1 5,1.75 Z M11,9.75 A2.25,2.25 0 1 1 11,14.25 A2.25,2.25 0 1 1 11,9.75 Z</StreamGeometry>
      <StreamGeometry x:Key="IconTreeBranch">M2,0 H3.4 V6.3 H9 V7.7 H2 Z</StreamGeometry>
      <!-- ===== Round 3 · shell (resources): the sidebar toggle glyph, a window with its left pane. ===== -->
      <StreamGeometry x:Key="IconSidebar">F1 M1,2.5 H15 V13.5 H1 Z M2.4,3.9 V12.1 H5.3 V3.9 Z M6.7,3.9 V12.1 H13.6 V3.9 Z</StreamGeometry>
      <!-- ===== end Round 3 · shell (resources) ===== -->
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#4B6BFB" />
        <ColorPaletteResources x:Key="Dark" Accent="#6C83F2" RegionColor="#18191B" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <!-- Answer typography. -->
    <Style Selector="Border.QuoteBlock">
      <Setter Property="Background" Value="{DynamicResource SidebarBackground}" />
    </Style>
    <Style Selector="StackPanel.MarkdownDocument">
      <Setter Property="Spacing" Value="8" />
    </Style>
    <!--
      Answer text puts a font with CJK glyphs first. With LiveMarkdown's Latin-only default, CJK characters come from
      a fallback font, and Avalonia 12.1.4 reuses the previous run's fallback typeface, weight included, for the next
      run: bold spread over the rest of a list item and never started in a paragraph that began plain.
      List numbers and bullets use it too, so digits in a marker match those in the item (their LiveMarkdown style has
      a class selector, so this one needs one as well to take precedence). The trade-off: Latin letters and digits in
      answers come from the CJK face, not Inter as in the rest of the interface. Code blocks bind their own monospaced family and are not affected.
    -->
    <Style Selector="lm|MarkdownTextBlock, TextBlock.ListBlockNumber, TextBlock.ListBlockBullet">
      <Setter Property="FontFamily" Value="{StaticResource AnswerFontFamily}" />
    </Style>
    <!-- Display formulas ($$…$$, \[…\]) are centred blocks, a little larger than body text as in print. -->
    <Style Selector="lm|MarkdownTextBlock.MathBlock">
      <Setter Property="FontSize" Value="{StaticResource DisplayFormulaFontSize}" />
    </Style>
    <Style Selector="ratex|FormulaControl.MathBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningText}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorText}" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
    </Style>
    <!-- A name in a list that opens it: primary colour; a read one regular and secondary (the weight comes from the item). -->
    <Style Selector="Button.list-name">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.list-name.read">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="Button.list-name:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
    </Style>
    <!-- Sidebar rows: navigation and the conversation tree. Hover is a faint row, selection a stronger one with the accent icon. -->
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
    </Style>
    <Style Selector="Button.nav PathIcon.nav-icon">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource NavIcon}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav.selected PathIcon.nav-icon">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- The 已归档（N） entry: quieter than navigation, at the bottom of the tree. -->
    <Style Selector="Button.nav.subtle">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Button.nav.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>

    <!-- Fluent's dark expander is pure black; both themes use the panel surface instead. -->
    <Style Selector="Expander">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>

    <!-- Buttons, three levels (S7 共用样式): primary (at most one per view), secondary (outline), quiet (toolbars). -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentText}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentText}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentText}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Padding" Value="13,5" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector=":is(Button).quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="ToggleButton.quiet:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>

    <!-- Notices: info / warning / error, icon on the left (a TextBlock.notice-icon inside). -->
    <Style Selector="Border.notice">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="Border.notice.info">
      <Setter Property="Background" Value="{DynamicResource NoticeInfoBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NoticeInfoBorder}" />
    </Style>
    <Style Selector="Border.notice.warning">
      <Setter Property="Background" Value="{DynamicResource NoticeWarningBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NoticeWarningBorder}" />
    </Style>
    <Style Selector="Border.notice.error">
      <Setter Property="Background" Value="{DynamicResource NoticeErrorBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NoticeErrorBorder}" />
    </Style>
    <!-- Not the label inside a notice's button: it inherits the button's own foreground (link, on-accent, danger, disabled). -->
    <Style Selector="Border.notice TextBlock:not(Button TextBlock)">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.notice TextBlock.notice-icon">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.notice.info TextBlock.notice-icon">
      <Setter Property="Foreground" Value="{DynamicResource NoticeInfoIcon}" />
    </Style>
    <Style Selector="Border.notice.warning TextBlock.notice-icon">
      <Setter Property="Foreground" Value="{DynamicResource NoticeWarningIcon}" />
    </Style>
    <Style Selector="Border.notice.error TextBlock.notice-icon">
      <Setter Property="Foreground" Value="{DynamicResource NoticeErrorIcon}" />
    </Style>

    <!-- Badges: small rounded tags (未读 accent, 已读 neutral, 候选 warning …). -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="7,1,7,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackground}" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource BadgeNeutralText}" />
    </Style>
    <Style Selector="Border.badge.accent">
      <Setter Property="Background" Value="{DynamicResource BadgeAccentBackground}" />
    </Style>
    <Style Selector="Border.badge.accent > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BadgeAccentText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.badge.warning">
      <Setter Property="Background" Value="{DynamicResource BadgeWarningBackground}" />
    </Style>
    <Style Selector="Border.badge.warning > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BadgeWarningText}" />
    </Style>

    <!-- Disabled buttons keep their level's look, only muted: a quiet or link button never turns into a grey block. -->
    <Style Selector=":is(Button).quiet:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <!-- A disabled primary is a neutral surface with muted text: a faded accent still read as enabled on dark. -->
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DisabledButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector=":is(Button).quiet PathIcon, Button.secondary PathIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Smaller quiet buttons for the row under an answer: a soft text colour until hovered, clearly fainter when disabled. -->
    <Style Selector=":is(Button).quiet.small">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Foreground" Value="{DynamicResource QuietActionText}" />
    </Style>
    <Style Selector=":is(Button).quiet.small:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector=":is(Button).quiet.small:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector=":is(Button).quiet.small PathIcon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <!-- A notice's action sits right after its text, not at the far edge; it reads as a link-coloured quiet button. -->
    <Style Selector="Border.notice Button">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.notice Button.quiet">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.notice Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
    </Style>

    <!-- Breadcrumb links: muted, the accent only on hover. -->
    <Style Selector="Button.crumb">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.crumb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
    </Style>

    <!-- Conversation page: question bubble, cards (source, branches), composer. -->
    <Style Selector="Border.question">
      <Setter Property="Background" Value="{DynamicResource QuestionBubbleBackground}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Border.question SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.quote">
      <Setter Property="BorderBrush" Value="{DynamicResource QuoteBar}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="10,1,0,1" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="Button.entry">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.entry:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHover}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.entry PathIcon.entry-icon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,3,10,0" />
    </Style>
    <Style Selector="Button.entry PathIcon.entry-chevron">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.entry:pointerover PathIcon.entry-chevron">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.composer">
      <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Border.composer:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}" />
    </Style>
    <!-- The input inside the composer has no frame of its own in any state; the composer draws it. -->
    <Style Selector="Border.composer TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.composer TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.composer TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Running and needs-attention markers in the sidebar: a small accent dot, a small round "!". -->
    <Style Selector="Ellipse.running-dot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.attention-badge">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="CornerRadius" Value="7.5" />
      <Setter Property="Background" Value="{DynamicResource NoticeErrorBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NoticeErrorBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.attention-badge > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource NoticeErrorIcon}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A small "still writing" mark at the end of a streaming answer. -->
    <Style Selector="Ellipse.typing">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="5" />
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Long scroll areas (answers, the sidebar tree): the faint thin scroll bar shows only while the pointer is over the area. -->
    <Style Selector="ScrollViewer.autohide /template/ ScrollBar#PART_VerticalScrollBar">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ScrollViewer.autohide:pointerover /template/ ScrollBar#PART_VerticalScrollBar">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ===== Round 3 · shell: sidebar toggle and splitter, dialogs, archived rows ===== -->
    <!-- The collapse / expand toggle: a familiar icon-only control, the tooltip names it and its shortcut. -->
    <Style Selector="Button.quiet.sidebar-toggle">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource NavIcon}" />
    </Style>
    <Style Selector="Button.quiet.sidebar-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.quiet.sidebar-toggle PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Ellipse.sidebar-attention">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Fill" Value="{DynamicResource NoticeErrorIcon}" />
      <Setter Property="Stroke" Value="{DynamicResource WindowBackground}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,-3,-4,0" />
    </Style>
    <!-- The splitter: invisible at rest (the sidebar's own divider shows), an accent line while hovered or dragged. -->
    <Style Selector="Border.sidebar-splitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>
    <Style Selector="Border.sidebar-splitter > Border.sidebar-splitter-line">
      <Setter Property="Width" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.sidebar-splitter:pointerover > Border.sidebar-splitter-line, Border.sidebar-splitter.dragging > Border.sidebar-splitter-line">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- A quiet small action that removes something keeps the danger colour (the small style would otherwise soften it). -->
    <Style Selector=":is(Button).quiet.small.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
    <Style Selector=":is(Button).quiet.small.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
    <!-- Archived page rows: the whole row lights up on hover; the name opens, the actions sit at the right. -->
    <Style Selector="Border.archived-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Border.archived-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
    </Style>
    <Style Selector="Button.list-name.archived-name">
      <Setter Property="Padding" Value="2,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.list-name.archived-name:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Dialogs: one surface for every prompt over the window — title, short message, buttons right-aligned with one primary. -->
    <Style Selector="Border.dialog-scrim">
      <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="{DynamicResource DialogBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24,22,24,20" />
      <Setter Property="Width" Value="420" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BoxShadow" Value="{DynamicResource DialogShadow}" />
    </Style>
    <Style Selector="Border.dialog TextBlock.dialog-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Border.dialog TextBlock.dialog-body">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="Border.dialog StackPanel.dialog-buttons">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <!-- Explore home: a soft round mark above the page's one primary action. -->
    <Style Selector="Border.home-mark">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="Background" Value="{DynamicResource BadgeAccentBackground}" />
    </Style>
    <Style Selector="Border.home-mark > PathIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Foreground" Value="{DynamicResource BadgeAccentText}" />
    </Style>
    <!-- Recovery page: backups as rows in a card, the date first. -->
    <Style Selector="Border.backup-row">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- ===== end Round 3 · shell ===== -->
  </Application.Styles>
</Application>
