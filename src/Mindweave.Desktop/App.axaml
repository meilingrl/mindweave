<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Mindweave.Desktop" x:Class="Mindweave.Desktop.App" Name="Mindweave Codex" RequestedThemeVariant="Light">
  <Application.DataTemplates><local:ViewLocator /></Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#252831" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="14,10" /></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#4F5C48" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="12,10" /></Style>
  </Application.Styles>
  <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Application.Resources>
</Application>
