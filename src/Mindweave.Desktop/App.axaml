<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Mindweave.Desktop"
             xmlns:v="using:Mindweave.Desktop.Views"
             xmlns:lm="using:LiveMarkdown.Avalonia"
             xmlns:ratex="using:RaTeX.Avalonia"
             x:Class="Mindweave.Desktop.App"
             Name="Mindweave"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
        <!-- Colours and shadows per theme (Light and Dark side by side), then the shared icon geometries. -->
        <MergeResourceInclude Source="/Themes/Colors.axaml" />
        <MergeResourceInclude Source="/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="AnswerFontFamily">PingFang SC, Microsoft YaHei UI, Microsoft YaHei, Noto Sans CJK SC, Noto Sans SC, Source Han Sans SC, $Default</FontFamily>
      <x:Double x:Key="DisplayFormulaFontSize">17</x:Double>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#4B6BFB" />
        <ColorPaletteResources x:Key="Dark" Accent="#6C83F2" RegionColor="#18191B" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <!-- Shared control classes first: the area files after them refine those classes, and a later style wins. -->
    <StyleInclude Source="/Styles/Controls.axaml" />
    <StyleInclude Source="/Styles/Conversation.axaml" />
    <StyleInclude Source="/Styles/Sidebar.axaml" />
    <!-- Archived page rows: the whole row lights up on hover; the name opens, the actions sit at the right. -->
    <Style Selector="Border.archived-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Border.archived-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
    </Style>
    <Style Selector="Button.list-name.archived-name">
      <Setter Property="Padding" Value="2,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.list-name.archived-name:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Dialogs: one surface for every prompt over the window — title, short message, buttons right-aligned with one primary. -->
    <Style Selector="Border.dialog-scrim">
      <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="{DynamicResource DialogBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24,22,24,20" />
      <Setter Property="Width" Value="420" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BoxShadow" Value="{DynamicResource DialogShadow}" />
    </Style>
    <Style Selector="Border.dialog TextBlock.dialog-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Border.dialog TextBlock.dialog-body">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="Border.dialog StackPanel.dialog-buttons">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <!-- Explore home: a soft round mark above the page's one primary action. -->
    <Style Selector="Border.home-mark">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="Background" Value="{DynamicResource BadgeAccentBackground}" />
    </Style>
    <Style Selector="Border.home-mark > PathIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Foreground" Value="{DynamicResource BadgeAccentText}" />
    </Style>
    <!-- Recovery page: backups as rows in a card, the date first. -->
    <Style Selector="Border.backup-row">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- ▼ S7 round 3 · settings: section headings and cards, segmented control, suggestion list -->
    <!-- A settings section: a heading above a card of aligned label/field rows. -->
    <Style Selector="TextBlock.section-heading">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Margin" Value="2,0,0,8" />
    </Style>
    <Style Selector="Border.card.settings">
      <Setter Property="Padding" Value="18,16" />
    </Style>
    <Style Selector="Border.card.settings TextBlock.field-label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <!--
      Segmented control: one rounded track, segments side by side, the chosen one raised and filled. The segments
      are radio buttons (one group), so they keep their accessibility role; the arrow keys are handled by the page.
    -->
    <Style Selector="Border.segmented">
      <Setter Property="Background" Value="{DynamicResource SegmentedTrack}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="RadioButton.segment">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Segment" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="RadioButton.segment:pointerover:unchecked /template/ Border#PART_Segment">
      <Setter Property="Background" Value="{DynamicResource SegmentedHover}" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#PART_Segment">
      <Setter Property="Background" Value="{DynamicResource SegmentedSelected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SegmentedSelectedBorder}" />
      <Setter Property="BoxShadow" Value="{DynamicResource SegmentedShadow}" />
    </Style>
    <Style Selector="RadioButton.segment:focus-visible /template/ Border#PART_Segment">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="RadioButton.segment PathIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource NavIcon}" />
    </Style>
    <Style Selector="RadioButton.segment:checked PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- A small icon button inside a text field (the model list's arrow). -->
    <Style Selector="Button.field-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Margin" Value="0,0,1,0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.field-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.field-toggle PathIcon">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
    </Style>
    <!-- Suggestions under a field: a floating card of plain rows; the highlighted row is a neutral band, not accent. -->
    <Style Selector="Border.suggestions">
      <Setter Property="Background" Value="{DynamicResource DialogBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Margin" Value="0,4,0,12" />
      <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}" />
    </Style>
    <Style Selector="Border.suggestions ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.suggestions ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.suggestions ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Border.suggestions ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <!-- The provider picker is framed like the text fields in the same card, at rest and under the pointer. -->
    <Style Selector="ComboBox.settings">
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
    </Style>
    <Style Selector="ComboBox.settings:pointerover /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushPointerOver}" />
    </Style>
    <Style Selector="ComboBox.settings:focus-visible /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}" />
    </Style>
    <!-- The provider list: the same neutral rows instead of Fluent's accent selection. -->
    <Style Selector="ComboBox.settings ComboBoxItem">
      <Setter Property="Padding" Value="11,6" />
    </Style>
    <Style Selector="ComboBox.settings ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="ComboBox.settings ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="ComboBox.settings ComboBoxItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- A file path: selectable, wraps anywhere, the same size as the other values in its column. -->
    <Style Selector="SelectableTextBlock.path">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Application.Styles>
</Application>
