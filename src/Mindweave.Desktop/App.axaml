      <StreamGeometry x:Key="IconStop">M3.5,3.5 H12.5 V12.5 H3.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconReturn">M6,2 L1,6.5 L6,11 V8 H10 A3,3 0 0 1 10,14 H8 V15.5 H10 A4.5,4.5 0 0 0 10,6.5 H6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBranch">M3.5,1 H5 V7.5 C5,9.6 6.6,11 8.8,11 H11 V8.6 L14.8,11.75 L11,14.9 V12.5 H8.8 C5.8,12.5 3.5,10.4 3.5,7.5 Z</StreamGeometry>
