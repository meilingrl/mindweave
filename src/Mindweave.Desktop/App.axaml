      <StreamGeometry x:Key="IconExplore">M2,2 H14 V11.5 H7 L4,14.5 V11.5 H2 Z M3.5,3.5 V10 H5.5 V10.9 L6.4,10 H12.5 V3.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconNetwork">F1 M3,7.3 L13,2.3 L13,3.7 L3,8.7 Z M3,7.3 L13,12.3 L13,13.7 L3,8.7 Z M3,5.5 A2.5,2.5 0 1 1 3,10.5 A2.5,2.5 0 1 1 3,5.5 Z M13,1 A2,2 0 1 1 13,5 A2,2 0 1 1 13,1 Z M13,11 A2,2 0 1 1 13,15 A2,2 0 1 1 13,11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">F1 M1.5,3.25 H14.5 V4.75 H1.5 Z M1.5,11.25 H14.5 V12.75 H1.5 Z M5,1.75 A2.25,2.25 0 1 1 5,6.25 A2.25,2.25 0 1 1 5,1.75 Z M11,9.75 A2.25,2.25 0 1 1 11,14.25 A2.25,2.25 0 1 1 11,9.75 Z</StreamGeometry>
      <StreamGeometry x:Key="IconTreeBranch">M2,0 H3.4 V6.3 H9 V7.7 H2 Z</StreamGeometry>
      <!-- ▼ S7 round 3 · settings: icons (16×16) -->
