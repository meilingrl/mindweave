<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Mindweave.Desktop"
             x:Class="Mindweave.Desktop.App"
             Name="Mindweave"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
        <!-- Colours and shadows per theme (Light and Dark side by side), then the shared corner radii and icon geometries. -->
        <MergeResourceInclude Source="/Themes/Colors.axaml" />
        <MergeResourceInclude Source="/Themes/Radii.axaml" />
        <MergeResourceInclude Source="/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="AnswerFontFamily">PingFang SC, Microsoft YaHei UI, Microsoft YaHei, Noto Sans CJK SC, Noto Sans SC, Source Han Sans SC, $Default</FontFamily>
      <x:Double x:Key="DisplayFormulaFontSize">17</x:Double>
      <!-- Answer body text: 1.7 times its 14 px size (the font's own spacing is 1.4, tight for Chinese; chosen 2026-11-21). -->
      <x:Double x:Key="AnswerLineHeight">24</x:Double>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#4B6BFB" />
        <ColorPaletteResources x:Key="Dark" Accent="#6C83F2" RegionColor="#18191B" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <!-- Shared control classes first: the area files after them refine those classes, and a later style wins. -->
    <StyleInclude Source="/Styles/Controls.axaml" />
    <StyleInclude Source="/Styles/Conversation.axaml" />
    <StyleInclude Source="/Styles/Sidebar.axaml" />
    <StyleInclude Source="/Styles/Dialogs.axaml" />
    <StyleInclude Source="/Styles/Pages.axaml" />
    <StyleInclude Source="/Styles/Settings.axaml" />
    <StyleInclude Source="/Styles/WorkspaceSwitcher.axaml" />
    <StyleInclude Source="/Styles/Attachments.axaml" />
    <StyleInclude Source="/Styles/Runs.axaml" />
  </Application.Styles>
</Application>
