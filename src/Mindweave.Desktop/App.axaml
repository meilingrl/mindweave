      <StreamGeometry x:Key="IconMonitor">M1.5,2 H14.5 V11.5 H1.5 Z M3,3.5 V10 H13 V3.5 Z M7.25,11.5 H8.75 V13 H7.25 Z M4.75,13 H11.25 V14.5 H4.75 Z</StreamGeometry>
      <StreamGeometry x:Key="IconChevronDown">M2.5,5.5 L8,11 L13.5,5.5 L12.4,4.4 L8,8.8 L3.6,4.4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M1,2.5 H6.2 L7.7,4 H15 V13.5 H1 Z M2.5,5.5 V12 H13.5 V5.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconStorage">M1.5,2 H14.5 V6.5 H1.5 Z M3,3.5 V5 H13 V3.5 Z M1.5,9 H14.5 V13.5 H1.5 Z M3,10.5 V12 H13 V10.5 Z M10.5,3.6 H12 V4.9 H10.5 Z M10.5,10.6 H12 V11.9 H10.5 Z</StreamGeometry>
      <!-- ▲ S7 round 3 · settings -->
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#4B6BFB" />
        <ColorPaletteResources x:Key="Dark" Accent="#6C83F2" RegionColor="#18191B" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <!-- Answer typography. -->
    <Style Selector="Border.QuoteBlock">
      <Setter Property="Background" Value="{DynamicResource SidebarBackground}" />
    </Style>
    <Style Selector="StackPanel.MarkdownDocument">
      <Setter Property="Spacing" Value="8" />
    </Style>
    <!--
      Answer text puts a font with CJK glyphs first. With LiveMarkdown's Latin-only default, CJK characters come from
      a fallback font, and Avalonia 12.1.4 reuses the previous run's fallback typeface, weight included, for the next
      run: bold spread over the rest of a list item and never started in a paragraph that began plain.
      List numbers and bullets use it too, so digits in a marker match those in the item (their LiveMarkdown style has
      a class selector, so this one needs one as well to take precedence). The trade-off: Latin letters and digits in
      answers come from the CJK face, not Inter as in the rest of the interface. Code blocks bind their own monospaced family and are not affected.
    -->
    <Style Selector="lm|MarkdownTextBlock, TextBlock.ListBlockNumber, TextBlock.ListBlockBullet">
      <Setter Property="FontFamily" Value="{StaticResource AnswerFontFamily}" />
    </Style>
    <!-- Display formulas ($$…$$, \[…\]) are centred blocks, a little larger than body text as in print. -->
    <Style Selector="lm|MarkdownTextBlock.MathBlock">
      <Setter Property="FontSize" Value="{StaticResource DisplayFormulaFontSize}" />
    </Style>
    <Style Selector="ratex|FormulaControl.MathBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningText}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorText}" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
    </Style>
    <!-- A name in a list that opens it: primary colour; a read one regular and secondary (the weight comes from the item). -->
    <Style Selector="Button.list-name">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.list-name.read">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="Button.list-name:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
    </Style>
    <!-- Sidebar rows: navigation and the conversation tree. Hover is a faint row, selection a stronger one with the accent icon. -->
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
    </Style>
    <Style Selector="Button.nav PathIcon.nav-icon">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource NavIcon}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav.selected PathIcon.nav-icon">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- The 已归档（N） entry: quieter than navigation, at the bottom of the tree. -->
    <Style Selector="Button.nav.subtle">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Button.nav.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>

    <!-- Fluent's dark expander is pure black; both themes use the panel surface instead. -->
    <Style Selector="Expander">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>

    <!-- Buttons, three levels (S7 共用样式): primary (at most one per view), secondary (outline), quiet (toolbars). -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentText}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentText}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentText}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Padding" Value="13,5" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector=":is(Button).quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="ToggleButton.quiet:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>

    <!-- Notices: info / warning / error, icon on the left (a TextBlock.notice-icon inside). -->
    <Style Selector="Border.notice">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="Border.notice.info">
      <Setter Property="Background" Value="{DynamicResource NoticeInfoBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NoticeInfoBorder}" />
    </Style>
    <Style Selector="Border.notice.warning">
      <Setter Property="Background" Value="{DynamicResource NoticeWarningBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NoticeWarningBorder}" />
    </Style>
    <Style Selector="Border.notice.error">
      <Setter Property="Background" Value="{DynamicResource NoticeErrorBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NoticeErrorBorder}" />
    </Style>
    <!-- Not the label inside a notice's button: it inherits the button's own foreground (link, on-accent, danger, disabled). -->
    <Style Selector="Border.notice TextBlock:not(Button TextBlock)">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.notice TextBlock.notice-icon">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.notice.info TextBlock.notice-icon">
      <Setter Property="Foreground" Value="{DynamicResource NoticeInfoIcon}" />
    </Style>
    <Style Selector="Border.notice.warning TextBlock.notice-icon">
      <Setter Property="Foreground" Value="{DynamicResource NoticeWarningIcon}" />
    </Style>
    <Style Selector="Border.notice.error TextBlock.notice-icon">
      <Setter Property="Foreground" Value="{DynamicResource NoticeErrorIcon}" />
    </Style>

    <!-- Badges: small rounded tags (未读 accent, 已读 neutral, 候选 warning …). -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="7,1,7,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackground}" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource BadgeNeutralText}" />
    </Style>
    <Style Selector="Border.badge.accent">
      <Setter Property="Background" Value="{DynamicResource BadgeAccentBackground}" />
    </Style>
    <Style Selector="Border.badge.accent > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BadgeAccentText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.badge.warning">
      <Setter Property="Background" Value="{DynamicResource BadgeWarningBackground}" />
    </Style>
    <Style Selector="Border.badge.warning > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BadgeWarningText}" />
    </Style>

    <!-- Disabled buttons keep their level's look, only muted: a quiet or link button never turns into a grey block. -->
    <Style Selector=":is(Button).quiet:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <!-- A disabled primary is a neutral surface with muted text: a faded accent still read as enabled on dark. -->
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DisabledButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector=":is(Button).quiet PathIcon, Button.secondary PathIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Smaller quiet buttons for the row under an answer: a soft text colour until hovered, clearly fainter when disabled. -->
    <Style Selector=":is(Button).quiet.small">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Foreground" Value="{DynamicResource QuietActionText}" />
    </Style>
    <Style Selector=":is(Button).quiet.small:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector=":is(Button).quiet.small:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector=":is(Button).quiet.small PathIcon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <!-- A notice's action sits right after its text, not at the far edge; it reads as a link-coloured quiet button. -->
    <Style Selector="Border.notice Button">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.notice Button.quiet">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.notice Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
    </Style>

    <!-- Breadcrumb links: muted, the accent only on hover. -->
    <Style Selector="Button.crumb">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.crumb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
    </Style>

    <!-- Conversation page: question bubble, cards (source, branches), composer. -->
    <Style Selector="Border.question">
      <Setter Property="Background" Value="{DynamicResource QuestionBubbleBackground}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Border.question SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.quote">
      <Setter Property="BorderBrush" Value="{DynamicResource QuoteBar}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="10,1,0,1" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="Button.entry">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.entry:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHover}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.entry PathIcon.entry-icon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,3,10,0" />
    </Style>
    <Style Selector="Button.entry PathIcon.entry-chevron">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.entry:pointerover PathIcon.entry-chevron">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.composer">
      <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Border.composer:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}" />
    </Style>
    <!-- The input inside the composer has no frame of its own in any state; the composer draws it. -->
    <Style Selector="Border.composer TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.composer TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.composer TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Running and needs-attention markers in the sidebar: a small accent dot, a small round "!". -->
    <Style Selector="Ellipse.running-dot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.attention-badge">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="CornerRadius" Value="7.5" />
      <Setter Property="Background" Value="{DynamicResource NoticeErrorBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NoticeErrorBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.attention-badge > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource NoticeErrorIcon}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A small "still writing" mark at the end of a streaming answer. -->
    <Style Selector="Ellipse.typing">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="5" />
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Long scroll areas (answers, the sidebar tree): the faint thin scroll bar shows only while the pointer is over the area. -->
    <Style Selector="ScrollViewer.autohide /template/ ScrollBar#PART_VerticalScrollBar">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ScrollViewer.autohide:pointerover /template/ ScrollBar#PART_VerticalScrollBar">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ▼ S7 round 3 · settings: section headings and cards, segmented control, suggestion list -->
    <!-- A settings section: a heading above a card of aligned label/field rows. -->
    <Style Selector="TextBlock.section-heading">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Margin" Value="2,0,0,8" />
    </Style>
    <Style Selector="Border.card.settings">
      <Setter Property="Padding" Value="18,16" />
    </Style>
    <Style Selector="Border.card.settings TextBlock.field-label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <!--
      Segmented control: one rounded track, segments side by side, the chosen one raised and filled. The segments
      are radio buttons (one group), so they keep their accessibility role; the arrow keys are handled by the page.
    -->
    <Style Selector="Border.segmented">
      <Setter Property="Background" Value="{DynamicResource SegmentedTrack}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="RadioButton.segment">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Segment" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="RadioButton.segment:pointerover:unchecked /template/ Border#PART_Segment">
      <Setter Property="Background" Value="{DynamicResource SegmentedHover}" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#PART_Segment">
      <Setter Property="Background" Value="{DynamicResource SegmentedSelected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SegmentedSelectedBorder}" />
      <Setter Property="BoxShadow" Value="{DynamicResource SegmentedShadow}" />
    </Style>
    <Style Selector="RadioButton.segment:focus-visible /template/ Border#PART_Segment">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="RadioButton.segment PathIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource NavIcon}" />
    </Style>
    <Style Selector="RadioButton.segment:checked PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- A small icon button inside a text field (the model list's arrow). -->
    <Style Selector="Button.field-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Margin" Value="0,0,1,0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.field-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.field-toggle PathIcon">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
    </Style>
    <!-- Suggestions under a field: a floating card of plain rows; the highlighted row is a neutral band, not accent. -->
    <Style Selector="Border.suggestions">
      <Setter Property="Background" Value="{DynamicResource DialogBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Margin" Value="0,4,0,12" />
      <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}" />
    </Style>
    <Style Selector="Border.suggestions ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.suggestions ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.suggestions ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Border.suggestions ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <!-- The provider list: the same neutral rows instead of Fluent's accent selection. -->
    <Style Selector="ComboBox.settings ComboBoxItem">
      <Setter Property="Padding" Value="11,6" />
    </Style>
    <Style Selector="ComboBox.settings ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="ComboBox.settings ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="ComboBox.settings ComboBoxItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- A file path: selectable, slightly smaller, wraps anywhere. -->
    <Style Selector="SelectableTextBlock.path">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- ▲ S7 round 3 · settings -->
  </Application.Styles>
</Application>
