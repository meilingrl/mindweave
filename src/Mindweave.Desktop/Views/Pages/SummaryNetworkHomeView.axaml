<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Pages"
             xmlns:v="using:Mindweave.Desktop.Views.Pages"
             xmlns:d="using:Mindweave.Desktop"
             xmlns:t="using:Mindweave.Desktop.Text"
             xmlns:views="using:Mindweave.Desktop.Views"
             xmlns:sn="using:Mindweave.Desktop.SummaryNetwork"
             x:Class="Mindweave.Desktop.Views.Pages.SummaryNetworkHomeView"
             x:DataType="vm:SummaryNetworkHomeViewModel">
  <UserControl.KeyBindings>
    <!-- "关联到…" waiting for a click: Esc leaves it (only while it waits). -->
    <KeyBinding Gesture="Escape" Command="{Binding CancelPickCommand}" />
  </UserControl.KeyBindings>
  <DockPanel>
    <!-- Toolbar: one quiet style throughout (S7): the 空间 | 时间线 switch, find, show all, zoom. Nothing to arrange or save
         (layouts are computed). -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" IsVisible="{Binding !IsEmpty}">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Each view is its own tab stop, so the keyboard reaches both (Space or Enter switches). -->
        <Border Name="ViewModePicker" Classes="segmented" Margin="0,0,8,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <RadioButton Name="SpatialViewButton" Classes="segment" GroupName="SummaryNetworkView" Padding="12,3" IsChecked="{Binding !IsTimeline, Mode=OneWay}"
                         Content="{x:Static t:UiText.ViewSpatial}" AutomationProperties.Name="{x:Static t:UiText.ViewSpatial}"
                         Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static sn:SummaryNetworkViewMode.Spatial}" />
            <RadioButton Name="TimelineViewButton" Classes="segment" GroupName="SummaryNetworkView" Padding="12,3" IsChecked="{Binding IsTimeline, Mode=OneWay}"
                         Content="{x:Static t:UiText.ViewTimeline}" AutomationProperties.Name="{x:Static t:UiText.ViewTimeline}"
                         Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static sn:SummaryNetworkViewMode.Timeline}" />
          </StackPanel>
        </Border>
        <TextBox Name="FindBox" Text="{Binding SearchText}" PlaceholderText="{x:Static t:UiText.FindWatermark}" Width="120" Margin="0,0,6,0" VerticalAlignment="Center">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding FindCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Name="ShowAllButton" Classes="quiet" Command="{Binding ShowAllCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="13" Height="13" Data="{StaticResource IconShowAll}" />
            <TextBlock Text="{x:Static t:UiText.ShowAll}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <!-- The same drawn glyph for both, so − and ＋ match in weight and width on every font. -->
        <Button Name="ZoomOutButton" Classes="quiet" Command="{Binding ZoomOutCommand}" ToolTip.Tip="{x:Static t:UiText.ZoomOut}" AutomationProperties.Name="{x:Static t:UiText.ZoomOut}" MinWidth="30">
          <PathIcon Width="12" Height="12" Data="{StaticResource IconZoomOut}" />
        </Button>
        <Button Name="ZoomInButton" Classes="quiet" Command="{Binding ZoomInCommand}" ToolTip.Tip="{x:Static t:UiText.ZoomIn}" AutomationProperties.Name="{x:Static t:UiText.ZoomIn}" MinWidth="30">
          <PathIcon Width="12" Height="12" Data="{StaticResource IconZoomIn}" />
        </Button>
        <ToggleButton Name="ListViewToggle" Classes="quiet" IsChecked="{Binding IsListView}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="13" Height="13" Data="{StaticResource IconListView}" />
            <TextBlock Text="{x:Static t:UiText.ListView}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <!-- Recommended nodes (§10.3.2): only when they are on and a summary exists to extend. -->
        <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowsRecommendationTools}">
          <Button Name="RefreshRecommendedNodesButton" Classes="quiet" Command="{Binding RefreshRecommendationsCommand}"
                  ToolTip.Tip="{x:Static t:UiText.RefreshRecommendedNodesTip}" ToolTip.ShowOnDisabled="True"
                  AutomationProperties.Name="{x:Static t:UiText.RefreshRecommendedNodes}" AutomationProperties.HelpText="{x:Static t:UiText.RefreshRecommendedNodesTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource IconRegenerate}" />
              <TextBlock Text="{x:Static t:UiText.RefreshRecommendedNodesButton}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="ToggleRecommendedNodesButton" Classes="quiet" Command="{Binding ToggleRecommendationsCommand}"
                  ToolTip.Tip="{x:Static t:UiText.HideRecommendedNodesTip}"
                  AutomationProperties.Name="{Binding ToggleRecommendationsLabel}" AutomationProperties.HelpText="{x:Static t:UiText.HideRecommendedNodesTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="14" Height="14" Data="{StaticResource IconEye}" />
              <TextBlock Name="ToggleRecommendedNodesText" Text="{Binding ToggleRecommendationsText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <!-- Content links (§10.3.3–10.3.4): one quiet menu button holds 建议关联 (manual only, at least three summaries) and
             隐藏关联 / 显示关联 (once the workspace has a link), so the toolbar stays one row at 1100 px. -->
        <Button Name="LinksMenuButton" Classes="quiet" IsVisible="{Binding ShowsLinksMenu}"
                ToolTip.Tip="{x:Static t:UiText.LinksMenuName}" AutomationProperties.Name="{x:Static t:UiText.LinksMenuName}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="14" Height="14" Data="{StaticResource IconLink}" />
            <TextBlock Name="LinksMenuText" Text="{x:Static t:UiText.LinksMenu}" VerticalAlignment="Center" />
            <PathIcon Width="11" Height="11" Margin="-2,1,0,0" Data="{StaticResource IconChevronDown}" Foreground="{DynamicResource MutedText}" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Name="SuggestLinksMenuItem" Header="{x:Static t:UiText.SuggestLinks}" Command="{Binding Suggestions.SuggestCommand, FallbackValue={x:Null}}"
                        IsVisible="{Binding Suggestions, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="{Binding Suggestions.SuggestHelp, FallbackValue=''}" ToolTip.ShowOnDisabled="True"
                        AutomationProperties.HelpText="{Binding Suggestions.SuggestHelp, FallbackValue=''}">
                <MenuItem.Icon>
                  <PathIcon Width="13" Height="13" Data="{StaticResource IconSparkle}" />
                </MenuItem.Icon>
              </MenuItem>
              <!-- Why 建议关联 is unavailable, in words beside it (a disabled entry says nothing by itself). -->
              <MenuItem Name="SuggestLinksUnavailable" Header="{x:Static t:UiText.SuggestLinksNeedsSummaries}" IsEnabled="False" FontSize="12"
                        IsVisible="{Binding !Suggestions.CanSuggest, FallbackValue=False}" />
              <Separator IsVisible="{Binding ShowsLinkTools}" />
              <MenuItem Name="ToggleLinksMenuItem" Header="{Binding ToggleLinksLabel}" Command="{Binding ToggleLinksCommand}" IsVisible="{Binding ShowsLinkTools}"
                        ToolTip.Tip="{x:Static t:UiText.HideLinksTip}" AutomationProperties.HelpText="{x:Static t:UiText.HideLinksTip}">
                <MenuItem.Icon>
                  <PathIcon Width="14" Height="14" Data="{StaticResource IconEye}" />
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </WrapPanel>
    </DockPanel>
    <!-- 换一批推荐 running, or the background preparing while none is drawn; then a quiet line when it did not work. -->
    <StackPanel DockPanel.Dock="Top" Name="RecommendedNodesBusyLine" Orientation="Horizontal" Spacing="8" Margin="2,0,0,8"
                IsVisible="{Binding ShowsRecommendationBusy}">
      <views:ActivitySpinner Classes="suggest-spinner" VerticalAlignment="Center" />
      <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding RecommendationBusyText}" />
    </StackPanel>
    <WrapPanel DockPanel.Dock="Top" Name="RecommendedNodesNoteLine" Margin="2,0,0,8" ItemSpacing="4" IsVisible="{Binding HasRecommendationNote}">
      <TextBlock Name="RecommendedNodesNote" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,4,0" Text="{Binding RecommendationNote}" />
      <Button Name="RetryRecommendedNodesButton" Classes="quiet small" Content="{x:Static t:UiText.Retry}" Command="{Binding RefreshRecommendationsCommand}"
              IsVisible="{Binding RecommendationNoteCanRetry}" AutomationProperties.Name="{x:Static t:UiText.RetryRecommendedNodesName}" />
      <Button Name="RecommendedNodesSettingsButton" Classes="quiet small" Content="{x:Static t:UiText.OpenSettingsLink}"
              Command="{Binding OpenSettingsCommand}" IsVisible="{Binding RecommendationNoteNeedsSettings}" />
    </WrapPanel>
    <!-- 建议关联 running, then a quiet line when it stored nothing: why, with 重试 or a way to the settings (never a dialog). -->
    <StackPanel DockPanel.Dock="Top" Name="LinkSuggestionsBusyLine" Orientation="Horizontal" Spacing="8" Margin="2,0,0,8"
                IsVisible="{Binding Suggestions.IsRunning, FallbackValue=False}">
      <views:ActivitySpinner Classes="suggest-spinner" VerticalAlignment="Center" />
      <TextBlock Classes="caption" VerticalAlignment="Center" Text="{x:Static t:UiText.SuggestingLinks}" />
    </StackPanel>
    <WrapPanel DockPanel.Dock="Top" Name="LinkSuggestionsNoteLine" Margin="2,0,0,8" ItemSpacing="4" IsVisible="{Binding Suggestions.HasNote, FallbackValue=False}">
      <TextBlock Name="LinkSuggestionsNote" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,4,0" Text="{Binding Suggestions.Note, FallbackValue=''}" />
      <Button Name="RetryLinkSuggestionsButton" Classes="quiet small" Content="{x:Static t:UiText.Retry}" Command="{Binding Suggestions.SuggestCommand, FallbackValue={x:Null}}"
              IsVisible="{Binding Suggestions.NoteCanRetry, FallbackValue=False}" AutomationProperties.Name="{x:Static t:UiText.RetryLinkSuggestionsName}" />
      <Button Name="LinkSuggestionsSettingsButton" Classes="quiet small" Content="{x:Static t:UiText.OpenSettingsLink}"
              Command="{Binding Suggestions.OpenSettingsCommand, FallbackValue={x:Null}}" IsVisible="{Binding Suggestions.NoteNeedsSettings, FallbackValue=False}" />
    </WrapPanel>
    <TextBlock Name="EmptyText" DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Text="{x:Static t:UiText.SummaryNetworkEmpty}" IsVisible="{Binding IsEmpty}" />

    <!-- Details of the selected node: never the body, never counted as reading. Only as tall as what they say; their left
         edge is dragged to resize them, and they fold away (both remembered; the owner, 2026-11-23). -->
    <Grid Name="DetailsArea" DockPanel.Dock="Right" ColumnDefinitions="Auto,*" Width="{Binding Details.Width}" Margin="3,0,0,0" IsVisible="{Binding ShowsDetails}">
    <views:EdgeGrip Name="DetailsGrip" Width="7" Margin="0,0,2,0" AutomationProperties.Name="{x:Static t:UiText.SummaryNetworkDetailsWidth}"
                    ToolTip.Tip="{x:Static t:UiText.SummaryNetworkDetailsWidthTip}" />
    <Border Grid.Column="1" Name="DetailsCard" Padding="14,12" VerticalAlignment="Top" Background="{DynamicResource PanelBackground}" CornerRadius="{StaticResource RadiusCard}">
      <Panel>
        <Button Name="CollapseDetailsButton" Classes="quiet small icon" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-7,0" ZIndex="1"
                Command="{Binding CollapseDetailsCommand}" ToolTip.Tip="{x:Static t:UiText.CollapseSummaryNetworkDetails}" AutomationProperties.Name="{x:Static t:UiText.CollapseSummaryNetworkDetails}">
          <PathIcon Width="14" Height="14" Data="{StaticResource IconSidebar}" RenderTransform="scaleX(-1)" />
        </Button>
        <ScrollViewer Classes="autohide" Name="OverviewScroller" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !HasSelection}">
          <StackPanel Spacing="8" Margin="0,0,6,0">
            <TextBlock FontWeight="SemiBold" FontSize="16" Margin="0,0,24,0" Text="{Binding Title}" />
            <TextBlock Name="SelectHint" Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static t:UiText.SummaryNetworkSelectHint}" />
            <!-- Pending link suggestions (§10.3.4) while nothing is selected: 接受, 忽略, the note, 全部忽略. -->
            <StackPanel Name="SuggestionsSection" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding ShowsSuggestionsInDetails}">
              <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,6" />
              <TextBlock FontWeight="SemiBold" Text="{x:Static t:UiText.LinkSuggestionsHeading}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static t:UiText.LinkSuggestionsHint}" />
              <v:LinkSuggestionsView Name="DetailSuggestions" DataContext="{Binding Suggestions}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <!-- "关联到…" from the keyboard: the searchable list takes the details' place until picked or closed. -->
        <v:SummaryLinkPickerView Name="LinkPicker" DataContext="{Binding Links}" IsVisible="{Binding $parent[v:SummaryNetworkHomeView].((vm:SummaryNetworkHomeViewModel)DataContext).ShowsLinkPicker, FallbackValue=False}" />
        <ScrollViewer Classes="autohide" Name="DetailScroller" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ShowsDetail}">
        <StackPanel Name="DetailPanel" Spacing="12" Margin="0,0,6,0">
          <TextBlock Name="DetailTitle" FontSize="16" Margin="0,0,24,0" TextWrapping="Wrap" Text="{Binding Selected.DisplayName, FallbackValue=''}" />
          <!-- The conversation's first question: four lines at most, whole on 展开 (shown only when it is longer). -->
          <StackPanel Name="DetailQuestionBlock" Spacing="3" IsVisible="{Binding Selected.HasQuestion, FallbackValue=False}">
            <TextBlock Classes="muted" FontSize="12" Text="{x:Static t:UiText.DetailQuestion}" />
            <!-- Expanded, the question scrolls in its own box (capped in code-behind) so the buttons below stay in view. -->
            <ScrollViewer Name="QuestionScroller" Classes="autohide" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <TextBlock Name="DetailQuestion" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" Text="{Binding Selected.Question, FallbackValue=''}" />
            </ScrollViewer>
            <Button Name="ToggleQuestionButton" Classes="quiet small" HorizontalAlignment="Left" IsVisible="False" Content="{x:Static t:UiText.ShowWholeQuestion}" />
          </StackPanel>
          <!-- The same tags as the list and the summary page; words, not only colour (MW-C07). -->
          <WrapPanel Name="DetailMarkers" Orientation="Horizontal" AutomationProperties.Name="{Binding Selected.Markers, FallbackValue=''}">
            <Border Name="UnreadBadge" Classes="badge accent" Margin="0,0,6,4" IsVisible="{Binding Selected.ShowsUnread, FallbackValue=False}">
              <TextBlock Text="{x:Static t:UiText.MarkerUnread}" />
            </Border>
            <Border Name="ReadBadge" Classes="badge" Margin="0,0,6,4" IsVisible="{Binding Selected.ShowsRead, FallbackValue=False}">
              <TextBlock Text="{x:Static t:UiText.MarkerRead}" />
            </Border>
            <Border Classes="badge warning" Margin="0,0,6,4" IsVisible="{Binding Selected.HasCandidate, FallbackValue=False}">
              <TextBlock Text="{x:Static t:UiText.MarkerCandidate}" />
            </Border>
            <Border Name="LaterBadge" Classes="badge" Margin="0,0,6,4" IsVisible="{Binding Selected.HasLaterContent, FallbackValue=False}">
              <TextBlock Text="{x:Static t:UiText.MarkerLater}" />
            </Border>
            <Border Classes="badge" Margin="0,0,6,4" IsVisible="{Binding Selected.SourceArchived, FallbackValue=False}">
              <TextBlock Text="{x:Static t:UiText.SourceArchived}" />
            </Border>
          </WrapPanel>
          <StackPanel Spacing="3">
            <TextBlock Classes="muted" FontSize="12" Text="{x:Static t:UiText.SourcePathHeading}" />
            <!-- Root first; unsummarized conversations are muted and say so, never passing for summaries (§11). -->
            <ItemsControl Name="SourcePath" ItemsSource="{Binding Selected.Steps, FallbackValue={x:Null}}"
                          AutomationProperties.Name="{Binding Selected.Path, FallbackValue=''}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PathStep">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Classes="muted" Text="→" Margin="0,0,4,0" IsVisible="{Binding !IsFirst}" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="220" Margin="0,0,4,2"
                               Classes.muted="{Binding !Summarized}" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Selected.Source, FallbackValue=''}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Selected.Created, FallbackValue=''}" />
          </StackPanel>
          <StackPanel Spacing="8">
            <!-- A dot without a summary has none to open; it only leads back to its conversation, as the primary. -->
            <Button Name="OpenSelectedButton" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    IsVisible="{Binding Selected.HasSummary, FallbackValue=True}"
                    Command="{Binding OpenSelectedCommand}"
                    AutomationProperties.Name="{x:Static t:UiText.OpenSummary}">
              <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="{x:Static t:UiText.OpenSummary}" />
            </Button>
            <Button Name="ReturnSelectedButton" Classes.primary="{Binding !Selected.HasSummary, FallbackValue=False}" Classes.secondary="{Binding Selected.HasSummary, FallbackValue=True}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding ReturnToConversationCommand}"
                    AutomationProperties.Name="{x:Static t:UiText.ReturnToConversation}">
              <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="{x:Static t:UiText.ReturnToConversationButton}" />
            </Button>
          </StackPanel>
          <!-- Content links (§10.3.3): each with jump, 改说明 and 删除关联; then 关联到…. Quiet when there are none. -->
          <StackPanel Name="LinksSection" Spacing="4" IsVisible="{Binding ShowsLinksSection}">
            <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,6" />
            <TextBlock Classes="muted" FontSize="12" Text="{x:Static t:UiText.LinksHeading}" IsVisible="{Binding Links.HasItems, FallbackValue=False}" />
            <v:SummaryLinksView Name="DetailLinks" DataContext="{Binding Links}" />
            <Button Name="LinkToButton" Classes="quiet" HorizontalAlignment="Left" Command="{Binding BeginLinkCommand}"
                    views:FocusRequest.When="{Binding Links.ReturnsFocus, FallbackValue=False}"
                    ToolTip.Tip="{x:Static t:UiText.LinkToTip}" AutomationProperties.HelpText="{x:Static t:UiText.LinkToTip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Data="{StaticResource IconLink}" />
                <TextBlock Text="{x:Static t:UiText.LinkTo}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- A recommended node (§10.3.2): question, reason, basis; 开始探索 fills 新探索 without sending, 忽略 removes it. -->
        <ScrollViewer Classes="autohide" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding SelectedRecommendation, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Name="RecommendationDetailPanel" Spacing="12" Margin="0,0,6,0">
          <WrapPanel Orientation="Horizontal" Margin="0,0,24,0">
            <Border Classes="badge recommended" Margin="0,0,6,0">
              <TextBlock Text="{x:Static t:UiText.RecommendedTag}" />
            </Border>
            <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{x:Static t:UiText.RecommendedNodeHeading}" />
          </WrapPanel>
          <TextBlock Name="RecommendationQuestion" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" Text="{Binding SelectedRecommendation.Question, FallbackValue=''}"
                     AutomationProperties.Name="{Binding SelectedRecommendation.AutomationName, FallbackValue=''}" />
          <StackPanel Spacing="3" IsVisible="{Binding SelectedRecommendation.HasReason, FallbackValue=False}">
            <TextBlock Classes="muted" FontSize="12" Text="{x:Static t:UiText.RecommendedReasonHeading}" />
            <TextBlock Name="RecommendationReason" TextWrapping="Wrap" Text="{Binding SelectedRecommendation.Reason, FallbackValue=''}" />
          </StackPanel>
          <StackPanel Spacing="3">
            <TextBlock Classes="muted" FontSize="12" Text="{x:Static t:UiText.RecommendedBasisHeading}" />
            <TextBlock Name="RecommendationBasis" TextWrapping="Wrap" Text="{Binding SelectedRecommendation.BasisName, FallbackValue=''}" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static t:UiText.RecommendedNodeNote}" />
          <StackPanel Spacing="8">
            <Button Name="StartExplorationButton" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding StartExplorationCommand}"
                    AutomationProperties.Name="{x:Static t:UiText.StartExploration}">
              <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="{x:Static t:UiText.StartExploration}" />
            </Button>
            <Button Name="IgnoreRecommendedNodeButton" Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding IgnoreRecommendationCommand}"
                    AutomationProperties.Name="{Binding SelectedRecommendation.IgnoreName, FallbackValue=''}">
              <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="{x:Static t:UiText.IgnoreRecommendedNode}" />
            </Button>
          </StackPanel>
        </StackPanel>
        </ScrollViewer>
      </Panel>
    </Border>
    </Grid>

    <!-- The legend is an icon (the owner, 2026-11-23: it is read the first few times): pointing at it shows the card, a click or
         the keyboard keeps it open. Beside it, the wheel option. -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" IsVisible="{Binding ShowsCanvas}">
      <Button Name="LegendButton" DockPanel.Dock="Left" Classes="quiet small" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="{x:Static t:UiText.SummaryNetworkLegend}"
              AutomationProperties.HelpText="{x:Static t:UiText.SummaryNetworkLegendHelp}">
        <PathIcon Width="15" Height="15" Data="{StaticResource IconInfo}" />
      </Button>
      <CheckBox IsChecked="{Binding WheelZooms}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" MinHeight="0" AutomationProperties.Name="{x:Static t:UiText.WheelZooms}">
        <TextBlock Text="{x:Static t:UiText.WheelZooms}" TextWrapping="Wrap" />
      </CheckBox>
    </DockPanel>

    <Panel>
      <!-- Folded away: the way back to the details, over the canvas's corner. -->
      <Button Name="ExpandDetailsButton" Classes="quiet small icon" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" ZIndex="1" IsVisible="{Binding ShowsDetailsButton}"
              Command="{Binding ExpandDetailsCommand}" ToolTip.Tip="{x:Static t:UiText.ExpandSummaryNetworkDetails}" AutomationProperties.Name="{x:Static t:UiText.ExpandSummaryNetworkDetails}">
        <PathIcon Width="14" Height="14" Data="{StaticResource IconSidebar}" RenderTransform="scaleX(-1)" />
      </Button>
      <!-- The legend's card, over the canvas right above its icon, so nothing moves when it opens. -->
      <Border Name="LegendCard" Classes="legend-card" HorizontalAlignment="Left" VerticalAlignment="Bottom" ZIndex="2" IsVisible="False"
              AutomationProperties.Name="{x:Static t:UiText.SummaryNetworkLegend}" views:Motion.Appear="Fade">
        <StackPanel Name="Legend" Spacing="7">
          <StackPanel.Styles>
            <Style Selector="TextBlock">
              <Setter Property="FontSize" Value="12" />
              <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- Each mark is drawn in a column of one width, so the words beside the marks line up. -->
            <Style Selector="Panel.mark">
              <Setter Property="Width" Value="24" />
              <Setter Property="Margin" Value="0,0,8,0" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="Panel.mark :is(Shape)">
              <Setter Property="HorizontalAlignment" Value="Center" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </StackPanel.Styles>
          <!-- The marks, drawn as on the canvas: dot size, the summary ring, the arrowed dotted time thread, a
               branch. Each mark keeps its words beside it. -->
          <StackPanel Name="LegendDotSize" Orientation="Horizontal">
            <Panel Classes="mark">
              <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource SummaryNetworkNode}" />
                <Ellipse Width="12" Height="12" Fill="{DynamicResource SummaryNetworkNode}" />
              </StackPanel>
            </Panel>
            <TextBlock Text="{x:Static t:UiText.LegendDotSize}" />
          </StackPanel>
          <StackPanel Name="LegendSummaryRing" Orientation="Horizontal">
            <Panel Classes="mark">
              <Ellipse Width="15" Height="15" Stroke="{DynamicResource SummaryNetworkNode}" StrokeThickness="1.5" />
              <Ellipse Width="7" Height="7" Fill="{DynamicResource SummaryNetworkNode}" />
            </Panel>
            <TextBlock Text="{x:Static t:UiText.LegendSummaryRing}" />
          </StackPanel>
          <StackPanel Name="LegendTime" Orientation="Horizontal">
            <Panel Classes="mark">
              <Canvas Width="24" Height="8" VerticalAlignment="Center">
                <Line StartPoint="0,4" EndPoint="22,4" Stroke="{DynamicResource SummaryNetworkEdge}" StrokeThickness="1.4" StrokeDashArray="0,2.4" StrokeLineCap="Round" />
                <Path Data="M18,1 L22.5,4 L18,7" Stroke="{DynamicResource SummaryNetworkEdge}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" />
              </Canvas>
            </Panel>
            <TextBlock Text="{x:Static t:UiText.LegendTime}" />
          </StackPanel>
          <StackPanel Name="LegendBranch" Orientation="Horizontal">
            <Panel Classes="mark">
              <Line StartPoint="0,0" EndPoint="20,0" Stroke="{DynamicResource SummaryNetworkEdge}" StrokeThickness="1.4" />
            </Panel>
            <TextBlock Text="{x:Static t:UiText.LegendBranch}" />
          </StackPanel>
          <!-- An unread summary wears the small badge beside its dot, as drawn. -->
          <StackPanel Name="LegendUnread" Orientation="Horizontal">
            <Panel Classes="mark">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource SummaryNetworkUnreadDot}" />
            </Panel>
            <TextBlock Text="{x:Static t:UiText.LegendUnread}" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Name="LegendCandidate" Orientation="Horizontal">
            <Panel Classes="mark">
              <TextBlock Text="↻" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            </Panel>
            <TextBlock Text="{x:Static t:UiText.LegendCandidate}" />
          </StackPanel>
          <!-- Content links (§10.3.3): the quiet neutral dash as drawn at rest (design §8). -->
          <StackPanel Name="LinkLegend" Orientation="Horizontal" IsVisible="{Binding ShowsLinkLegend}">
            <Panel Classes="mark">
              <Line StartPoint="0,0" EndPoint="22,0" Stroke="{DynamicResource SummaryNetworkEdge}" StrokeThickness="1.2" StrokeDashArray="6,3.5" />
            </Panel>
            <TextBlock Text="{x:Static t:UiText.LegendLink}" />
          </StackPanel>
          <!-- Link suggestions (§10.3.4): the same light dash-dot line as drawn, with words. -->
          <StackPanel Name="SuggestionLegend" Orientation="Horizontal" IsVisible="{Binding ShowsSuggestionLegend}">
            <Panel Classes="mark">
              <Line StartPoint="0,0" EndPoint="22,0" Stroke="{DynamicResource SummaryNetworkLinkSuggestion}" StrokeThickness="1.5" StrokeDashArray="3.6,1.6,0.8,1.6" />
            </Panel>
            <TextBlock Text="{x:Static t:UiText.LegendLinkSuggestion}" />
          </StackPanel>
          <!-- Recommended nodes (§10.3.2): the same dashed ring and dotted line as drawn, with words. -->
          <StackPanel Name="RecommendationLegend" Spacing="7" IsVisible="{Binding ShowsRecommendationLegend}">
            <StackPanel Orientation="Horizontal">
              <Panel Classes="mark">
                <Ellipse Width="11" Height="11" Fill="{DynamicResource SummaryNetworkRecommendationFill}" Stroke="{DynamicResource SummaryNetworkRecommendation}" StrokeThickness="1.4"
                         StrokeDashArray="2,1.5" />
              </Panel>
              <TextBlock Text="{x:Static t:UiText.LegendRecommended}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Panel Classes="mark">
                <Line StartPoint="0,0" EndPoint="20,0" Stroke="{DynamicResource SummaryNetworkRecommendation}" StrokeThickness="1.6" StrokeDashArray="0,2.4" StrokeLineCap="Round" />
              </Panel>
              <TextBlock Text="{x:Static t:UiText.LegendRecommendedLink}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- Frameless in dark, as in the sample; a faint edge in light, where the canvas is close to the page colour. -->
      <Border Name="CanvasFrame" BorderBrush="{DynamicResource SummaryNetworkFrame}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True" IsVisible="{Binding !IsListView}">
        <v:SummaryNetworkCanvas Name="Canvas" />
      </Border>
      <!-- "关联到…" waiting for a click on another summary: what to do (or why the last click did not link), the keyboard way, 取消.
           Laid over the top of the canvas, so the network does not move under the pointer when it appears or goes. -->
      <Border Name="LinkPickLine" Classes="notice info link-pick-line" views:Narrow.Below="420" Margin="10,10,10,0" VerticalAlignment="Top" IsVisible="{Binding IsPicking}">
        <DockPanel>
          <WrapPanel Classes="link-pick-actions" ItemSpacing="4" VerticalAlignment="Center">
            <Button Name="PickFromListButton" Classes="quiet" Content="{x:Static t:UiText.LinkPickFromList}" Command="{Binding PickFromListCommand}"
                    AutomationProperties.Name="{x:Static t:UiText.LinkPickFromListName}" views:FocusRequest.When="{Binding IsPicking}" />
            <Button Name="CancelPickButton" Classes="quiet" Content="{x:Static t:UiText.Cancel}" Command="{Binding CancelPickCommand}"
                    AutomationProperties.Name="{x:Static t:UiText.LinkPickCancelName}" />
          </WrapPanel>
          <PathIcon DockPanel.Dock="Left" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Data="{StaticResource IconLink}"
                    Foreground="{DynamicResource SummaryNetworkLink}" />
          <TextBlock Name="LinkPickHint" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding PickHint}" Classes.warning="{Binding HasPickRefusal}" />
        </DockPanel>
      </Border>
      <ScrollViewer Classes="autohide" IsVisible="{Binding IsListView}">
        <StackPanel Spacing="8">
          <ItemsControl Name="SummaryList" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SummaryListItem">
                <WrapPanel ItemSpacing="6" LineSpacing="2" Margin="0,2">
                  <!-- Unread: bold, primary colour; read: regular, secondary colour (S7 已读／未读约定); a dot without a summary has neither. -->
                  <Button Classes="list-name wraps" Classes.read="{Binding ShowsRead}" Content="{Binding DisplayName}" FontWeight="{Binding Unread, Converter={x:Static d:Converters.BoldWhen}}"
                          AutomationProperties.HelpText="{Binding Links}"
                          Command="{Binding $parent[v:SummaryNetworkHomeView].((vm:SummaryNetworkHomeViewModel)DataContext).OpenCommand}" CommandParameter="{Binding Node}" />
                  <Border Classes="badge accent" IsVisible="{Binding ShowsUnread}">
                    <TextBlock Text="{x:Static t:UiText.MarkerUnread}" />
                  </Border>
                  <Border Classes="badge" IsVisible="{Binding ShowsRead}">
                    <TextBlock Text="{x:Static t:UiText.MarkerRead}" />
                  </Border>
                  <Border Classes="badge warning" IsVisible="{Binding HasCandidate}">
                    <TextBlock Text="{x:Static t:UiText.MarkerCandidate}" />
                  </Border>
                  <Border Classes="badge" IsVisible="{Binding HasOther}">
                    <TextBlock Text="{Binding Other}" />
                  </Border>
                  <!-- Its content links in words, for the keyboard and screen readers (D-018). -->
                  <TextBlock Name="SummaryRowLinks" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" Text="{Binding Links}"
                             TextWrapping="Wrap" IsVisible="{Binding HasLinks}" />
                </WrapPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- The recommended nodes for the keyboard and screen readers (D-018): a row each selects it; the details offer 开始探索 and 忽略. -->
          <StackPanel Name="RecommendedNodesList" Spacing="4" Margin="0,10,0,0" IsVisible="{Binding RecommendedNodes.Count, Converter={x:Static d:Converters.IsPositive}}">
            <TextBlock Classes="muted" FontSize="12" Margin="5,0,0,0" Text="{x:Static t:UiText.RecommendedNodesListHeading}" />
            <ItemsControl ItemsSource="{Binding RecommendedNodes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecommendedNodeView">
                  <WrapPanel ItemSpacing="6" LineSpacing="2" Margin="0,2">
                    <!-- As the summaries' rows: the name first, then its tag in words. -->
                    <Button Name="RecommendedNodeRow" Classes="list-name wraps read" Content="{Binding Question}" AutomationProperties.Name="{Binding AutomationName}"
                            ToolTip.Tip="{Binding BasisText}"
                            Command="{Binding $parent[v:SummaryNetworkHomeView].((vm:SummaryNetworkHomeViewModel)DataContext).SelectRecommendationCommand}" CommandParameter="{Binding}" />
                    <Border Classes="badge recommended">
                      <TextBlock Text="{x:Static t:UiText.RecommendedTag}" />
                    </Border>
                    <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding BasisText}" TextWrapping="Wrap" />
                  </WrapPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- The pending link suggestions for the keyboard and screen readers (D-018), the same rows as in the details. -->
          <StackPanel Name="LinkSuggestionsList" Spacing="6" Margin="5,10,0,0" MaxWidth="560" HorizontalAlignment="Left" IsVisible="{Binding ShowsSuggestionsInList}">
            <TextBlock Classes="muted" FontSize="12" Text="{x:Static t:UiText.LinkSuggestionsHeading}" />
            <v:LinkSuggestionsView Name="ListSuggestions" DataContext="{Binding Suggestions}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
