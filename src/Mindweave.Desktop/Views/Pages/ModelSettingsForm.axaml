<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Pages"
             xmlns:d="using:Mindweave.Desktop"
             xmlns:t="using:Mindweave.Desktop.Text"
             x:Class="Mindweave.Desktop.Views.Pages.ModelSettingsForm"
             x:DataType="vm:ModelSettingsViewModel">
  <!-- The model connection's fields, shared by 设置 › 模型连接 and first-run onboarding (2026-11-17). The host adds its own
       actions and status line. Onboarding shows only what a first connection needs; the name and the context capacity
       keep their defaults until changed in 设置. -->
  <Border Classes="card settings">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
        <TextBlock Classes="field-label" Text="{x:Static t:UiText.ProviderLabel}" />
        <ComboBox Grid.Column="1" Name="ProviderPicker" Classes="settings" MinWidth="240" HorizontalAlignment="Left"
                  ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                  PlaceholderText="{x:Static t:UiText.ProviderPlaceholder}" AutomationProperties.Name="{x:Static t:UiText.ProviderLabel}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProviderPreset">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="1" Classes="field-label" Text="{x:Static t:UiText.BaseUrlLabel}" />
        <TextBox Grid.Row="1" Grid.Column="1" Name="BaseUrl" Text="{Binding BaseUrl}" PlaceholderText="{x:Static t:UiText.BaseUrlPlaceholder}"
                 AutomationProperties.Name="{x:Static t:UiText.BaseUrlLabel}" />

        <TextBlock Grid.Row="2" Classes="field-label" Text="{x:Static t:UiText.ApiKeyLabel}" />
        <TextBox Grid.Row="2" Grid.Column="1" Name="ApiKey" Text="{Binding ApiKey}" PasswordChar="•" RevealPassword="False"
                 PlaceholderText="{Binding KeyPlaceholder}" AutomationProperties.Name="{x:Static t:UiText.ApiKeyLabel}" />

        <TextBlock Grid.Row="3" Classes="field-label" Text="{x:Static t:UiText.ModelLabel}" />
        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Name="ModelBox" Text="{Binding Model}" PlaceholderText="{x:Static t:UiText.ModelPlaceholder}"
                   AutomationProperties.Name="{x:Static t:UiText.ModelLabel}">
            <TextBox.InnerRightContent>
              <Button Name="ModelListToggle" Classes="field-toggle" Click="OnModelListToggle" Focusable="False"
                      ToolTip.Tip="{x:Static t:UiText.ShowModels}" AutomationProperties.Name="{x:Static t:UiText.ShowModels}"
                      IsVisible="{Binding AvailableModels.Count, Converter={x:Static d:Converters.IsPositive}}">
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>
          <Popup Name="ModelPopup" PlacementTarget="{Binding #ModelBox}" Placement="BottomEdgeAlignedLeft"
                 IsOpen="{Binding IsModelListOpen, Mode=TwoWay}" IsLightDismissEnabled="True" OverlayDismissEventPassThrough="True"
                 MinWidth="{Binding #ModelBox.Bounds.Width}">
            <Border Classes="suggestions">
              <ListBox Name="ModelList" ItemsSource="{Binding ModelSuggestions}" MaxHeight="248" SelectionMode="Single" Focusable="False" />
            </Border>
          </Popup>
          <Button Grid.Column="1" Name="FetchModels" Classes="secondary" Command="{Binding DiscoverCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconRegenerate}" />
              <TextBlock Text="{x:Static t:UiText.FetchModels}" />
            </StackPanel>
          </Button>
        </Grid>
      </Grid>

      <Grid Name="DetailRows" ColumnDefinitions="96,*" RowDefinitions="Auto,Auto" RowSpacing="12">
        <TextBlock Classes="field-label" Text="{x:Static t:UiText.ConnectionNameLabel}" />
        <TextBox Grid.Column="1" Name="ConnectionName" Text="{Binding Name}" PlaceholderText="{x:Static t:UiText.ConnectionNamePlaceholder}"
                 AutomationProperties.Name="{x:Static t:UiText.ConnectionNameLabel}" />

        <TextBlock Grid.Row="1" Classes="field-label" VerticalAlignment="Top" Margin="0,6,0,0" Text="{x:Static t:UiText.ContextWindowLabel}" />
        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Name="ContextWindow" Text="{Binding ContextWindow}" PlaceholderText="{x:Static t:UiText.ContextWindowPlaceholder}" Width="180"
                     AutomationProperties.Name="{x:Static t:UiText.ContextWindowLabel}" />
            <TextBlock Classes="caption" VerticalAlignment="Center" Text="{x:Static t:UiText.TokensUnit}" />
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static t:UiText.ContextWindowHint}" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
