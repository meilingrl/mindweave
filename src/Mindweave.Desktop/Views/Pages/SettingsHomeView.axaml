<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Pages"
             xmlns:d="using:Mindweave.Desktop"
             x:Class="Mindweave.Desktop.Views.Pages.SettingsHomeView"
             x:DataType="vm:SettingsHomeViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="10" HorizontalAlignment="Left" MaxWidth="640">
    <TextBlock FontWeight="SemiBold" FontSize="16" Text="{x:Static d:UiText.AppearanceSection}" />
    <StackPanel Name="AppearancePicker" Orientation="Horizontal" Spacing="16">
      <RadioButton Name="AppearanceFollowSystem" GroupName="Appearance" Content="{x:Static d:UiText.AppearanceFollowSystem}" IsChecked="{Binding IsFollowSystem}" />
      <RadioButton Name="AppearanceLight" GroupName="Appearance" Content="{x:Static d:UiText.AppearanceLight}" IsChecked="{Binding IsLight}" />
      <RadioButton Name="AppearanceDark" GroupName="Appearance" Content="{x:Static d:UiText.AppearanceDark}" IsChecked="{Binding IsDark}" />
    </StackPanel>
    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static d:UiText.AppearanceHint}" />
    <TextBlock Name="AppearanceStatus" Classes="error" FontSize="12" TextWrapping="Wrap" Text="{Binding AppearanceStatus}"
               IsVisible="{Binding AppearanceStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <Separator Margin="0,8" />
    <TextBlock FontWeight="SemiBold" FontSize="16" Text="{x:Static d:UiText.ModelSection}" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static d:UiText.PrivacyHint}" />
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8" DataContext="{Binding Model}">
      <TextBlock VerticalAlignment="Center" Text="{x:Static d:UiText.ConnectionNameLabel}" />
      <TextBox Grid.Column="1" Name="ConnectionName" Text="{Binding Name}" />
      <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{x:Static d:UiText.BaseUrlLabel}" />
      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
        <TextBox Name="BaseUrl" Text="{Binding BaseUrl}" PlaceholderText="https://api.example.com/v1" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static d:UiText.BaseUrlHint}" />
      </StackPanel>
      <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{x:Static d:UiText.ApiKeyLabel}" />
      <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
        <TextBox Name="ApiKey" Text="{Binding ApiKey}" PasswordChar="•" RevealPassword="False" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding KeyHint}" />
      </StackPanel>
      <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{x:Static d:UiText.ModelLabel}" />
      <DockPanel Grid.Row="3" Grid.Column="1">
        <Button DockPanel.Dock="Right" Content="{x:Static d:UiText.FetchModels}" Command="{Binding DiscoverCommand}" Margin="8,0,0,0" />
        <AutoCompleteBox Name="ModelBox" Text="{Binding Model}" ItemsSource="{Binding AvailableModels}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" />
      </DockPanel>
      <TextBlock Grid.Row="4" VerticalAlignment="Top" Margin="0,6,0,0" Text="{x:Static d:UiText.ContextWindowLabel}" />
      <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
        <TextBox Name="ContextWindow" Text="{Binding ContextWindow}" PlaceholderText="{x:Static d:UiText.ContextWindowPlaceholder}" Width="200" HorizontalAlignment="Left" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static d:UiText.ContextWindowHint}" />
      </StackPanel>
      <StackPanel Grid.Row="5" Grid.Column="1" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Name="SaveModel" Content="{x:Static d:UiText.Save}" Command="{Binding SaveCommand}" />
          <Button Name="TestModel" Content="{x:Static d:UiText.TestConnection}" Command="{Binding TestCommand}" />
        </StackPanel>
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static d:UiText.TestCostHint}" />
        <TextBlock Name="ModelStatus" Text="{Binding Status}" TextWrapping="Wrap" Classes.error="{Binding StatusIsError}"
                   IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Grid>
    <Separator Margin="0,12" />
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
      <TextBlock Classes="muted" Text="{x:Static d:UiText.AppVersionLabel}" />
      <TextBlock Grid.Column="1" Text="{Binding Environment.Version}" />
      <TextBlock Grid.Row="1" Classes="muted" Text="{x:Static d:UiText.ChannelLabel}" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Environment.Channel}" />
    </Grid>
    <Button Name="StorageDetailsButton" Content="{x:Static d:UiText.StorageDetailsLink}" Command="{Binding ShowStorageDetailsCommand}" />
  </StackPanel>
  </ScrollViewer>
</UserControl>
