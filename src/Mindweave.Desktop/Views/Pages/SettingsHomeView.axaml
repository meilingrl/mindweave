<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Pages"
             xmlns:d="using:Mindweave.Desktop"
             xmlns:t="using:Mindweave.Desktop.Text"
             xmlns:v="using:Mindweave.Desktop.Views"
             xmlns:p="using:Mindweave.Desktop.Views.Pages"
             x:Class="Mindweave.Desktop.Views.Pages.SettingsHomeView"
             x:DataType="vm:SettingsHomeViewModel">
  <ScrollViewer Name="Scroller" Classes="autohide" HorizontalScrollBarVisibility="Disabled">
  <!-- One left-aligned column of at most 640 px (a star column with a maximum), as on the summary page. -->
  <Grid Margin="0,4,16,24">
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" MaxWidth="640" />
  </Grid.ColumnDefinitions>
  <!-- The cards' label columns share one width (at least 96 px), so a longer label widens them all alike. -->
  <StackPanel Grid.IsSharedSizeScope="True">

    <!-- 外观 -->
    <TextBlock Classes="section-heading" Text="{x:Static t:UiText.AppearanceSection}" />
    <Border Classes="card settings">
      <Grid Classes="labelled" RowDefinitions="Auto,Auto,Auto,Auto">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="SettingsLabel" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Classes="field-label" Text="{x:Static t:UiText.ThemeLabel}" />
        <Border Grid.Column="1" Name="AppearancePicker" Classes="segmented">
          <StackPanel Orientation="Horizontal" Spacing="2" KeyboardNavigation.TabNavigation="Once">
            <RadioButton Name="AppearanceLight" Classes="segment" GroupName="Appearance" IsChecked="{Binding IsLight}"
                         AutomationProperties.Name="{x:Static t:UiText.AppearanceLight}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconSun}" />
                <TextBlock Text="{x:Static t:UiText.AppearanceLight}" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Name="AppearanceDark" Classes="segment" GroupName="Appearance" IsChecked="{Binding IsDark}"
                         AutomationProperties.Name="{x:Static t:UiText.AppearanceDark}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconMoon}" />
                <TextBlock Text="{x:Static t:UiText.AppearanceDark}" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Name="AppearanceFollowSystem" Classes="segment" GroupName="Appearance" IsChecked="{Binding IsFollowSystem}"
                         AutomationProperties.Name="{x:Static t:UiText.AppearanceFollowSystem}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconMonitor}" />
                <TextBlock Text="{x:Static t:UiText.AppearanceFollowSystem}" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>
        <TextBlock Grid.Row="1" Grid.Column="1" Name="AppearanceStatus" v:Motion.Appear="Fade" Classes="error" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="{Binding AppearanceStatus}" IsVisible="{Binding AppearanceStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <!-- The interface language (bilingual-ui.md §7): each language by its own name; choosing switches in place. -->
        <TextBlock Grid.Row="2" Classes="field-label" Margin="0,16,0,0" Text="{x:Static t:UiText.LanguageLabel}" IsVisible="{Binding CanChooseLanguage}" />
        <Border Grid.Row="2" Grid.Column="1" Name="LanguagePicker" Classes="segmented" Margin="0,16,0,0" IsVisible="{Binding CanChooseLanguage}">
          <StackPanel Orientation="Horizontal" Spacing="2" KeyboardNavigation.TabNavigation="Once">
            <RadioButton Name="LanguageEnglish" Classes="segment" GroupName="Language" IsChecked="{Binding IsEnglish}"
                         Content="{x:Static t:UiText.LanguageEnglish}" AutomationProperties.Name="{x:Static t:UiText.LanguageEnglish}" />
            <RadioButton Name="LanguageChinese" Classes="segment" GroupName="Language" IsChecked="{Binding IsChinese}"
                         Content="{x:Static t:UiText.LanguageChinese}" AutomationProperties.Name="{x:Static t:UiText.LanguageChinese}" />
          </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" Grid.Column="1" Name="LanguageStatus" v:Motion.Appear="Fade" Classes="error" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="{Binding LanguageStatus}" IsVisible="{Binding LanguageStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </Border>

    <!-- 提示 (2026-11-10): whether the open workspace's conversations pop up a hint too (on unless turned off), and the
         sound for a hint (off unless chosen); 2026-11-11: whether a workspace's names are prepared in the background (on);
         2026-11-12: recommended questions, recommended nodes and preparing them in the background (all on, §10.3), with
         what is sent and that preparing costs a little. -->
    <StackPanel IsVisible="{Binding CanChooseNewsSound}">
      <TextBlock Classes="section-heading" Margin="2,28,0,8" Text="{x:Static t:UiText.HintsSection}" />
      <Border Classes="card settings">
        <Grid Classes="labelled" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="SettingsLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Classes="field-label" Text="{x:Static t:UiText.NewsInWorkspaceLabel}" />
          <CheckBox Grid.Column="1" Name="NewsInWorkspaceToggle" IsChecked="{Binding ShowsInWorkspaceNews}" Content="{x:Static t:UiText.NewsInWorkspace}"
                    AutomationProperties.Name="{x:Static t:UiText.NewsInWorkspace}" AutomationProperties.HelpText="{x:Static t:UiText.NewsInWorkspaceHint}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static t:UiText.NewsInWorkspaceHint}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Name="InWorkspaceNewsStatus" v:Motion.Appear="Fade" Classes="error" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="{Binding InWorkspaceNewsStatus}" IsVisible="{Binding InWorkspaceNewsStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Grid.Row="3" Classes="field-label" Margin="0,16,0,0" Text="{x:Static t:UiText.NewsSoundLabel}" />
          <CheckBox Grid.Row="3" Grid.Column="1" Name="NewsSoundToggle" Margin="0,16,0,0" IsChecked="{Binding PlaysNewsSound}" Content="{x:Static t:UiText.NewsSound}"
                    AutomationProperties.Name="{x:Static t:UiText.NewsSound}" AutomationProperties.HelpText="{x:Static t:UiText.NewsSoundHint}" />
          <TextBlock Grid.Row="4" Grid.Column="1" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static t:UiText.NewsSoundHint}" />
          <TextBlock Grid.Row="5" Grid.Column="1" Name="NewsSoundStatus" v:Motion.Appear="Fade" Classes="error" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="{Binding NewsSoundStatus}" IsVisible="{Binding NewsSoundStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Grid.Row="6" Classes="field-label" Margin="0,16,0,0" Text="{x:Static t:UiText.PrepareNamesLabel}" />
          <CheckBox Grid.Row="6" Grid.Column="1" Name="PrepareNamesToggle" Margin="0,16,0,0" IsChecked="{Binding PreparesNames}" Content="{x:Static t:UiText.PrepareNames}"
                    AutomationProperties.Name="{x:Static t:UiText.PrepareNames}" AutomationProperties.HelpText="{x:Static t:UiText.PrepareNamesHint}" />
          <TextBlock Grid.Row="7" Grid.Column="1" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static t:UiText.PrepareNamesHint}" />
          <TextBlock Grid.Row="8" Grid.Column="1" Name="PrepareNamesStatus" v:Motion.Appear="Fade" Classes="error" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="{Binding PrepareNamesStatus}" IsVisible="{Binding PrepareNamesStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Grid.Row="9" Classes="field-label" Margin="0,22,0,0" VerticalAlignment="Top" Text="{x:Static t:UiText.RecommendationsLabel}" IsVisible="{Binding CanChooseRecommendations}" />
          <StackPanel Grid.Row="9" Grid.Column="1" Name="RecommendationChoices" Margin="0,16,0,0" Spacing="2" IsVisible="{Binding CanChooseRecommendations}">
            <CheckBox Name="RecommendQuestionsToggle" IsChecked="{Binding RecommendsQuestions}" Content="{x:Static t:UiText.RecommendQuestionsSetting}"
                      AutomationProperties.Name="{x:Static t:UiText.RecommendQuestionsSetting}" AutomationProperties.HelpText="{x:Static t:UiText.RecommendationsHint}" />
            <CheckBox Name="RecommendNodesToggle" IsChecked="{Binding RecommendsNodes}" Content="{x:Static t:UiText.RecommendNodesSetting}"
                      AutomationProperties.Name="{x:Static t:UiText.RecommendNodesSetting}" AutomationProperties.HelpText="{x:Static t:UiText.RecommendationsHint}" />
            <CheckBox Name="AutoPrepareRecommendationsToggle" IsChecked="{Binding AutoPreparesRecommendations}" Content="{x:Static t:UiText.AutoPrepareRecommendations}"
                      AutomationProperties.Name="{x:Static t:UiText.AutoPrepareRecommendations}" AutomationProperties.HelpText="{x:Static t:UiText.RecommendationsHint}" />
          </StackPanel>
          <TextBlock Grid.Row="10" Grid.Column="1" Name="RecommendationsHint" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static t:UiText.RecommendationsHint}"
                     IsVisible="{Binding CanChooseRecommendations}" />
          <TextBlock Grid.Row="11" Grid.Column="1" Name="RecommendationsStatus" v:Motion.Appear="Fade" Classes="error" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="{Binding RecommendationsStatus}" IsVisible="{Binding RecommendationsStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- 模型连接 -->
    <TextBlock Classes="section-heading" Margin="2,28,0,2" Text="{x:Static t:UiText.ModelSection}" />
    <TextBlock Classes="caption" Margin="2,0,0,10" TextWrapping="Wrap" Text="{x:Static t:UiText.PrivacyHint}" />
    <StackPanel DataContext="{Binding Model}" x:DataType="vm:ModelSettingsViewModel" Spacing="12">
      <p:ModelSettingsForm Name="ModelForm" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
        <Button Name="SaveModel" Classes="primary" Content="{x:Static t:UiText.Save}" Command="{Binding SaveCommand}" />
        <Button Name="TestModel" Classes="secondary" Content="{x:Static t:UiText.TestConnection}" Command="{Binding TestCommand}"
                ToolTip.Tip="{x:Static t:UiText.TestCostTip}" />
        <TextBlock Classes="caption" VerticalAlignment="Center" Margin="4,0,0,0" Text="{x:Static t:UiText.TestCostHint}" />
      </StackPanel>
      <TextBlock Name="ModelStatus" v:Motion.Appear="Fade" Margin="2,0,0,0" Text="{Binding Status}" TextWrapping="Wrap" FontSize="13"
                 Classes.muted="{Binding !StatusIsError}" Classes.error="{Binding StatusIsError}"
                 IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <!-- 工具 (requirements §10.4.4, agent platform phase 2): 使用工具 and a run's limits; greyed out with the reason while the
         model does not declare tool calls. -->
    <StackPanel Name="ToolsSection" IsVisible="{Binding HasTools}">
      <TextBlock Classes="section-heading" Margin="2,28,0,2" Text="{x:Static t:UiText.SettingsTools}" />
      <TextBlock Classes="caption" Margin="2,0,0,10" TextWrapping="Wrap" Text="{x:Static t:UiText.ToolsIntro}" />
      <Border Classes="card settings" DataContext="{Binding Tools}" x:DataType="vm:ToolSettingsPanel">
        <StackPanel Spacing="0">
          <TextBlock Name="ToolsUnavailable" Classes="caption" TextWrapping="Wrap" Margin="0,0,0,12" Text="{x:Static t:UiText.ToolsUnavailable}"
                     IsVisible="{Binding IsUnavailable}" />
          <Grid Classes="labelled" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" IsEnabled="{Binding IsAvailable}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="SettingsLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Classes="field-label" Text="{x:Static t:UiText.SettingsTools}" />
            <CheckBox Grid.Column="1" Name="UseToolsToggle" IsChecked="{Binding UsesTools}" Content="{x:Static t:UiText.UseTools}"
                      AutomationProperties.Name="{x:Static t:UiText.UseTools}" AutomationProperties.HelpText="{x:Static t:UiText.UseToolsHint}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static t:UiText.UseToolsHint}" />
            <TextBlock Grid.Row="2" Classes="field-label" Margin="0,18,0,0" VerticalAlignment="Top" Text="{x:Static t:UiText.RunLimitsTitle}" TextWrapping="Wrap" />
            <Grid Grid.Row="2" Grid.Column="1" Name="RunLimits" Margin="0,16,0,0" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                  IsEnabled="{Binding UsesTools}" HorizontalAlignment="Left">
              <TextBlock Classes="caption" VerticalAlignment="Center" Margin="0,0,12,6" Text="{x:Static t:UiText.LimitModelRequests}" />
              <NumericUpDown Grid.Column="1" Name="LimitModelRequests" Width="150" Margin="0,0,0,6" FormatString="0" Increment="1"
                             Minimum="{x:Static vm:ToolSettingsPanel.MinModelRequests}" Maximum="{x:Static vm:ToolSettingsPanel.MaxModelRequests}"
                             Value="{Binding ModelRequests}" AutomationProperties.Name="{x:Static t:UiText.LimitModelRequests}" />
              <TextBlock Grid.Row="1" Classes="caption" VerticalAlignment="Center" Margin="0,0,12,6" Text="{x:Static t:UiText.LimitToolCalls}" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Name="LimitToolCalls" Width="150" Margin="0,0,0,6" FormatString="0" Increment="1"
                             Minimum="{x:Static vm:ToolSettingsPanel.MinToolCalls}" Maximum="{x:Static vm:ToolSettingsPanel.MaxToolCalls}"
                             Value="{Binding ToolCalls}" AutomationProperties.Name="{x:Static t:UiText.LimitToolCalls}" />
              <TextBlock Grid.Row="2" Classes="caption" VerticalAlignment="Center" Margin="0,0,12,6" Text="{x:Static t:UiText.LimitMinutes}" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" Name="LimitMinutes" Width="150" Margin="0,0,0,6" FormatString="0" Increment="1"
                             Minimum="{x:Static vm:ToolSettingsPanel.MinMinutes}" Maximum="{x:Static vm:ToolSettingsPanel.MaxMinutes}"
                             Value="{Binding Minutes}" AutomationProperties.Name="{x:Static t:UiText.LimitMinutes}" />
              <TextBlock Grid.Row="3" Classes="caption" VerticalAlignment="Center" Margin="0,0,12,0" Text="{x:Static t:UiText.LimitTokens}" />
              <NumericUpDown Grid.Row="3" Grid.Column="1" Name="LimitTokens" Width="150" FormatString="N0" Increment="10000"
                             Minimum="{x:Static vm:ToolSettingsPanel.MinTokens}" Maximum="{x:Static vm:ToolSettingsPanel.MaxTokens}"
                             Value="{Binding Tokens}" AutomationProperties.Name="{x:Static t:UiText.LimitTokens}" />
            </Grid>
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static t:UiText.RunLimitsHint}" />
            <Button Grid.Row="4" Grid.Column="1" Name="RestoreLimits" Classes="quiet small" HorizontalAlignment="Left" Margin="-6,6,0,0"
                    Content="{x:Static t:UiText.RestoreDefaultLimits}" Command="{Binding RestoreDefaultsCommand}" IsEnabled="{Binding UsesTools}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Name="ToolSettingsStatus" v:Motion.Appear="Fade" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                       Classes.muted="{Binding !StatusIsError}" Classes.error="{Binding StatusIsError}"
                       Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Grid>
        </StackPanel>
      </Border>
      <!-- 设置 › 工具 › 网络搜索 (requirements §10.4.5): the service, the key (only whether it is set), test, the switch's default. -->
      <StackPanel Name="WebSearchSection" DataContext="{Binding Tools.Web}" x:DataType="vm:WebSearchSettingsPanel"
                  IsVisible="{Binding $parent[StackPanel].((vm:SettingsHomeViewModel)DataContext).Tools.HasWeb, FallbackValue=False}">
        <TextBlock Name="WebSearchHeading" FontWeight="SemiBold" FontSize="14" Margin="2,18,0,2" Text="{x:Static t:UiText.WebSearchSettingsTitle}" />
        <TextBlock Classes="caption" Margin="2,0,0,10" TextWrapping="Wrap" Text="{x:Static t:UiText.WebSearchSettingsIntro}" />
        <Border Classes="card settings">
          <Grid Classes="labelled" RowDefinitions="Auto,Auto,Auto,Auto,Auto" IsEnabled="{Binding IsAvailable}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="SettingsLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Classes="field-label" Text="{x:Static t:UiText.WebSearchService}" />
            <TextBlock Grid.Column="1" Name="WebSearchServiceName" Text="{Binding ServiceName}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Classes="field-label" Margin="0,14,0,0" Text="{x:Static t:UiText.WebSearchKey}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Spacing="6">
              <TextBlock Name="WebSearchKeyState" Classes="caption" Text="{Binding KeyState}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Name="WebSearchKeyBox" Width="260" PasswordChar="•" Text="{Binding NewKey}" PlaceholderText="{x:Static t:UiText.WebSearchKeyPlaceholder}"
                         AutomationProperties.Name="{x:Static t:UiText.WebSearchKey}" />
                <Button Name="WebSearchSaveKey" Classes="secondary" Content="{x:Static t:UiText.WebSearchKeySave}" Command="{Binding SaveKeyCommand}" />
                <Button Name="WebSearchTest" Classes="quiet" Content="{x:Static t:UiText.WebSearchTest}" Command="{Binding TestCommand}"
                        ToolTip.Tip="{x:Static t:UiText.WebSearchTestTip}" />
                <Button Name="WebSearchRemoveKey" Classes="quiet" Content="{x:Static t:UiText.WebSearchKeyRemove}" Command="{Binding RemoveKeyCommand}"
                        IsVisible="{Binding HasKey}" />
              </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="2" Classes="field-label" Margin="0,16,0,0" Padding="0" MaxWidth="96" HorizontalAlignment="Left"
                       Text="{x:Static t:UiText.WebSearchDefault}" TextWrapping="Wrap" />
            <StackPanel Grid.Row="2" Grid.Column="1" Name="WebSearchDefaultChoice" Orientation="Horizontal" Spacing="16" Margin="0,16,0,0">
              <RadioButton GroupName="WebSearchDefault" Content="{x:Static t:UiText.WebSearchAuto}" IsChecked="{Binding IsAuto}" />
              <RadioButton GroupName="WebSearchDefault" Content="{x:Static t:UiText.WebSearchOn}" IsChecked="{Binding IsOn}" />
              <RadioButton GroupName="WebSearchDefault" Content="{x:Static t:UiText.WebSearchOff}" IsChecked="{Binding IsOff}" />
            </StackPanel>
            <TextBlock Grid.Row="3" Grid.Column="1" Name="WebSearchStatus" v:Motion.Appear="Fade" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                       Classes.muted="{Binding !StatusIsError}" Classes.error="{Binding StatusIsError}"
                       Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Grid>
        </Border>
      </StackPanel>
      <!-- 设置 › 工具 › MCP 服务器 (requirements §10.4.6): add with a confirmation of what runs, each server's state, its tools
           off until enabled, each enabled tool's risk. -->
      <StackPanel Name="McpSection" DataContext="{Binding Tools.Mcp}" x:DataType="vm:McpServersPanel"
                  IsVisible="{Binding $parent[StackPanel].((vm:SettingsHomeViewModel)DataContext).Tools.HasMcp, FallbackValue=False}">
        <TextBlock Name="McpHeading" FontWeight="SemiBold" FontSize="14" Margin="2,18,0,2" Text="{x:Static t:UiText.McpSettingsTitle}" />
        <TextBlock Classes="caption" Margin="2,0,0,10" TextWrapping="Wrap" Text="{x:Static t:UiText.McpSettingsIntro}" />
        <Border Classes="card settings">
          <StackPanel Spacing="12" IsEnabled="{Binding IsAvailable}">
            <TextBlock Name="McpNoServers" Classes="caption" Text="{x:Static t:UiText.McpNoServers}" IsVisible="{Binding !HasServers}" />
            <ItemsControl Name="McpServerList" ItemsSource="{Binding Servers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:McpServerItem">
                  <Border Classes="mcp-server">
                    <StackPanel Spacing="6">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                          <Button Name="McpStart" Classes="secondary small" Content="{Binding StartLabel}" Command="{Binding StartCommand}" />
                          <Button Name="McpStop" Classes="quiet small" Content="{x:Static t:UiText.McpStop}" Command="{Binding StopCommand}" />
                          <Button Name="McpRemove" Classes="quiet small" Content="{x:Static t:UiText.McpRemove}" Command="{Binding AskRemoveCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Name="McpServerName" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" />
                          <Border Classes="badge"><TextBlock Text="{Binding Kind}" /></Border>
                          <TextBlock Name="McpServerState" Classes="caption" Classes.error="{Binding IsProblem}" Text="{Binding StateText}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DockPanel>
                      <SelectableTextBlock Name="McpServerTarget" Classes="address muted" Text="{Binding Target}" TextWrapping="Wrap" />
                      <SelectableTextBlock Name="McpServerError" Classes="error" FontSize="12" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                      <StackPanel Spacing="2" IsVisible="{Binding HasStandardError}">
                        <TextBlock Classes="caption" Text="{x:Static t:UiText.McpStandardError}" />
                        <Border Classes="arguments">
                          <SelectableTextBlock Name="McpServerOutput" Classes="arguments" Text="{Binding StandardError}" TextWrapping="Wrap" MaxHeight="120" />
                        </Border>
                      </StackPanel>
                      <Border Classes="notice warning" IsVisible="{Binding IsConfirmingRemove}">
                        <StackPanel Spacing="6">
                          <TextBlock TextWrapping="Wrap" Text="{x:Static t:UiText.McpRemoveHint}" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Name="McpRemoveConfirm" Classes="danger small" Content="{x:Static t:UiText.McpRemoveConfirm}" Command="{Binding RemoveCommand}" />
                            <Button Classes="quiet small" Content="{x:Static t:UiText.McpCancel}" Command="{Binding CancelRemoveCommand}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      <!-- A server's tools (2026-11-19): expanded in a scroll area with a filter, or only the enabled ones. -->
                      <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Name="McpToolsToggle" Classes="quiet small" Command="{Binding ToggleToolsCommand}"
                                IsVisible="{Binding HasToggle}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding ToggleLabel}" VerticalAlignment="Center" />
                            <PathIcon Classes="mcp-tools-chevron" Classes.expanded="{Binding IsExpanded}" Data="{StaticResource IconChevronDown}" />
                          </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Classes="caption" FontWeight="SemiBold" Text="{x:Static t:UiText.McpToolsHeading}" />
                          <TextBlock Name="McpToolCount" Classes="caption" Text="{Binding ToolCount}" />
                        </StackPanel>
                      </DockPanel>
                      <TextBox Name="McpToolFilter" Width="240" HorizontalAlignment="Left" Text="{Binding Filter}"
                               PlaceholderText="{x:Static t:UiText.McpToolsFilterPlaceholder}" IsVisible="{Binding ShowsFilter}"
                               AutomationProperties.Name="{x:Static t:UiText.McpToolsFilterPlaceholder}" />
                      <TextBlock Classes="caption" Text="{x:Static t:UiText.McpToolsNotListed}" IsVisible="{Binding HasNoListing}" />
                      <TextBlock Name="McpToolsEmpty" Classes="caption" Text="{Binding EmptyNote}" IsVisible="{Binding HasEmptyNote}" />
                      <ScrollViewer Name="McpToolScroll" MaxHeight="360" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <ItemsControl Name="McpToolList" ItemsSource="{Binding VisibleTools}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:McpToolItem">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                              <CheckBox Name="McpToolToggle" VerticalAlignment="Top" IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Name}"
                                        ToolTip.Tip="{x:Static t:UiText.McpEnableTool}" />
                              <StackPanel Grid.Column="1" Spacing="2" Margin="2,4,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Name="McpToolName" Classes="address" Text="{Binding Name}" VerticalAlignment="Center" />
                                  <Border Classes="badge" IsVisible="{Binding DeclaresReadOnly}"><TextBlock Text="{x:Static t:UiText.McpDeclaresReadOnly}" /></Border>
                                </StackPanel>
                                <TextBlock Classes="caption" Text="{Binding Description}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding HasDescription}" ToolTip.Tip="{Binding Description}" />
                                <TextBlock Name="McpToolDisabledReason" Classes="caption warning" FontSize="12" Text="{Binding DisabledReason}" TextWrapping="Wrap"
                                           IsVisible="{Binding HasDisabledReason}" />
                              </StackPanel>
                              <ComboBox Grid.Column="2" Name="McpToolRisk" Classes="settings" Width="200" VerticalAlignment="Top"
                                        ItemsSource="{x:Static vm:McpToolItem.Risks}" SelectedIndex="{Binding RiskIndex}" IsVisible="{Binding IsOn}"
                                        AutomationProperties.Name="{x:Static t:UiText.McpRiskLabel}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      </ScrollViewer>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Name="McpAdd" Classes="secondary" HorizontalAlignment="Left" Content="{x:Static t:UiText.McpAdd}" Command="{Binding StartAddCommand}"
                    IsVisible="{Binding IsIdle}" />

            <!-- 添加: the form. -->
            <Grid Classes="labelled" Name="McpAddForm" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="{Binding IsAdding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="McpLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16" Margin="0,0,0,10">
                <RadioButton Name="McpKindCommand" GroupName="McpKind" Content="{x:Static t:UiText.McpKindCommand}" IsChecked="{Binding IsCommand}" />
                <RadioButton Name="McpKindHttp" GroupName="McpKind" Content="{x:Static t:UiText.McpKindHttp}" IsChecked="{Binding IsHttp}" />
              </StackPanel>
              <TextBlock Grid.Row="1" Classes="field-label" Text="{x:Static t:UiText.McpName}" />
              <TextBox Grid.Row="1" Grid.Column="1" Name="McpNewName" Text="{Binding NewName}" PlaceholderText="{x:Static t:UiText.McpNamePlaceholder}"
                       AutomationProperties.Name="{x:Static t:UiText.McpName}" />
              <TextBlock Grid.Row="2" Classes="field-label" Margin="0,10,0,0" Text="{x:Static t:UiText.McpCommand}" IsVisible="{Binding IsCommand}" />
              <TextBox Grid.Row="2" Grid.Column="1" Name="McpNewCommand" Margin="0,10,0,0" Classes="mono" Text="{Binding NewCommand}"
                       PlaceholderText="{x:Static t:UiText.McpCommandPlaceholder}" IsVisible="{Binding IsCommand}" AutomationProperties.Name="{x:Static t:UiText.McpCommand}" />
              <TextBlock Grid.Row="3" Classes="field-label" Margin="0,10,0,0" VerticalAlignment="Top" Text="{x:Static t:UiText.McpArguments}" IsVisible="{Binding IsCommand}" />
              <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Spacing="4" IsVisible="{Binding IsCommand}">
                <TextBox Name="McpNewArguments" Classes="mono" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Text="{Binding NewArguments}"
                         AutomationProperties.Name="{x:Static t:UiText.McpArguments}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static t:UiText.McpArgumentsHint}" />
              </StackPanel>
              <TextBlock Grid.Row="4" Classes="field-label" Margin="0,10,0,0" VerticalAlignment="Top" Text="{x:Static t:UiText.McpEnvironment}" IsVisible="{Binding IsCommand}" />
              <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Spacing="4" IsVisible="{Binding IsCommand}">
                <TextBox Name="McpNewEnvironment" Classes="mono" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" Text="{Binding NewEnvironment}"
                         AutomationProperties.Name="{x:Static t:UiText.McpEnvironment}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static t:UiText.McpEnvironmentHint}" />
              </StackPanel>
              <TextBlock Grid.Row="2" Classes="field-label" Margin="0,10,0,0" Text="{x:Static t:UiText.McpUrl}" IsVisible="{Binding IsHttp}" />
              <TextBox Grid.Row="2" Grid.Column="1" Name="McpNewUrl" Margin="0,10,0,0" Classes="mono" Text="{Binding NewUrl}"
                       PlaceholderText="{x:Static t:UiText.McpUrlPlaceholder}" IsVisible="{Binding IsHttp}" AutomationProperties.Name="{x:Static t:UiText.McpUrl}" />
              <TextBlock Grid.Row="3" Classes="field-label" Margin="0,10,0,0" VerticalAlignment="Top" Text="{x:Static t:UiText.McpHeaderName}" IsVisible="{Binding IsHttp}" />
              <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Spacing="6" IsVisible="{Binding IsHttp}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Name="McpNewHeaderName" Width="200" Text="{Binding NewHeaderName}" PlaceholderText="{x:Static t:UiText.McpHeaderNamePlaceholder}"
                           AutomationProperties.Name="{x:Static t:UiText.McpHeaderName}" />
                  <TextBox Name="McpNewHeaderValue" Width="240" PasswordChar="•" Text="{Binding NewHeaderValue}" PlaceholderText="{x:Static t:UiText.McpHeaderValuePlaceholder}" />
                </StackPanel>
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static t:UiText.McpOAuthNote}" />
              </StackPanel>
              <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                <Button Name="McpReview" Classes="primary" Content="{x:Static t:UiText.McpReview}" Command="{Binding ReviewCommand}" />
                <Button Classes="quiet" Content="{x:Static t:UiText.McpCancel}" Command="{Binding CancelAddCommand}" />
              </StackPanel>
            </Grid>

            <!-- 确认: exactly what will run, or which address (requirements §10.4.6). -->
            <Border Name="McpConfirm" Classes="notice warning" IsVisible="{Binding IsConfirming}">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{x:Static t:UiText.McpConfirmTitle}" />
                <StackPanel Spacing="8" IsVisible="{Binding PreviewIsCommand}">
                  <TextBlock Classes="caption" Text="{x:Static t:UiText.McpConfirmCommand}" />
                  <Border Classes="arguments">
                    <SelectableTextBlock Name="McpConfirmCommandLine" Classes="arguments" Text="{Binding PreviewCommandLines}" TextWrapping="Wrap" />
                  </Border>
                  <TextBlock Classes="caption" Text="{x:Static t:UiText.McpConfirmFolder}" />
                  <SelectableTextBlock Name="McpConfirmFolder" Classes="address" Text="{Binding Preview.WorkingDirectory}" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="{x:Static t:UiText.McpConfirmEnvironment}" />
                  <SelectableTextBlock Name="McpConfirmEnvironment" Classes="address" Text="{Binding PreviewEnvironment}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding !PreviewIsCommand}">
                  <TextBlock Classes="caption" Text="{x:Static t:UiText.McpConfirmUrl}" />
                  <SelectableTextBlock Name="McpConfirmUrl" Classes="address" Text="{Binding Preview.Url}" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="{x:Static t:UiText.McpConfirmHeader}" />
                  <SelectableTextBlock Name="McpConfirmHeader" Classes="address" Text="{Binding PreviewHeader}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static t:UiText.McpConfirmNote}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="McpConfirmAdd" Classes="primary" Content="{x:Static t:UiText.McpConfirm}" Command="{Binding ConfirmCommand}" />
                  <Button Classes="secondary" Content="{x:Static t:UiText.McpBack}" Command="{Binding BackToFormCommand}" />
                  <Button Classes="quiet" Content="{x:Static t:UiText.McpCancel}" Command="{Binding CancelAddCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Name="McpStatus" v:Motion.Appear="Fade" FontSize="12" TextWrapping="Wrap"
                       Classes.muted="{Binding !StatusIsError}" Classes.error="{Binding StatusIsError}"
                       Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>

    <!-- 数据 -->
    <TextBlock Classes="section-heading" Margin="2,28,0,8" Text="{x:Static t:UiText.DataSection}" />
    <!-- 2026-11-12: 使用统计 sits under 数据与存储 in the same card, the same drill-in with back navigation. -->
    <Border Classes="card" Padding="4">
      <StackPanel Spacing="2">
        <Button Name="StorageDetailsButton" Classes="entry" Padding="14,10" Command="{Binding ShowStorageDetailsCommand}">
          <DockPanel>
            <PathIcon DockPanel.Dock="Right" Classes="entry-chevron" Data="{StaticResource IconChevron}" />
            <PathIcon Classes="entry-icon" Margin="0,0,12,0" VerticalAlignment="Center" Data="{StaticResource IconStorage}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Static t:UiText.StorageDetailsLink}" />
          </DockPanel>
        </Button>
        <Border Height="1" Margin="14,0" Background="{DynamicResource DividerBrush}" />
        <Button Name="StatisticsButton" Classes="entry" Padding="14,10" Command="{Binding ShowStatisticsCommand}"
                AutomationProperties.Name="{x:Static t:UiText.StatisticsLink}">
          <DockPanel>
            <PathIcon DockPanel.Dock="Right" Classes="entry-chevron" Data="{StaticResource IconChevron}" />
            <PathIcon Classes="entry-icon" Margin="0,0,12,0" VerticalAlignment="Center" Data="{StaticResource IconChart}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Static t:UiText.StatisticsLink}" />
          </DockPanel>
        </Button>
      </StackPanel>
    </Border>
    <!-- 工作区 (2026-11-10): every workspace in one place — listed, switched to, renamed and deleted on 设置 › 工作区,
         the same drill-in as 数据与存储; the entry says how many there are. -->
    <StackPanel IsVisible="{Binding CanManageWorkspaces}">
      <TextBlock Classes="section-heading" Margin="2,28,0,8" Text="{x:Static t:UiText.WorkspaceSection}" />
      <Border Classes="card" Padding="4">
        <Button Name="ManageWorkspacesButton" Classes="entry" Padding="14,10" Command="{Binding ShowWorkspacesCommand}"
                AutomationProperties.Name="{Binding ManageWorkspacesName}">
          <DockPanel>
            <PathIcon DockPanel.Dock="Right" Classes="entry-chevron" Data="{StaticResource IconChevron}" />
            <TextBlock Name="WorkspaceCountText" DockPanel.Dock="Right" Classes="caption" Margin="0,0,10,0" VerticalAlignment="Center"
                       Text="{Binding WorkspaceCountText}" />
            <PathIcon Classes="entry-icon" Margin="0,0,12,0" VerticalAlignment="Center" Data="{StaticResource IconWorkspaces}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Static t:UiText.ManageWorkspacesLink}" />
          </DockPanel>
        </Button>
      </Border>
    </StackPanel>
    <TextBlock Name="AppVersion" Classes="caption" Margin="2,14,0,0" Text="{Binding VersionText}" />
  </StackPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
