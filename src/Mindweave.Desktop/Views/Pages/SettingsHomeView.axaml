<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Pages"
             xmlns:d="using:Mindweave.Desktop"
             xmlns:t="using:Mindweave.Desktop.Text"
             xmlns:v="using:Mindweave.Desktop.Views"
             x:Class="Mindweave.Desktop.Views.Pages.SettingsHomeView"
             x:DataType="vm:SettingsHomeViewModel">
  <ScrollViewer Classes="autohide" HorizontalScrollBarVisibility="Disabled">
  <!-- One left-aligned column of at most 640 px (a star column with a maximum), as on the summary page. -->
  <Grid Margin="0,4,16,24">
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" MaxWidth="640" />
  </Grid.ColumnDefinitions>
  <StackPanel>

    <!-- 外观 -->
    <TextBlock Classes="section-heading" Text="{x:Static t:UiText.AppearanceSection}" />
    <Border Classes="card settings">
      <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto">
        <TextBlock Classes="field-label" Text="{x:Static t:UiText.ThemeLabel}" />
        <Border Grid.Column="1" Name="AppearancePicker" Classes="segmented">
          <StackPanel Orientation="Horizontal" Spacing="2" KeyboardNavigation.TabNavigation="Once">
            <RadioButton Name="AppearanceLight" Classes="segment" GroupName="Appearance" IsChecked="{Binding IsLight}"
                         AutomationProperties.Name="{x:Static t:UiText.AppearanceLight}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconSun}" />
                <TextBlock Text="{x:Static t:UiText.AppearanceLight}" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Name="AppearanceDark" Classes="segment" GroupName="Appearance" IsChecked="{Binding IsDark}"
                         AutomationProperties.Name="{x:Static t:UiText.AppearanceDark}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconMoon}" />
                <TextBlock Text="{x:Static t:UiText.AppearanceDark}" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Name="AppearanceFollowSystem" Classes="segment" GroupName="Appearance" IsChecked="{Binding IsFollowSystem}"
                         AutomationProperties.Name="{x:Static t:UiText.AppearanceFollowSystem}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconMonitor}" />
                <TextBlock Text="{x:Static t:UiText.AppearanceFollowSystem}" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>
        <TextBlock Grid.Row="1" Grid.Column="1" Name="AppearanceStatus" v:Motion.Appear="Fade" Classes="error" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="{Binding AppearanceStatus}" IsVisible="{Binding AppearanceStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </Border>

    <!-- 提示 (2026-11-10): whether the open workspace's conversations pop up a hint too (on unless turned off), and the
         sound for a hint (off unless chosen); 2026-11-11: whether a workspace's names are prepared in the background (on);
         2026-11-12: recommended questions, recommended nodes and preparing them in the background (all on, §10.3), with
         what is sent and that preparing costs a little. -->
    <StackPanel IsVisible="{Binding CanChooseNewsSound}">
      <TextBlock Classes="section-heading" Margin="2,28,0,8" Text="{x:Static t:UiText.HintsSection}" />
      <Border Classes="card settings">
        <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Classes="field-label" Text="{x:Static t:UiText.NewsInWorkspaceLabel}" />
          <CheckBox Grid.Column="1" Name="NewsInWorkspaceToggle" IsChecked="{Binding ShowsInWorkspaceNews}" Content="{x:Static t:UiText.NewsInWorkspace}"
                    AutomationProperties.Name="{x:Static t:UiText.NewsInWorkspace}" AutomationProperties.HelpText="{x:Static t:UiText.NewsInWorkspaceHint}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static t:UiText.NewsInWorkspaceHint}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Name="InWorkspaceNewsStatus" v:Motion.Appear="Fade" Classes="error" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="{Binding InWorkspaceNewsStatus}" IsVisible="{Binding InWorkspaceNewsStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Grid.Row="3" Classes="field-label" Margin="0,16,0,0" Text="{x:Static t:UiText.NewsSoundLabel}" />
          <CheckBox Grid.Row="3" Grid.Column="1" Name="NewsSoundToggle" Margin="0,16,0,0" IsChecked="{Binding PlaysNewsSound}" Content="{x:Static t:UiText.NewsSound}"
                    AutomationProperties.Name="{x:Static t:UiText.NewsSound}" AutomationProperties.HelpText="{x:Static t:UiText.NewsSoundHint}" />
          <TextBlock Grid.Row="4" Grid.Column="1" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static t:UiText.NewsSoundHint}" />
          <TextBlock Grid.Row="5" Grid.Column="1" Name="NewsSoundStatus" v:Motion.Appear="Fade" Classes="error" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="{Binding NewsSoundStatus}" IsVisible="{Binding NewsSoundStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Grid.Row="6" Classes="field-label" Margin="0,16,0,0" Text="{x:Static t:UiText.PrepareNamesLabel}" />
          <CheckBox Grid.Row="6" Grid.Column="1" Name="PrepareNamesToggle" Margin="0,16,0,0" IsChecked="{Binding PreparesNames}" Content="{x:Static t:UiText.PrepareNames}"
                    AutomationProperties.Name="{x:Static t:UiText.PrepareNames}" AutomationProperties.HelpText="{x:Static t:UiText.PrepareNamesHint}" />
          <TextBlock Grid.Row="7" Grid.Column="1" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static t:UiText.PrepareNamesHint}" />
          <TextBlock Grid.Row="8" Grid.Column="1" Name="PrepareNamesStatus" v:Motion.Appear="Fade" Classes="error" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="{Binding PrepareNamesStatus}" IsVisible="{Binding PrepareNamesStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Grid.Row="9" Classes="field-label" Margin="0,22,0,0" VerticalAlignment="Top" Text="{x:Static t:UiText.RecommendationsLabel}" IsVisible="{Binding CanChooseRecommendations}" />
          <StackPanel Grid.Row="9" Grid.Column="1" Name="RecommendationChoices" Margin="0,16,0,0" Spacing="2" IsVisible="{Binding CanChooseRecommendations}">
            <CheckBox Name="RecommendQuestionsToggle" IsChecked="{Binding RecommendsQuestions}" Content="{x:Static t:UiText.RecommendQuestionsSetting}"
                      AutomationProperties.Name="{x:Static t:UiText.RecommendQuestionsSetting}" AutomationProperties.HelpText="{x:Static t:UiText.RecommendationsHint}" />
            <CheckBox Name="RecommendNodesToggle" IsChecked="{Binding RecommendsNodes}" Content="{x:Static t:UiText.RecommendNodesSetting}"
                      AutomationProperties.Name="{x:Static t:UiText.RecommendNodesSetting}" AutomationProperties.HelpText="{x:Static t:UiText.RecommendationsHint}" />
            <CheckBox Name="AutoPrepareRecommendationsToggle" IsChecked="{Binding AutoPreparesRecommendations}" Content="{x:Static t:UiText.AutoPrepareRecommendations}"
                      AutomationProperties.Name="{x:Static t:UiText.AutoPrepareRecommendations}" AutomationProperties.HelpText="{x:Static t:UiText.RecommendationsHint}" />
          </StackPanel>
          <TextBlock Grid.Row="10" Grid.Column="1" Name="RecommendationsHint" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static t:UiText.RecommendationsHint}"
                     IsVisible="{Binding CanChooseRecommendations}" />
          <TextBlock Grid.Row="11" Grid.Column="1" Name="RecommendationsStatus" v:Motion.Appear="Fade" Classes="error" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="{Binding RecommendationsStatus}" IsVisible="{Binding RecommendationsStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- 模型连接 -->
    <TextBlock Classes="section-heading" Margin="2,28,0,2" Text="{x:Static t:UiText.ModelSection}" />
    <TextBlock Classes="caption" Margin="2,0,0,10" TextWrapping="Wrap" Text="{x:Static t:UiText.PrivacyHint}" />
    <StackPanel DataContext="{Binding Model}" x:DataType="vm:ModelSettingsViewModel" Spacing="12">
      <Border Classes="card settings">
        <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
          <TextBlock Classes="field-label" Text="{x:Static t:UiText.ProviderLabel}" />
          <ComboBox Grid.Column="1" Name="ProviderPicker" Classes="settings" MinWidth="240" HorizontalAlignment="Left"
                    ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                    PlaceholderText="{x:Static t:UiText.ProviderPlaceholder}" AutomationProperties.Name="{x:Static t:UiText.ProviderLabel}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProviderPreset">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Grid.Row="1" Classes="field-label" Text="{x:Static t:UiText.BaseUrlLabel}" />
          <TextBox Grid.Row="1" Grid.Column="1" Name="BaseUrl" Text="{Binding BaseUrl}" PlaceholderText="{x:Static t:UiText.BaseUrlPlaceholder}"
                   AutomationProperties.Name="{x:Static t:UiText.BaseUrlLabel}" />

          <TextBlock Grid.Row="2" Classes="field-label" Text="{x:Static t:UiText.ApiKeyLabel}" />
          <TextBox Grid.Row="2" Grid.Column="1" Name="ApiKey" Text="{Binding ApiKey}" PasswordChar="•" RevealPassword="False"
                   PlaceholderText="{Binding KeyPlaceholder}" AutomationProperties.Name="{x:Static t:UiText.ApiKeyLabel}" />

          <TextBlock Grid.Row="3" Classes="field-label" Text="{x:Static t:UiText.ModelLabel}" />
          <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Name="ModelBox" Text="{Binding Model}" PlaceholderText="{x:Static t:UiText.ModelPlaceholder}"
                     AutomationProperties.Name="{x:Static t:UiText.ModelLabel}">
              <TextBox.InnerRightContent>
                <Button Name="ModelListToggle" Classes="field-toggle" Click="OnModelListToggle" Focusable="False"
                        ToolTip.Tip="{x:Static t:UiText.ShowModels}" AutomationProperties.Name="{x:Static t:UiText.ShowModels}"
                        IsVisible="{Binding AvailableModels.Count, Converter={x:Static d:Converters.IsPositive}}">
                  <PathIcon Data="{StaticResource IconChevronDown}" />
                </Button>
              </TextBox.InnerRightContent>
            </TextBox>
            <Popup Name="ModelPopup" PlacementTarget="{Binding #ModelBox}" Placement="BottomEdgeAlignedLeft"
                   IsOpen="{Binding IsModelListOpen, Mode=TwoWay}" IsLightDismissEnabled="True" OverlayDismissEventPassThrough="True"
                   MinWidth="{Binding #ModelBox.Bounds.Width}">
              <Border Classes="suggestions">
                <ListBox Name="ModelList" ItemsSource="{Binding ModelSuggestions}" MaxHeight="248" SelectionMode="Single" Focusable="False" />
              </Border>
            </Popup>
            <Button Grid.Column="1" Name="FetchModels" Classes="secondary" Command="{Binding DiscoverCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconRegenerate}" />
                <TextBlock Text="{x:Static t:UiText.FetchModels}" />
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock Grid.Row="4" Classes="field-label" Text="{x:Static t:UiText.ConnectionNameLabel}" />
          <TextBox Grid.Row="4" Grid.Column="1" Name="ConnectionName" Text="{Binding Name}" PlaceholderText="{x:Static t:UiText.ConnectionNamePlaceholder}"
                   AutomationProperties.Name="{x:Static t:UiText.ConnectionNameLabel}" />

          <TextBlock Grid.Row="5" Classes="field-label" VerticalAlignment="Top" Margin="0,6,0,0" Text="{x:Static t:UiText.ContextWindowLabel}" />
          <StackPanel Grid.Row="5" Grid.Column="1" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Name="ContextWindow" Text="{Binding ContextWindow}" PlaceholderText="{x:Static t:UiText.ContextWindowPlaceholder}" Width="180"
                       AutomationProperties.Name="{x:Static t:UiText.ContextWindowLabel}" />
              <TextBlock Classes="caption" VerticalAlignment="Center" Text="{x:Static t:UiText.TokensUnit}" />
            </StackPanel>
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static t:UiText.ContextWindowHint}" />
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
        <Button Name="SaveModel" Classes="primary" Content="{x:Static t:UiText.Save}" Command="{Binding SaveCommand}" />
        <Button Name="TestModel" Classes="secondary" Content="{x:Static t:UiText.TestConnection}" Command="{Binding TestCommand}"
                ToolTip.Tip="{x:Static t:UiText.TestCostTip}" />
        <TextBlock Classes="caption" VerticalAlignment="Center" Margin="4,0,0,0" Text="{x:Static t:UiText.TestCostHint}" />
      </StackPanel>
      <TextBlock Name="ModelStatus" v:Motion.Appear="Fade" Margin="2,0,0,0" Text="{Binding Status}" TextWrapping="Wrap" FontSize="13"
                 Classes.muted="{Binding !StatusIsError}" Classes.error="{Binding StatusIsError}"
                 IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <!-- 数据 -->
    <TextBlock Classes="section-heading" Margin="2,28,0,8" Text="{x:Static t:UiText.DataSection}" />
    <!-- 2026-11-12: 使用统计 sits under 数据与存储 in the same card, the same drill-in with back navigation. -->
    <Border Classes="card" Padding="4">
      <StackPanel Spacing="2">
        <Button Name="StorageDetailsButton" Classes="entry" Padding="14,10" Command="{Binding ShowStorageDetailsCommand}">
          <DockPanel>
            <PathIcon DockPanel.Dock="Right" Classes="entry-chevron" Data="{StaticResource IconChevron}" />
            <PathIcon Classes="entry-icon" Margin="0,0,12,0" VerticalAlignment="Center" Data="{StaticResource IconStorage}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Static t:UiText.StorageDetailsLink}" />
          </DockPanel>
        </Button>
        <Border Height="1" Margin="14,0" Background="{DynamicResource DividerBrush}" />
        <Button Name="StatisticsButton" Classes="entry" Padding="14,10" Command="{Binding ShowStatisticsCommand}"
                AutomationProperties.Name="{x:Static t:UiText.StatisticsLink}">
          <DockPanel>
            <PathIcon DockPanel.Dock="Right" Classes="entry-chevron" Data="{StaticResource IconChevron}" />
            <PathIcon Classes="entry-icon" Margin="0,0,12,0" VerticalAlignment="Center" Data="{StaticResource IconChart}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Static t:UiText.StatisticsLink}" />
          </DockPanel>
        </Button>
      </StackPanel>
    </Border>
    <!-- 工作区 (2026-11-10): every workspace in one place — listed, switched to, renamed and deleted on 设置 › 工作区,
         the same drill-in as 数据与存储; the entry says how many there are. -->
    <StackPanel IsVisible="{Binding CanManageWorkspaces}">
      <TextBlock Classes="section-heading" Margin="2,28,0,8" Text="{x:Static t:UiText.WorkspaceSection}" />
      <Border Classes="card" Padding="4">
        <Button Name="ManageWorkspacesButton" Classes="entry" Padding="14,10" Command="{Binding ShowWorkspacesCommand}"
                AutomationProperties.Name="{Binding ManageWorkspacesName}">
          <DockPanel>
            <PathIcon DockPanel.Dock="Right" Classes="entry-chevron" Data="{StaticResource IconChevron}" />
            <TextBlock Name="WorkspaceCountText" DockPanel.Dock="Right" Classes="caption" Margin="0,0,10,0" VerticalAlignment="Center"
                       Text="{Binding WorkspaceCountText}" />
            <PathIcon Classes="entry-icon" Margin="0,0,12,0" VerticalAlignment="Center" Data="{StaticResource IconWorkspaces}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Static t:UiText.ManageWorkspacesLink}" />
          </DockPanel>
        </Button>
      </Border>
    </StackPanel>
    <TextBlock Name="AppVersion" Classes="caption" Margin="2,14,0,0">
      <Run Text="{x:Static t:UiText.AppName}" />
      <Run Text="{Binding Environment.Version}" />
      <Run Text=" · " />
      <Run Text="{x:Static t:UiText.ChannelLabel}" />
      <Run Text="{Binding Environment.Channel}" />
    </TextBlock>
  </StackPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
