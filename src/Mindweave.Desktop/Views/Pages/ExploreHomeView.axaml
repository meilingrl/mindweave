<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Pages"
             xmlns:d="using:Mindweave.Desktop"
             x:Class="Mindweave.Desktop.Views.Pages.ExploreHomeView"
             x:DataType="vm:ExploreHomeViewModel">
  <StackPanel Spacing="14" HorizontalAlignment="Left">
    <TextBlock Classes="muted" Text="{x:Static d:UiText.ExploreHomeHint}" />
    <!-- The page's one primary action. -->
    <Button Name="StartConversation" Classes="primary" Command="{Binding NewConversationCommand}" HorizontalAlignment="Left"
            AutomationProperties.Name="{x:Static d:UiText.NewConversation}">
      <StackPanel Orientation="Horizontal" Spacing="7">
        <PathIcon Width="12" Height="12" Data="{StaticResource IconPlus}" />
        <TextBlock Text="{x:Static d:UiText.NewConversation}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </StackPanel>
</UserControl>
