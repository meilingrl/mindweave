<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Pages"
             xmlns:d="using:Mindweave.Desktop"
             x:Class="Mindweave.Desktop.Views.Pages.ExploreHomeView"
             x:DataType="vm:ExploreHomeViewModel">
  <StackPanel Spacing="12" HorizontalAlignment="Left">
    <TextBlock Classes="muted" Text="从一个问题开始，或在左侧打开已有会话。" />
    <Button Name="StartConversation" Content="＋ 新会话" Command="{Binding NewConversationCommand}" />
  </StackPanel>
</UserControl>
