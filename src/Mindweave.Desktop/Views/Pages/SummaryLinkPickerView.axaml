<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Pages"
             xmlns:v="using:Mindweave.Desktop.Views.Pages"
             xmlns:t="using:Mindweave.Desktop.Text"
             xmlns:views="using:Mindweave.Desktop.Views"
             x:Class="Mindweave.Desktop.Views.Pages.SummaryLinkPickerView"
             x:DataType="vm:SummaryLinksPanel">
  <!-- "关联到…" from the keyboard (D-018: canvas nodes are not keyboard-reachable): the search box takes focus, Enter picks the
       first match, Tab reaches each row; an already-linked summary is listed, disabled, and says why. Esc closes it. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelPickerCommand}" />
  </UserControl.KeyBindings>
  <!-- The list gives way when there is little height, so 取消 stays in view. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="8">
    <TextBlock Name="LinkPickerHeading" FontWeight="SemiBold" Margin="0,0,24,0" TextWrapping="Wrap" Text="{Binding PickerHeading}" />
    <TextBox Grid.Row="1" Name="LinkPickerSearch" Text="{Binding PickerQuery}" PlaceholderText="{x:Static t:UiText.LinkPickerSearch}"
             AutomationProperties.Name="{x:Static t:UiText.LinkPickerSearchName}" views:FocusRequest.When="{Binding IsPickerOpen}">
      <TextBox.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding PickFirstCommand}" />
      </TextBox.KeyBindings>
    </TextBox>
    <ScrollViewer Grid.Row="2" Classes="autohide" MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl Name="LinkPickerList" ItemsSource="{Binding PickerItems}" AutomationProperties.Name="{x:Static t:UiText.LinkPickerListName}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SummaryLinkCandidateItem">
          <DockPanel Margin="0,1">
            <Border DockPanel.Dock="Right" Classes="badge" Margin="6,0,0,0" IsVisible="{Binding Linked}">
              <TextBlock Text="{x:Static t:UiText.AlreadyLinked}" />
            </Border>
            <Button Name="LinkCandidateRow" Classes="list-name" Classes.read="{Binding Linked}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Command="{Binding $parent[v:SummaryLinkPickerView].((vm:SummaryLinksPanel)DataContext).PickCommand}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding AutomationName}">
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
            </Button>
          </DockPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="3" Name="LinkPickerEmpty" Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding PickerEmptyText}"
               IsVisible="{Binding PickerEmptyText, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock Grid.Row="4" Name="LinkPickerNotice" Classes="warning" FontSize="12" TextWrapping="Wrap" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" />
    <Button Grid.Row="5" Name="CloseLinkPickerButton" Classes="quiet" HorizontalAlignment="Left" Content="{x:Static t:UiText.Cancel}" Command="{Binding CancelPickerCommand}"
            AutomationProperties.Name="{x:Static t:UiText.LinkPickCancelName}" />
  </Grid>
</UserControl>
