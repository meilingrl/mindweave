<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Pages"
             xmlns:d="using:Mindweave.Desktop"
             xmlns:v="using:Mindweave.Desktop.Views"
             x:Class="Mindweave.Desktop.Views.Pages.WorkspacesView"
             x:DataType="vm:WorkspacesViewModel">
  <!-- 设置 › 工作区 (2026-11-10): every workspace with what it holds; the open one tagged 当前; per row 切换, 改名 (in
       place: Enter saves, Esc cancels) and 删除工作区… (the window's confirmation). Styles/WorkspaceSwitcher.axaml. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="0,4,16,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MaxWidth="640" />
    </Grid.ColumnDefinitions>
    <StackPanel>
      <DockPanel Margin="2,0,0,12">
        <Button Name="NewWorkspaceOnPage" DockPanel.Dock="Right" Classes="secondary" Command="{Binding BeginCreateCommand}" Margin="16,0,0,0"
                VerticalAlignment="Center" IsEnabled="{Binding !IsCreating}" AutomationProperties.Name="{x:Static d:UiText.NewWorkspaceEntry}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconPlus}" />
            <TextBlock Text="{x:Static d:UiText.NewWorkspaceEntry}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" Text="{x:Static d:UiText.WorkspacesIntro}" />
      </DockPanel>

      <!-- A new workspace is named here and listed without switching to it, so this page stays in view. -->
      <Border Name="NewWorkspaceCard" Classes="card settings" Margin="0,0,0,12" IsVisible="{Binding IsCreating}">
        <StackPanel Spacing="8">
          <TextBox Name="NewWorkspaceNameOnPage" Text="{Binding NewWorkspace.Name}" PlaceholderText="{x:Static d:UiText.WorkspaceNameWatermark}"
                   AutomationProperties.Name="{x:Static d:UiText.WorkspaceNameLabel}" KeyDown="OnNewWorkspaceKeyDown" />
          <TextBlock Name="NewWorkspaceErrorOnPage" Classes="error" FontSize="12" TextWrapping="Wrap" Text="{Binding NewWorkspace.Error}"
                     IsVisible="{Binding NewWorkspace.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Name="CancelNewWorkspaceOnPage" Classes="quiet" Content="{x:Static d:UiText.Cancel}" Command="{Binding CancelCreateCommand}"
                    AutomationProperties.Name="{x:Static d:UiText.CancelNewWorkspace}" />
            <Button Name="CreateWorkspaceOnPage" Classes="primary" Content="{x:Static d:UiText.Create}" Command="{Binding NewWorkspace.SubmitCommand}"
                    AutomationProperties.Name="{x:Static d:UiText.CreateWorkspace}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="4">
        <ItemsControl Name="WorkspaceRows" ItemsSource="{Binding Rows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WorkspaceRowViewModel">
              <Border Name="WorkspaceRow" Classes="workspace-row" AutomationProperties.Name="{Binding AutomationName}" KeyDown="OnRowKeyDown">
                <DockPanel>
                  <!-- The row's actions; while renaming, 保存 and 取消 take their place. -->
                  <StackPanel Name="WorkspaceRowActions" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                              Margin="12,0,0,0" IsVisible="{Binding !IsRenaming}">
                    <Button Name="SwitchWorkspaceButton" Classes="quiet small" Command="{Binding SwitchCommand}" IsVisible="{Binding !IsCurrent}"
                            AutomationProperties.Name="{Binding SwitchName}" Content="{x:Static d:UiText.SwitchToWorkspace}" />
                    <Button Name="RenameWorkspaceButton" Classes="quiet small" Command="{Binding BeginRenameCommand}"
                            AutomationProperties.Name="{Binding RenameName}" ToolTip.Tip="{x:Static d:UiText.Rename}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource IconRename}" />
                        <TextBlock Text="{x:Static d:UiText.Rename}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Name="DeleteWorkspaceButton" Classes="quiet small danger" Command="{Binding DeleteCommand}"
                            AutomationProperties.Name="{Binding DeleteName}" ToolTip.Tip="{x:Static d:UiText.DeleteWorkspace}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource IconDelete}" />
                        <TextBlock Text="{x:Static d:UiText.RowDelete}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <StackPanel Name="WorkspaceRenameActions" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top"
                              Margin="10,0,0,0" Height="28" IsVisible="{Binding IsRenaming}">
                    <!-- 2026-11-11: asks the model for names drawn from the conversations (换一批 once names are offered);
                         never renames by itself. -->
                    <Button Name="SuggestNamesButton" Classes="quiet small suggest-names" Command="{Binding SuggestNamesCommand}"
                            IsVisible="{Binding CanSuggestNames}" ToolTip.Tip="{Binding SuggestTip}" ToolTip.ShowOnDisabled="True"
                            AutomationProperties.Name="{Binding SuggestName}" AutomationProperties.HelpText="{Binding SuggestTip}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource IconSparkle}" />
                        <TextBlock Text="{Binding SuggestLabel}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Name="CancelRenameWorkspaceButton" Classes="quiet small" Content="{x:Static d:UiText.Cancel}" Command="{Binding CancelRenameCommand}" />
                    <Button Name="SaveRenameWorkspaceButton" Classes="primary" Padding="12,4" FontSize="12.5" Content="{x:Static d:UiText.Save}" Command="{Binding CommitRenameCommand}" />
                  </StackPanel>
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <DockPanel Classes="workspace-name-line" LastChildFill="False" IsVisible="{Binding !IsRenaming}">
                      <TextBlock Name="WorkspaceRowName" DockPanel.Dock="Left" Classes="workspace-row-name" Text="{Binding Name}" />
                      <Border Name="CurrentWorkspaceTag" DockPanel.Dock="Left" Classes="badge accent" Margin="8,0,0,0" IsVisible="{Binding IsCurrent}">
                        <TextBlock Text="{x:Static d:UiText.CurrentWorkspaceTag}" />
                      </Border>
                    </DockPanel>
                    <!-- The name turns into a box of the same place and weight: Enter saves, Esc cancels. A suggested name
                         (kept from before, or just asked for) shows dimly after the text: Tab takes it, Tab again the next. -->
                    <v:GhostTextBox Name="WorkspaceRenameBox" Classes="workspace-rename" IsVisible="{Binding IsRenaming}" Text="{Binding RenameText}"
                                    Suggestions="{Binding GhostNames}" OfferHelpFormat="{x:Static d:UiText.GhostNameHelpFormat}"
                                    GhostForeground="{DynamicResource SuggestionGhostText}" KeyHintBorderBrush="{DynamicResource OutlineBrush}"
                                    AutomationProperties.Name="{x:Static d:UiText.WorkspaceNameLabel}" KeyDown="OnRenameBoxKeyDown" />
                    <TextBlock Name="WorkspaceRowCounts" Classes="caption" Text="{Binding CountsText}" IsVisible="{Binding ShowsCounts}" />
                    <!-- While renaming, the same line says what 建议名称 sends, before anything is sent (the row keeps its height). -->
                    <TextBlock Name="SuggestNamesHint" Classes="caption" Text="{x:Static d:UiText.SuggestNamesHint}" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding ShowsSuggestHint}" ToolTip.Tip="{x:Static d:UiText.SuggestNamesHint}" />
                    <!-- Once names are offered: what Tab does, and 更多建议 to see them all as chips (the line keeps the row's height). -->
                    <DockPanel Name="GhostNamesHintLine" IsVisible="{Binding ShowsGhostHint}">
                      <Button Name="NameChipsToggle" DockPanel.Dock="Right" Classes="link caption-link" Margin="8,0,0,0" Content="{Binding ChipsToggleLabel}"
                              Command="{Binding ToggleChipsCommand}" AutomationProperties.Name="{Binding ChipsToggleName}" />
                      <TextBlock Name="GhostNamesHint" Classes="caption" Text="{x:Static d:UiText.GhostNamesHint}" TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" ToolTip.Tip="{x:Static d:UiText.GhostNamesHint}" />
                    </DockPanel>
                    <TextBlock Name="WorkspaceRenameError" Classes="error" FontSize="12" TextWrapping="Wrap" Text="{Binding RenameError}"
                               IsVisible="{Binding RenameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <!-- Under the box (2026-11-11): the request running, a problem, or, under 更多建议, every name as a chip
                         (Enter or Space picks one). -->
                    <StackPanel Name="SuggestionPanel" Spacing="6" Margin="0,8,0,2" IsVisible="{Binding ShowsSuggestionPanel}" v:Motion.Appear="Fade">
                      <StackPanel Name="SuggestingLine" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSuggesting}">
                        <v:ActivitySpinner Classes="suggest-spinner" VerticalAlignment="Center" />
                        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{x:Static d:UiText.SuggestingNames}" />
                        <Button Name="StopSuggestingButton" Classes="quiet small" Content="{x:Static d:UiText.StopSuggesting}"
                                Command="{Binding StopSuggestingNamesCommand}" AutomationProperties.Name="{x:Static d:UiText.StopSuggestingName}" />
                      </StackPanel>
                      <TextBlock Name="SuggestionsCaption" Classes="caption" Text="{x:Static d:UiText.SuggestionsCaption}" IsVisible="{Binding ShowsChipList}" />
                      <ItemsControl Name="SuggestionChips" ItemsSource="{Binding Suggestions}" IsVisible="{Binding ShowsChipList}"
                                    AutomationProperties.Name="{x:Static d:UiText.SuggestionsListName}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:NameSuggestionViewModel">
                            <Button Name="SuggestionChip" Classes="suggestion-chip" Content="{Binding Name}" Command="{Binding PickCommand}"
                                    AutomationProperties.Name="{Binding AutomationName}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <WrapPanel Name="SuggestionProblemLine" IsVisible="{Binding HasSuggestionProblem}" ItemSpacing="4">
                        <TextBlock Name="SuggestionProblemText" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Text="{Binding SuggestionProblem}" />
                        <Button Name="RetrySuggestButton" Classes="quiet small" Content="{x:Static d:UiText.Retry}" Command="{Binding SuggestNamesCommand}"
                                IsVisible="{Binding SuggestionCanRetry}" AutomationProperties.Name="{x:Static d:UiText.RetrySuggestName}" />
                        <Button Name="SuggestSettingsButton" Classes="quiet small" Content="{x:Static d:UiText.OpenSettingsLink}"
                                Command="{Binding OpenModelSettingsCommand}" IsVisible="{Binding SuggestionNeedsSettings}" />
                      </WrapPanel>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
