<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Pages"
             xmlns:d="using:Mindweave.Desktop"
             xmlns:t="using:Mindweave.Desktop.Text"
             xmlns:v="using:Mindweave.Desktop.Views"
             x:Class="Mindweave.Desktop.Views.Pages.StorageDetailsView"
             x:DataType="vm:StorageDetailsViewModel">
  <ScrollViewer Classes="autohide" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="0,4,16,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MaxWidth="640" />
    </Grid.ColumnDefinitions>
    <StackPanel>
      <!-- 位置 -->
      <TextBlock Classes="section-heading" Text="{x:Static t:UiText.LocationSection}" />
      <Border Classes="card settings">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="96" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Classes="field-label" Text="{x:Static t:UiText.DataDirectoryLabel}" />
          <SelectableTextBlock Grid.Column="1" Name="DataDirectory" Classes="path" Text="{Binding Environment.DataDirectory}" />
          <Button Grid.Column="2" Name="OpenDataFolder" Classes="quiet" Command="{Binding OpenDataFolderCommand}"
                  ToolTip.Tip="{x:Static t:UiText.OpenDataFolder}" AutomationProperties.Name="{x:Static t:UiText.OpenDataFolder}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconFolder}" />
              <TextBlock Text="{x:Static t:UiText.OpenFolder}" />
            </StackPanel>
          </Button>
          <TextBlock Grid.Row="1" Classes="field-label" Text="{x:Static t:UiText.DatabaseLabel}" />
          <SelectableTextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Name="DatabaseFile" Classes="path"
                               Text="{Binding Environment.DatabasePath, Converter={x:Static d:Converters.FileName}}"
                               ToolTip.Tip="{Binding Environment.DatabasePath}" />
          <TextBlock Grid.Row="2" Classes="field-label" Text="{x:Static t:UiText.SchemaVersionLabel}" />
          <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Environment.SchemaVersion}" />
        </Grid>
      </Border>

      <!-- 备份 (2026-11-12): each can be restored or deleted, several deleted at once through their boxes; a backup made
           before a delete or a restore is marked by a badge, the files an earlier restore put aside are listed with them. -->
      <TextBlock Classes="section-heading" Margin="2,28,0,8" Text="{x:Static t:UiText.BackupsLabel}" />
      <Border Classes="card settings">
        <StackPanel Spacing="12">
          <TextBlock Name="NoBackups" Classes="muted" TextWrapping="Wrap" Text="{x:Static t:UiText.NoBackupsShort}" IsVisible="{Binding !HasBackups}" />
          <DockPanel IsVisible="{Binding HasBackups}" MinHeight="28">
            <Button Name="DeleteSelectedBackups" DockPanel.Dock="Right" Classes="quiet small danger" Command="{Binding DeleteSelectedCommand}"
                    IsVisible="{Binding HasSelection}" AutomationProperties.Name="{Binding DeleteSelectedText}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconDelete}" />
                <TextBlock Text="{Binding DeleteSelectedText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Name="BackupsTotal" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding TotalText}" />
          </DockPanel>
          <!-- One column grid for all rows (shared sizes), so dates, badges, sizes and actions line up whatever a row lacks; the
               reason badge takes what is left and wraps, so the size and the actions always stay in view. On a narrow page
               the size and the actions are a second line. -->
          <ItemsControl Name="BackupList" ClipToBounds="False" ItemsSource="{Binding Rows}" IsVisible="{Binding HasBackups}" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BackupRowViewModel">
                <Grid Classes="backup-line" v:Narrow.Below="480" ColumnSpacing="10" RowDefinitions="Auto,Auto" ToolTip.Tip="{Binding Hint}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Check" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Time" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Version" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ToggleButton Name="BackupCheck" Classes="row-check-toggle" Margin="-3,0,0,0" IsChecked="{Binding IsChecked}"
                                AutomationProperties.Name="{Binding SelectName}" AutomationProperties.ControlTypeOverride="CheckBox" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding TimeText}" />
                  <Border Grid.Column="2" Classes="badge" HorizontalAlignment="Left" Classes.warning="{Binding IsTooNew}" IsVisible="{Binding VersionText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding VersionText}" />
                  </Border>
                  <Border Grid.Column="3" Name="BackupBadge" Classes="badge" HorizontalAlignment="Left" Classes.accent="{Binding IsBeforeRestore}" IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding Badge}" TextWrapping="Wrap" />
                  </Border>
                  <Grid Classes="backup-end" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Size" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Restore" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Delete" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding SizeText}" />
                    <Button Grid.Column="1" Name="RestoreBackupButton" Classes="quiet small" Content="{x:Static t:UiText.RestoreBackup}"
                            IsVisible="{Binding IsRestorable}" IsEnabled="{Binding CanRestore}" ToolTip.Tip="{Binding Hint}" ToolTip.ShowOnDisabled="True"
                            Command="{Binding $parent[ItemsControl].((vm:StorageDetailsViewModel)DataContext).RestoreCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding RestoreName}" AutomationProperties.HelpText="{Binding Hint}" />
                    <Button Grid.Column="2" Name="DeleteBackupButton" Classes="quiet small danger" Content="{x:Static t:UiText.DeleteBackup}"
                            Command="{Binding $parent[ItemsControl].((vm:StorageDetailsViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding DeleteName}" />
                  </Grid>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
