<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels"
             xmlns:startup="using:Mindweave.Application.Startup"
             xmlns:d="using:Mindweave.Desktop"
             x:Class="Mindweave.Desktop.Views.RecoveryView"
             x:DataType="vm:RecoveryViewModel">
  <ScrollViewer>
    <StackPanel Margin="48" MaxWidth="640" HorizontalAlignment="Left" Spacing="14">
      <TextBlock Classes="h1" Text="{Binding Heading}" />
      <TextBlock TextWrapping="Wrap" Text="{Binding Explanation}" />
      <SelectableTextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Detail}"
                           IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <SelectableTextBlock Classes="muted" Text="{Binding DataDirectory}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="RetryButton" Content="{x:Static d:UiText.Retry}" Command="{Binding RetryCommand}" />
        <Button Content="{x:Static d:UiText.OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" />
        <Button Content="{x:Static d:UiText.Exit}" Command="{Binding ExitCommand}" />
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding HasBackups}" Margin="0,16,0,0">
        <TextBlock FontWeight="SemiBold" Text="{x:Static d:UiText.AvailableBackups}" />
        <ItemsControl Name="BackupList" ItemsSource="{Binding Backups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="startup:BackupInfo">
              <DockPanel Margin="0,2">
                <Button DockPanel.Dock="Right" Content="{x:Static d:UiText.RestoreThis}"
                        Command="{Binding $parent[ItemsControl].((vm:RecoveryViewModel)DataContext).ChooseRestoreCommand}"
                        CommandParameter="{Binding}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Converter={x:Static d:Converters.BackupLabel}}" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Border IsVisible="{Binding IsConfirmingRestore}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock TextWrapping="Wrap" Text="{Binding RestoreConsequence}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="ConfirmRestoreButton" Content="{x:Static d:UiText.ConfirmRestore}" Command="{Binding ConfirmRestoreCommand}" />
            <Button Content="{x:Static d:UiText.Cancel}" Command="{Binding CancelRestoreCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
