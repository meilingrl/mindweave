<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels"
             xmlns:nav="using:Mindweave.Desktop.Navigation"
             xmlns:ws="using:Mindweave.Core.Workspaces"
             xmlns:cv="using:Mindweave.Desktop.ViewModels.Conversations"
             xmlns:d="using:Mindweave.Desktop"
             xmlns:t="using:Mindweave.Desktop.Text"
             xmlns:v="using:Mindweave.Desktop.Views"
             xmlns:c="using:Mindweave.Desktop.Views.Conversations"
             x:Class="Mindweave.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid ColumnDefinitions="Auto,*">
    <!-- The sidebar: resizable by its right edge, collapsible from its header or with the shortcut (S7 round 3). -->
    <Panel Name="SidebarColumn" ZIndex="1" IsVisible="{Binding !IsSidebarCollapsed}" v:Motion.Appear="SlideIn">
    <Border Name="Sidebar" Width="{Binding SidebarWidth}" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,14,10,12">
        <StackPanel DockPanel.Dock="Top" Spacing="2">
          <!-- Workspaces (2026-11-10): the switcher, its menu and the new-workspace form (SidebarHeader). -->
          <v:SidebarHeader Name="Header" />
          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,8" />
          <Button Name="NewConversationButton" Classes="nav" Command="{Binding Conversations.NewCommand}" AutomationProperties.Name="{x:Static t:UiText.NewConversation}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconPlus}" />
              <TextBlock Text="{x:Static t:UiText.NewConversation}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="NavExplore" Classes="nav" Classes.selected="{Binding IsExplore}" AutomationProperties.Name="{x:Static t:UiText.SectionExplore}"
                  Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static nav:MainSection.Explore}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconExplore}" />
              <TextBlock Text="{x:Static t:UiText.SectionExplore}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="NavSummaryNetwork" Classes="nav" Classes.selected="{Binding IsSummaryNetwork}" AutomationProperties.Name="{Binding SummaryNetworkLabel}"
                  Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static nav:MainSection.SummaryNetwork}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconSummaryNetwork}" />
              <TextBlock Text="{Binding SummaryNetworkLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- The 会话 caption carries the 选择 entry (multi-select for touch and discoverability; Ctrl/Cmd and Shift click work without it). -->
          <DockPanel Margin="10,14,0,2" IsVisible="{Binding Conversations.Items.Count, Converter={x:Static d:Converters.IsPositive}}">
            <ToggleButton Name="SelectConversationsButton" DockPanel.Dock="Right" Classes="quiet select-toggle"
                          IsChecked="{Binding Conversations.IsSelecting, Mode=OneWay}" Command="{Binding Conversations.ToggleSelectionModeCommand}"
                          ToolTip.Tip="{x:Static t:UiText.SelectConversations}" AutomationProperties.Name="{x:Static t:UiText.SelectConversations}">
              <PathIcon Data="{StaticResource IconSelect}" />
            </ToggleButton>
            <TextBlock Classes="caption" Text="{x:Static t:UiText.ConversationsHeading}" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
        <Button Name="NavSettings" DockPanel.Dock="Bottom" Classes="nav" Classes.selected="{Binding IsSettings}" AutomationProperties.Name="{x:Static t:UiText.SectionSettings}"
                Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static nav:MainSection.Settings}" VerticalAlignment="Bottom">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Classes="nav-icon" Data="{StaticResource IconSettings}" />
            <TextBlock Text="{x:Static t:UiText.SectionSettings}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,6,0,6" />
        <!-- Archived conversations are out of the tree; this quieter entry at its bottom leads to them (S6). -->
        <Button Name="ArchivedEntry" DockPanel.Dock="Bottom" Classes="nav subtle" Command="{Binding Conversations.OpenArchivedCommand}"
                IsVisible="{Binding Conversations.HasArchived}" AutomationProperties.Name="{Binding Conversations.ArchivedLabel}">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <PathIcon Width="12" Height="12" Foreground="{DynamicResource MutedText}" Data="{StaticResource IconArchive}" />
            <TextBlock Text="{Binding Conversations.ArchivedLabel}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <!-- Why an action from a row's menu did not happen, until closed or the next one. -->
        <Border Name="RowNoticePanel" DockPanel.Dock="Bottom" Classes="row-notice" Margin="0,4,0,4"
                IsVisible="{Binding Conversations.RowNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
          <DockPanel>
            <Button Name="CloseRowNoticeButton" DockPanel.Dock="Right" VerticalAlignment="Top" Classes="quiet bar-icon" Command="{Binding Conversations.CloseRowNoticeCommand}"
                    ToolTip.Tip="{x:Static t:UiText.CloseRowNotice}" AutomationProperties.Name="{x:Static t:UiText.CloseRowNotice}">
              <PathIcon Data="{StaticResource IconClose}" />
            </Button>
            <TextBlock Name="RowNotice" Classes="error" Text="{Binding Conversations.RowNotice}" TextWrapping="Wrap" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
          </DockPanel>
        </Border>
        <!-- While rows are selected (or in the 选择 mode): the count, then archive and delete, and a way out. -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,4,0,4" IsVisible="{Binding Conversations.ShowsSelectionBar}" v:Motion.Appear="Rise">
          <TextBlock Name="SelectionNotice" Classes="error" Text="{Binding Conversations.SelectionNotice}" TextWrapping="Wrap" Margin="4,0"
                     IsVisible="{Binding Conversations.SelectionNotice, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Border Name="SelectionBar" Classes="selection-bar">
            <!-- The count beside the actions while it fits whole; otherwise on its own line above them. -->
            <v:ReflowRow>
              <TextBlock Name="SelectionCount" Classes="selection-count" Text="{Binding Conversations.SelectionLabel}" />
              <StackPanel Orientation="Horizontal">
                <Button Name="ArchiveSelectedButton" Classes="quiet small" Command="{Binding Conversations.ArchiveSelectedCommand}"
                        AutomationProperties.Name="{x:Static t:UiText.Archive}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Data="{StaticResource IconArchive}" />
                    <TextBlock Text="{x:Static t:UiText.Archive}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Name="DeleteSelectedButton" Classes="quiet small danger" Command="{Binding Conversations.DeleteSelectedCommand}"
                        AutomationProperties.Name="{x:Static t:UiText.Delete}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Data="{StaticResource IconDelete}" />
                    <TextBlock Text="{x:Static t:UiText.Delete}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Border Classes="bar-divider" />
                <Button Name="ClearSelectionButton" Classes="quiet bar-icon" Command="{Binding Conversations.ClearSelectionCommand}"
                        ToolTip.Tip="{x:Static t:UiText.ClearSelection}" AutomationProperties.Name="{x:Static t:UiText.ClearSelection}">
                  <PathIcon Data="{StaticResource IconClose}" />
                </Button>
              </StackPanel>
            </v:ReflowRow>
          </Border>
        </StackPanel>
        <ScrollViewer Classes="autohide" Margin="0,0,0,4" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Name="ConversationList" ItemsSource="{Binding Conversations.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="cv:ConversationItemViewModel">
                <Panel>
                <Button Classes="nav" Classes.selected="{Binding IsSelected}" Classes.checked="{Binding IsChecked}" Margin="{Binding Depth, Converter={x:Static v:TreeIndent.Margin}}" Padding="10,5" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="{Binding MarkerHint}" IsVisible="{Binding !IsRenaming}"
                        Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).Conversations.OpenCommand}" CommandParameter="{Binding}">
                  <!-- The page toolbar's actions on this row (2026-11-10); right click, or Shift+F10 / the menu key on the focused row.
                       An entry is disabled when the page would refuse it now, and says why. Not offered while rows are selected (the bar acts then). -->
                  <Button.ContextMenu>
                    <ContextMenu Name="RowMenu" v:Motion.Appear="Popup" Opening="OnRowMenuOpening" Opened="OnRowMenuOpened" Closed="OnRowMenuClosed">
                      <MenuItem Name="RowMenuOpen" Header="{x:Static t:UiText.RowOpen}" FontWeight="SemiBold" Command="{Binding Owner.OpenCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                          <PathIcon Width="13" Height="13" Data="{StaticResource IconExplore}" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Name="RowMenuRename" Header="{x:Static t:UiText.Rename}" Command="{Binding Owner.BeginRenameRowCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}"
                                IsEnabled="{Binding CanRename}" ToolTip.Tip="{Binding RenameBlockedReason}" ToolTip.ShowOnDisabled="True">
                        <MenuItem.Icon>
                          <PathIcon Width="13" Height="13" Data="{StaticResource IconRename}" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Name="RowMenuSummarize" Header="{x:Static t:UiText.Summarize}" Command="{Binding Owner.SummarizeRowCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}"
                                IsEnabled="{Binding CanSummarize}" ToolTip.Tip="{Binding SummarizeBlockedReason}" ToolTip.ShowOnDisabled="True">
                        <MenuItem.Icon>
                          <PathIcon Width="13" Height="13" Data="{StaticResource IconSummarize}" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Name="RowMenuArchive" Header="{x:Static t:UiText.Archive}" Command="{Binding Owner.ArchiveRowCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}"
                                IsEnabled="{Binding CanArchive}" ToolTip.Tip="{Binding ArchiveBlockedReason}" ToolTip.ShowOnDisabled="True">
                        <MenuItem.Icon>
                          <PathIcon Width="13" Height="13" Data="{StaticResource IconArchive}" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Name="RowMenuDelete" Classes="danger" Header="{x:Static t:UiText.RowDelete}" Command="{Binding Owner.DeleteRowCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}"
                                IsEnabled="{Binding CanDelete}" ToolTip.Tip="{Binding DeleteBlockedReason}" ToolTip.ShowOnDisabled="True">
                        <MenuItem.Icon>
                          <PathIcon Width="13" Height="13" Data="{StaticResource IconDelete}" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </ContextMenu>
                  </Button.ContextMenu>
                  <DockPanel>
                    <!-- A branch: a small corner glyph from its parent's column, so the hierarchy reads at a glance. -->
                    <PathIcon Width="11" Height="11" Margin="-5,0,4,2" Foreground="{DynamicResource TreeGuide}" Data="{StaticResource IconTreeBranch}"
                              IsVisible="{Binding IsBranch}" VerticalAlignment="Center" />
                    <!-- Only in the 选择 mode: a drawn box at the right edge, so the boxes of every depth line up in one column
                         (the row itself takes the click, so it holds no second button). -->
                    <Border Name="RowCheck" Classes="row-check" Classes.checked="{Binding IsChecked}" DockPanel.Dock="Right"
                            IsVisible="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).Conversations.IsSelecting}">
                      <PathIcon Data="{StaticResource IconCheck}" IsVisible="{Binding IsChecked}" />
                    </Border>
                    <!-- Light markers (§6.1), one at a time: running as a small accent spinner, needs attention as a small
                         round "!", a new answer as an accent dot. The column keeps its width without one, so titles never shift. -->
                    <Panel Name="RowMarker" Classes="row-marker" DockPanel.Dock="Right" Background="Transparent"
                           ToolTip.Tip="{Binding MarkerHint}" AutomationProperties.Name="{Binding MarkerHint}">
                      <v:ActivitySpinner Classes="row-spinner" IsVisible="{Binding IsGenerating}" />
                      <Border Classes="attention-badge" IsVisible="{Binding NeedsAttention}">
                        <TextBlock Text="!" />
                      </Border>
                      <Ellipse Classes="unread-dot" IsVisible="{Binding IsUnread}" />
                    </Panel>
                    <TextBlock Name="RowTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </DockPanel>
                </Button>
                <!-- 改名 from the menu edits the title where it is, as file lists do: Enter or leaving the box saves, Esc cancels. -->
                <TextBox Name="RowRenameBox" Classes="row-rename" Margin="{Binding Depth, Converter={x:Static v:TreeIndent.Margin}}" IsVisible="{Binding IsRenaming}"
                         Text="{Binding RenameText}" AutomationProperties.Name="{x:Static t:UiText.RowRenameBox}"
                         KeyDown="OnRenameBoxKeyDown" LostFocus="OnRenameBoxLostFocus" />
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <!-- Straddles the divider: a wider grip than the 1 px line it shows on hover. The resize pointer says what it does. -->
    <Border Name="SidebarSplitter" Classes="sidebar-splitter" HorizontalAlignment="Right" Width="7" Margin="0,0,-3,0"
            AutomationProperties.Name="{x:Static t:UiText.SidebarSplitter}">
      <Border Classes="sidebar-splitter-line" />
    </Border>
    </Panel>

    <DockPanel Name="ContentArea" Grid.Column="1">
      <DockPanel DockPanel.Dock="Top" Margin="24,16,24,6">
        <!-- Only while the sidebar is collapsed; a small dot when a hidden conversation needs attention (error colour) or has a new answer (accent). -->
        <Button Name="ExpandSidebar" Classes="quiet sidebar-toggle" Command="{Binding ToggleSidebarCommand}" IsVisible="{Binding IsSidebarCollapsed}"
                Margin="-8,0,6,0" ToolTip.Tip="{Binding ExpandSidebarHint}" AutomationProperties.Name="{Binding ExpandSidebarName}">
          <Panel>
            <PathIcon Data="{StaticResource IconSidebar}" />
            <Ellipse Name="ExpandSidebarAttention" Classes="sidebar-attention" IsVisible="{Binding Conversations.HasAttention}" />
            <Ellipse Name="ExpandSidebarUnread" Classes="sidebar-attention unread" IsVisible="{Binding Conversations.ShowsUnread}" />
          </Panel>
        </Button>
        <Button Name="BackButton" Classes="quiet" Command="{Binding GoBackCommand}" IsVisible="{Binding CanGoBack}"
                Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center" Margin="-6,0,6,0"
                ToolTip.Tip="{x:Static t:UiText.Back}" AutomationProperties.Name="{x:Static t:UiText.Back}">
          <PathIcon Width="15" Height="15" Data="{StaticResource IconBack}" />
        </Button>
        <TextBlock Classes="h1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <!-- After a restore in the app (2026-11-12): what was restored, or why not; above every page until closed, never a dialog. -->
      <Border Name="RestoreNoticePanel" DockPanel.Dock="Top" Classes="notice" Classes.error="{Binding RestoreNoticeIsError}" Classes.info="{Binding !RestoreNoticeIsError}"
              Margin="24,4,24,4" IsVisible="{Binding RestoreNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
        <DockPanel>
          <Button Name="CloseRestoreNoticeButton" DockPanel.Dock="Right" VerticalAlignment="Top" Classes="quiet bar-icon" Command="{Binding CloseRestoreNoticeCommand}"
                  ToolTip.Tip="{x:Static t:UiText.CloseRestoreNotice}" AutomationProperties.Name="{x:Static t:UiText.CloseRestoreNotice}">
            <PathIcon Data="{StaticResource IconClose}" />
          </Button>
          <TextBlock Classes="notice-icon" Text="✓" VerticalAlignment="Center" IsVisible="{Binding !RestoreNoticeIsError}" />
          <TextBlock Classes="notice-icon" Text="!" VerticalAlignment="Center" IsVisible="{Binding RestoreNoticeIsError}" />
          <TextBlock Name="RestoreNotice" Text="{Binding RestoreNotice}" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
      </Border>
      <!-- Not clipped (2026-11-10): a page's toolbar and quiet buttons hang 8 px left of the text edge so their labels
           line up with it, and their hover tint and focus ring must not be cut flat there. -->
      <ContentControl Name="PageHost" Content="{Binding CurrentPage}" Margin="24,4,24,20" ClipToBounds="False" />
    </DockPanel>

    <!-- New answers (2026-11-10): small cards at the content area's bottom right, above the page, never a dialog and never
         taking the focus. One per other workspace, or per conversation of the open workspace that is not on screen; newest
         at the bottom; each closes itself after a while.
         They sit above a conversation's composer (about 90 px), so they never cover its send button;
         in Settings they stand at the bottom edge and the page ends above them (ShellView.Hints). -->
    <ItemsControl Name="NewsToasts" Grid.Column="1" ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,100"
                  ItemsSource="{Binding WorkspaceNews.Toasts, FallbackValue={x:Null}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:WorkspaceToastViewModel">
          <Border Classes="news-toast" PointerEntered="OnToastPointerEntered" PointerExited="OnToastPointerExited">
            <DockPanel>
              <Button Name="CloseNewsToast" DockPanel.Dock="Right" Classes="quiet toast-close" Command="{Binding CloseCommand}"
                      ToolTip.Tip="{x:Static t:UiText.CloseWorkspaceNewsToast}" AutomationProperties.Name="{x:Static t:UiText.CloseWorkspaceNewsToast}">
                <PathIcon Data="{StaticResource IconClose}" />
              </Button>
              <!-- Read out politely when it appears or changes; the focus stays where the user is working. -->
              <Button Name="OpenNewsToast" Classes="toast-body" CommandParameter="{Binding}"
                      Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).OpenWorkspaceNewsCommand}"
                      AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.LiveSetting="Polite">
                <DockPanel>
                  <Ellipse DockPanel.Dock="Left" Classes="unread-dot" Margin="0,6,10,0" VerticalAlignment="Top" />
                  <StackPanel Spacing="2">
                    <TextBlock Name="NewsToastText" Classes="toast-title" Text="{Binding Text}" TextWrapping="Wrap" />
                    <TextBlock Name="NewsToastAction" Classes="toast-action" Text="{Binding ActionText}" />
                  </StackPanel>
                </DockPanel>
              </Button>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <!-- The current page's attachment viewer (requirements §10.4.3), over the whole window like a dialog. -->
    <c:AttachmentViewerView Grid.Column="0" Grid.ColumnSpan="2" ZIndex="10" Name="AttachmentViewer"
                            DataContext="{Binding CurrentPage, Converter={x:Static c:AttachmentViewerView.ViewerOf}}" />
  </Grid>
</UserControl>
