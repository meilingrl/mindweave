<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels"
             xmlns:nav="using:Mindweave.Desktop.Navigation"
             xmlns:ws="using:Mindweave.Core.Workspaces"
             xmlns:cv="using:Mindweave.Desktop.ViewModels.Conversations"
             xmlns:d="using:Mindweave.Desktop"
             xmlns:v="using:Mindweave.Desktop.Views"
             x:Class="Mindweave.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid ColumnDefinitions="Auto,*">
    <!-- The sidebar: resizable by its right edge, collapsible from its header or with the shortcut (S7 round 3). -->
    <Panel Name="SidebarColumn" ZIndex="1" IsVisible="{Binding !IsSidebarCollapsed}">
    <Border Name="Sidebar" Width="{Binding SidebarWidth}" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,14,10,12">
        <StackPanel DockPanel.Dock="Top" Spacing="2">
          <!-- Workspace: the selector and its + share one height and one frame style. -->
          <DockPanel Margin="0,0,0,4">
            <Button Name="CollapseSidebar" DockPanel.Dock="Right" Classes="quiet sidebar-toggle" Command="{Binding ToggleSidebarCommand}"
                    Margin="4,0,-4,0" ToolTip.Tip="{x:Static d:UiText.CollapseSidebarTip}" AutomationProperties.Name="{x:Static d:UiText.CollapseSidebar}">
              <PathIcon Data="{StaticResource IconSidebar}" />
            </Button>
            <Button Name="ToggleNewWorkspace" DockPanel.Dock="Right" Classes="secondary" Command="{Binding ToggleCreateWorkspaceCommand}"
                    Width="32" Height="32" Padding="0" Margin="6,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    CornerRadius="{DynamicResource ControlCornerRadius}" BorderBrush="{DynamicResource TextControlBorderBrush}"
                    ToolTip.Tip="{x:Static d:UiText.NewWorkspace}" AutomationProperties.Name="{x:Static d:UiText.NewWorkspace}">
              <PathIcon Width="12" Height="12" Data="{StaticResource IconPlus}" />
            </Button>
            <ComboBox Name="WorkspacePicker" HorizontalAlignment="Stretch" Height="32" ItemsSource="{Binding Workbench.Workspaces}"
                      SelectedItem="{Binding SelectedWorkspace}" AutomationProperties.Name="工作区">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="ws:Workspace">
                  <TextBlock Text="{Binding Name.Value}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>
          <StackPanel IsVisible="{Binding IsCreatingWorkspace}" Spacing="6" Margin="0,2,0,6">
            <TextBox Name="NewWorkspaceName" Text="{Binding NewWorkspace.Name}" PlaceholderText="{x:Static d:UiText.WorkspaceNameWatermark}" />
            <TextBlock Classes="error" Text="{Binding NewWorkspace.Error}" TextWrapping="Wrap"
                       IsVisible="{Binding NewWorkspace.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Name="CreateWorkspaceButton" Classes="primary" Content="{x:Static d:UiText.Create}" Command="{Binding NewWorkspace.SubmitCommand}" HorizontalAlignment="Right" />
          </StackPanel>
          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8,0,8" />
          <Button Name="NewConversationButton" Classes="nav" Command="{Binding Conversations.NewCommand}" AutomationProperties.Name="{x:Static d:UiText.NewConversation}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconPlus}" />
              <TextBlock Text="{x:Static d:UiText.NewConversation}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="NavExplore" Classes="nav" Classes.selected="{Binding IsExplore}" AutomationProperties.Name="{x:Static d:UiText.SectionExplore}"
                  Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static nav:MainSection.Explore}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconExplore}" />
              <TextBlock Text="{x:Static d:UiText.SectionExplore}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="NavNetwork" Classes="nav" Classes.selected="{Binding IsNetwork}" AutomationProperties.Name="{x:Static d:UiText.SectionNetwork}"
                  Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static nav:MainSection.Network}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconNetwork}" />
              <TextBlock Text="{x:Static d:UiText.SectionNetwork}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" Text="{x:Static d:UiText.ConversationsHeading}" Margin="10,14,0,2"
                     IsVisible="{Binding Conversations.Items.Count, Converter={x:Static d:Converters.IsPositive}}" />
        </StackPanel>
        <Button Name="NavSettings" DockPanel.Dock="Bottom" Classes="nav" Classes.selected="{Binding IsSettings}" AutomationProperties.Name="{x:Static d:UiText.SectionSettings}"
                Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static nav:MainSection.Settings}" VerticalAlignment="Bottom">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Classes="nav-icon" Data="{StaticResource IconSettings}" />
            <TextBlock Text="{x:Static d:UiText.SectionSettings}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,6,0,6" />
        <!-- Archived conversations are out of the tree; this quieter entry at its bottom leads to them (S6). -->
        <Button Name="ArchivedEntry" DockPanel.Dock="Bottom" Classes="nav subtle" Command="{Binding Conversations.OpenArchivedCommand}"
                IsVisible="{Binding Conversations.HasArchived}" AutomationProperties.Name="{Binding Conversations.ArchivedLabel}">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <PathIcon Width="12" Height="12" Foreground="{DynamicResource MutedText}" Data="{StaticResource IconArchive}" />
            <TextBlock Text="{Binding Conversations.ArchivedLabel}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ScrollViewer Classes="autohide" Margin="0,0,0,4" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Name="ConversationList" ItemsSource="{Binding Conversations.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="cv:ConversationItemViewModel">
                <Button Classes="nav" Classes.selected="{Binding IsSelected}" Margin="{Binding Depth, Converter={x:Static v:TreeIndent.Margin}}" Padding="10,5"
                        Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).Conversations.OpenCommand}" CommandParameter="{Binding}">
                  <DockPanel>
                    <!-- A branch: a small corner glyph from its parent's column, so the hierarchy reads at a glance. -->
                    <PathIcon Width="9" Height="9" Margin="-4,0,5,3" Foreground="{DynamicResource TreeGuide}" Data="{StaticResource IconTreeBranch}"
                              IsVisible="{Binding IsBranch}" VerticalAlignment="Center" />
                    <!-- Light markers (§6.1): running as a small accent dot, needs attention as a small round "!". -->
                    <Panel DockPanel.Dock="Right" Margin="6,0,0,0" IsVisible="{Binding HasMarker}" Background="Transparent"
                           ToolTip.Tip="{Binding MarkerHint}" AutomationProperties.Name="{Binding MarkerHint}">
                      <Ellipse Classes="running-dot" IsVisible="{Binding IsGenerating}" />
                      <Border Classes="attention-badge" IsVisible="{Binding NeedsAttention}">
                        <TextBlock Text="!" />
                      </Border>
                    </Panel>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <!-- Straddles the divider: a wider grip than the 1 px line it shows on hover. The resize pointer says what it does. -->
    <Border Name="SidebarSplitter" Classes="sidebar-splitter" HorizontalAlignment="Right" Width="7" Margin="0,0,-3,0"
            AutomationProperties.Name="{x:Static d:UiText.SidebarSplitter}">
      <Border Classes="sidebar-splitter-line" />
    </Border>
    </Panel>

    <DockPanel Name="ContentArea" Grid.Column="1">
      <DockPanel DockPanel.Dock="Top" Margin="24,16,24,6">
        <!-- Only while the sidebar is collapsed; a small dot when a hidden conversation needs attention. -->
        <Button Name="ExpandSidebar" Classes="quiet sidebar-toggle" Command="{Binding ToggleSidebarCommand}" IsVisible="{Binding IsSidebarCollapsed}"
                Margin="-8,0,6,0" ToolTip.Tip="{Binding ExpandSidebarHint}" AutomationProperties.Name="{x:Static d:UiText.ExpandSidebar}">
          <Panel>
            <PathIcon Data="{StaticResource IconSidebar}" />
            <Ellipse Name="ExpandSidebarAttention" Classes="sidebar-attention" IsVisible="{Binding Conversations.HasAttention}" />
          </Panel>
        </Button>
        <Button Name="BackButton" Classes="quiet" Command="{Binding GoBackCommand}" IsVisible="{Binding CanGoBack}"
                Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center" Margin="-6,0,6,0"
                ToolTip.Tip="{x:Static d:UiText.Back}" AutomationProperties.Name="{x:Static d:UiText.Back}">
          <PathIcon Width="15" Height="15" Data="{StaticResource IconBack}" />
        </Button>
        <TextBlock Classes="h1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <ContentControl Name="PageHost" Content="{Binding CurrentPage}" Margin="24,4,24,20" />
    </DockPanel>
  </Grid>
</UserControl>
