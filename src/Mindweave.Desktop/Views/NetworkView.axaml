<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Mindweave.Desktop.ViewModels" xmlns:controls="using:Mindweave.Desktop.Controls"
 x:Class="Mindweave.Desktop.Views.NetworkView" x:DataType="vm:NetworkViewModel">
 <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20,14" RowSpacing="8">
  <StackPanel Spacing="4"><TextBlock Text="总结网络" FontSize="24" /><TextBlock Text="单击查看来源；双击或按 Enter 打开总结。拖动空白平移，Ctrl／⌘＋滚轮缩放。" FontSize="12" TextWrapping="Wrap" /></StackPanel>
  <StackPanel Grid.Row="1" Spacing="5">
   <WrapPanel x:Name="NetworkToolbar">
    <TextBox x:Name="NetworkSearch" Width="180" MinHeight="32" Padding="8,5" Margin="0,0,6,5" Text="{Binding Search, Mode=TwoWay}" PlaceholderText="查找总结标题" AutomationProperties.Name="查找总结标题" />
    <Button x:Name="NetworkFindNext" Content="下一个" Command="{Binding FindNextCommand}" Padding="9,5" Margin="0,0,6,5" AutomationProperties.Name="下一个匹配总结" />
    <Button x:Name="NetworkShowAll" Content="显示全部" Command="{Binding ShowAllCommand}" Padding="9,5" Margin="0,0,6,5" />
    <Button x:Name="NetworkArrange" Content="整理布局" Command="{Binding ArrangeCommand}" Padding="9,5" Margin="0,0,6,5" />
    <Button x:Name="NetworkZoomOut" Content="−" Command="{Binding ZoomOutCommand}" Padding="9,5" Margin="0,0,3,5" AutomationProperties.Name="缩小网络" />
    <TextBlock x:Name="NetworkScale" VerticalAlignment="Center" Margin="2,0,5,5" MinWidth="40" />
    <Button x:Name="NetworkZoomIn" Content="＋" Command="{Binding ZoomInCommand}" Padding="9,5" Margin="0,0,6,5" AutomationProperties.Name="放大网络" />
    <Button x:Name="NetworkSave" Command="{Binding SaveLayoutCommand}" Padding="9,5" Margin="0,0,6,5" AutomationProperties.Name="保存布局" ToolTip.Tip="保存布局（Ctrl+S / ⌘S）；失败后可再次点击重试">
     <StackPanel Orientation="Horizontal" Spacing="5">
      <PathIcon Width="14" Height="14" Data="M2,1 L12,1 15,4 15,15 1,15 1,1 Z M4,2 L4,6 11,6 11,2 M4,14 L4,9 12,9 12,14" />
      <TextBlock Text="保存布局" /><TextBlock x:Name="NetworkDirty" Text="●" IsVisible="{Binding Session.IsDirty}" AutomationProperties.Name="布局待保存" />
     </StackPanel>
    </Button>
    <CheckBox x:Name="NetworkDirectZoom" Content="滚轮直接缩放" FontSize="12" Margin="0,0,0,5" />
   </WrapPanel>
   <WrapPanel><TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,0,12,0" /><TextBlock Text="{Binding SearchStatusText}" FontSize="12" /><ProgressBar x:Name="NetworkSaveBusy" IsIndeterminate="True" IsVisible="{Binding Session.IsSaving}" Width="70" Height="4" Margin="10,0" AutomationProperties.Name="正在保存布局" /></WrapPanel>
   <TextBlock Text="{Binding ErrorMessage}" Foreground="#9A4122" TextWrapping="Wrap" />
  </StackPanel>
  <Border Grid.Row="2" BorderBrush="#DDE1D6" BorderThickness="1" CornerRadius="8" ClipToBounds="True" MinHeight="100">
   <Grid>
    <controls:NetworkCanvas x:Name="NetworkSurface" DataContext="{Binding}" />
    <TextBlock x:Name="NetworkEmpty" Text="还没有已保存的总结。请到探索会话中选择“总结当前会话”，再回到这里查看来源网络。" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="20" IsHitTestVisible="False" />
   </Grid>
  </Border>
  <Border Grid.Row="3" Padding="10,8" Background="#F0F1EA" CornerRadius="8">
   <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
    <WrapPanel><TextBlock Text="总结与来源" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" /><Button x:Name="NetworkOpen" Content="打开总结" Command="{Binding OpenSummaryCommand}" Padding="9,5" AutomationProperties.Name="打开选中总结" /></WrapPanel>
    <TextBox Grid.Row="1" x:Name="NetworkMetadata" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="128" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="选中总结元信息和完整来源路径" />
   </Grid>
  </Border>
 </Grid>
</UserControl>
