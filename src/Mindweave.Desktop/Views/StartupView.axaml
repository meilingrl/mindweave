<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels"
             xmlns:t="using:Mindweave.Desktop.Text"
             x:Class="Mindweave.Desktop.Views.StartupView"
             x:DataType="vm:StartupViewModel">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
    <ProgressBar IsIndeterminate="True" Width="160" />
    <TextBlock Text="{x:Static t:UiText.StartupOpening}" Classes="muted" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
