<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels"
             xmlns:d="using:Mindweave.Desktop"
             xmlns:t="using:Mindweave.Desktop.Text"
             xmlns:sys="using:System"
             x:Class="Mindweave.Desktop.Views.RootView"
             x:DataType="vm:RootViewModel">
  <!-- Everything the window shows (bilingual-ui.md §6.7): the root page and the prompts over it. A language switch puts a
       new one in the window, so its text is read again; the window itself keeps its size and position. -->
  <Panel>
    <!-- The page gets its own overlay layer (floating cards such as 创建分支 go there), so the window-level scrims
         below draw and hit-test above them, as above the rest of the page. -->
    <VisualLayerManager Name="PageLayers" EnableOverlayLayer="True">
      <ContentControl Content="{Binding Current}" />
    </VisualLayerManager>
    <!--
      Prompts over the window share one dialog surface (S7 round 3): title, a short message, buttons at the right with
      one primary; an action that stops or discards work is in the danger colour. Nothing irreversible happens before
      "stop and quit".
    -->
    <!-- Restoring a backup in the app (2026-11-12): what it does, in short sentences; 恢复 is the primary, 取消 the default
         (Enter and Esc cancel, and it has the focus). The exit sequence's prompts below draw over it while it runs. -->
    <Border Name="BackupRestoreDialog" Classes="dialog-scrim" IsVisible="{Binding BackupRestore.IsOpen}">
      <Border Classes="dialog wide">
        <StackPanel Spacing="12" DataContext="{Binding BackupRestore}" x:DataType="vm:BackupRestoreViewModel">
          <TextBlock Name="BackupRestoreTitle" Classes="dialog-title" Text="{Binding Title}" TextWrapping="Wrap" />
          <ItemsControl Name="BackupRestorePoints" ItemsSource="{Binding Points}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <DockPanel>
                  <Ellipse DockPanel.Dock="Left" Classes="dialog-bullet" />
                  <TextBlock Classes="dialog-body" Text="{Binding}" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Name="BackupRestoreProblem" Classes="notice error" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel>
              <TextBlock Classes="notice-icon" Text="!" />
              <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
          </Border>
          <StackPanel Classes="dialog-buttons">
            <Button Name="BackupRestoreCancel" Classes="secondary" Content="{x:Static t:UiText.Cancel}" Command="{Binding CancelCommand}" IsDefault="True" IsCancel="True" />
            <Button Name="BackupRestoreConfirm" Classes="primary" Content="{x:Static t:UiText.RestoreBackupConfirm}" Command="{Binding RestoreCommand}"
                    AutomationProperties.Name="{Binding Title}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <!-- Deleting backups (2026-11-12): what is freed, that it cannot be undone, and what may be the only copy; 删除 in the
         danger colour, 取消 the default and the primary. -->
    <Border Name="BackupDeleteDialog" Classes="dialog-scrim" IsVisible="{Binding BackupDeletion.IsOpen}">
      <Border Classes="dialog">
        <StackPanel Spacing="12" DataContext="{Binding BackupDeletion}" x:DataType="vm:BackupDeletionViewModel">
          <TextBlock Name="BackupDeleteTitle" Classes="dialog-title" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Name="BackupDeleteBody" Classes="dialog-body" Text="{Binding Body}" />
          <ItemsControl Name="BackupDeleteWarnings" ItemsSource="{Binding Warnings}" IsVisible="{Binding Warnings.Count, Converter={x:Static d:Converters.IsPositive}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <Border Classes="notice warning">
                  <DockPanel>
                    <TextBlock Classes="notice-icon" Text="!" />
                    <TextBlock Text="{Binding}" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Name="BackupDeleteProblem" Classes="notice error" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel>
              <TextBlock Classes="notice-icon" Text="!" />
              <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
          </Border>
          <TextBlock Classes="caption" Text="{x:Static t:UiText.BackupsDeleting}" IsVisible="{Binding IsBusy}" />
          <StackPanel Classes="dialog-buttons">
            <Button Name="BackupDeleteConfirm" Classes="secondary danger" Command="{Binding DeleteCommand}" AutomationProperties.Name="{Binding Title}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Data="{StaticResource IconDelete}" />
                <TextBlock Text="{x:Static t:UiText.Delete}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BackupDeleteCancel" Classes="primary" Content="{x:Static t:UiText.Cancel}" Command="{Binding CancelCommand}" IsDefault="True" IsCancel="True" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Name="ExitTaskPrompt" Classes="dialog-scrim" IsVisible="{Binding Exit.IsTaskPromptOpen}">
      <Border Classes="dialog">
        <StackPanel Spacing="12">
          <TextBlock Classes="dialog-title" Text="{Binding Exit.TaskTitle}" />
          <TextBlock Classes="dialog-body" Text="{Binding Exit.TaskMessage}" />
          <StackPanel Classes="dialog-buttons">
            <Button Name="ExitConfirm" Classes="secondary danger" Content="{Binding Exit.TaskConfirm}" Command="{Binding Exit.StopAndExitCommand}" />
            <Button Name="ExitCancel" Classes="primary" Content="{Binding Exit.TaskCancel}" Command="{Binding Exit.KeepRunningCommand}" IsDefault="True" IsCancel="True" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Name="ExitSavingPrompt" Classes="dialog-scrim" IsVisible="{Binding Exit.IsBusy}">
      <Border Classes="dialog">
        <TextBlock Classes="dialog-body" Text="{Binding Exit.BusyText}" />
      </Border>
    </Border>
    <Border Name="ExitFailedPrompt" Classes="dialog-scrim" IsVisible="{Binding Exit.IsFailed}">
      <Border Classes="dialog">
        <StackPanel Spacing="12">
          <TextBlock Classes="dialog-title" Text="{x:Static t:UiText.ExitSaveFailedTitle}" />
          <TextBlock Classes="dialog-body" Text="{Binding Exit.FailedBody}" />
          <StackPanel Classes="dialog-buttons">
            <Button Name="ExitReturn" Classes="secondary" Content="{x:Static t:UiText.ExitReturn}" Command="{Binding Exit.ReturnCommand}" IsCancel="True" />
            <Button Name="ExitRetry" Classes="primary" Content="{Binding Exit.FailedRetry}" Command="{Binding Exit.RetryCommand}" IsDefault="True" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Name="LayoutPromptDialog" Classes="dialog-scrim" IsVisible="{Binding LayoutPrompt.IsOpen}">
      <Border Classes="dialog">
        <StackPanel Spacing="12">
          <TextBlock Classes="dialog-title" Text="{x:Static t:UiText.LayoutUnsavedTitle}" />
          <TextBlock Classes="dialog-body" Text="{x:Static t:UiText.LayoutUnsavedBody}" />
          <Border Classes="notice error" IsVisible="{Binding LayoutPrompt.SaveFailed}">
            <DockPanel>
              <TextBlock Classes="notice-icon" Text="!" />
              <TextBlock Text="{x:Static t:UiText.LayoutSaveFailed}" />
            </DockPanel>
          </Border>
          <StackPanel Classes="dialog-buttons">
            <Button Name="LayoutCancel" Classes="quiet" Content="{x:Static t:UiText.Cancel}" Command="{Binding LayoutPrompt.CancelCommand}" IsDefault="True" IsCancel="True" />
            <Button Name="LayoutDontSave" Classes="secondary" Content="{x:Static t:UiText.LayoutDontSave}" Command="{Binding LayoutPrompt.DontSaveCommand}" />
            <Button Name="LayoutSave" Classes="primary" Content="{x:Static t:UiText.LayoutSaveAndContinue}" Command="{Binding LayoutPrompt.SaveAndContinueCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <!-- Round 4 · topic-delete: the workspace's name typed exactly enables 删除; 取消 is the default and the primary. -->
    <Border Name="WorkspaceDeleteDialog" Classes="dialog-scrim" IsVisible="{Binding WorkspaceDeletion.IsOpen}">
      <Border Classes="dialog">
        <StackPanel Spacing="12" DataContext="{Binding WorkspaceDeletion}" x:DataType="vm:WorkspaceDeletionViewModel">
          <TextBlock Classes="dialog-title" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Name="WorkspaceDeleteContents" Classes="dialog-body" Text="{Binding Contents}" />
          <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="{Binding TypeNamePrompt}" TextWrapping="Wrap" />
            <TextBox Name="WorkspaceDeleteName" Text="{Binding TypedName}" AutomationProperties.Name="{Binding TypeNamePrompt}" />
          </StackPanel>
          <Border Name="WorkspaceDeleteProblem" Classes="notice error" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel>
              <TextBlock Classes="notice-icon" Text="!" />
              <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <TextBlock Classes="caption" Text="{x:Static t:UiText.WorkspaceDeleting}" IsVisible="{Binding IsDeleting}" />
          <StackPanel Classes="dialog-buttons">
            <Button Name="WorkspaceDeleteConfirm" Classes="secondary danger" Content="{x:Static t:UiText.Delete}" Command="{Binding DeleteCommand}" />
            <Button Name="WorkspaceDeleteCancel" Classes="primary" Content="{x:Static t:UiText.Cancel}" Command="{Binding CancelCommand}" IsDefault="True" IsCancel="True" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <!-- Deleting conversations with what goes along (requirements v0.12 §8.2): counts in one sentence, 改为归档 as the
         alternative, 删除 in the danger colour; 取消 is the default and the primary. -->
    <Border Name="ConversationDeleteDialog" Classes="dialog-scrim" IsVisible="{Binding ConversationDeletion.IsOpen}">
      <Border Classes="dialog">
        <StackPanel Spacing="12" DataContext="{Binding ConversationDeletion}" x:DataType="vm:ConversationDeletionViewModel">
          <TextBlock Name="ConversationDeleteTitle" Classes="dialog-title" Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
          <TextBlock Name="ConversationDeleteContents" Classes="dialog-body" Text="{Binding Contents}" />
          <Border Name="ConversationDeleteProblem" Classes="notice error" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel>
              <TextBlock Classes="notice-icon" Text="!" />
              <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <TextBlock Classes="caption" Text="{Binding DeletingText}" IsVisible="{Binding IsBusy}" />
          <StackPanel Classes="dialog-buttons">
            <Button Name="ConversationDeleteArchive" Classes="secondary" Command="{Binding ArchiveInsteadCommand}" IsVisible="{Binding Scope.VisibleRoots.Count, FallbackValue=0, Converter={x:Static d:Converters.IsPositive}}"
                    AutomationProperties.Name="{x:Static t:UiText.ArchiveInstead}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Data="{StaticResource IconArchive}" />
                <TextBlock Text="{x:Static t:UiText.ArchiveInstead}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="ConversationDeleteConfirm" Classes="secondary danger" Command="{Binding DeleteCommand}" AutomationProperties.Name="{x:Static t:UiText.Delete}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Data="{StaticResource IconDelete}" />
                <TextBlock Text="{x:Static t:UiText.Delete}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="ConversationDeleteCancel" Classes="primary" Content="{x:Static t:UiText.Cancel}" Command="{Binding CancelCommand}" IsDefault="True" IsCancel="True" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
