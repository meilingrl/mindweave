<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Conversations"
             xmlns:v="using:Mindweave.Desktop.Views.Conversations"
             xmlns:views="using:Mindweave.Desktop.Views"
             xmlns:d="using:Mindweave.Desktop"
             xmlns:t="using:Mindweave.Desktop.Text"
             x:Class="Mindweave.Desktop.Views.Conversations.NewConversationView"
             x:DataType="vm:NewConversationViewModel">
  <Grid RowDefinitions="2*,Auto,3*">
    <v:ComposerView Grid.Row="1" Name="ComposerHost" DataContext="{Binding Composer}" MaxWidth="720" />

    <!-- Recommended questions under the input (requirements §10.3.1, 2026-11-12): at most three, each with its basis
         ("延伸自：…") when it extends a summary; click or Enter fills the input, the cross is 不感兴趣; 换一批 asks again.
         Hidden when they are off or the workspace has nothing to draw on. Top-aligned in the lower part, so the input
         does not move when they appear. -->
    <StackPanel Grid.Row="2" Name="RecommendationPanel" MaxWidth="720" Margin="0,18,0,0" Spacing="6" VerticalAlignment="Top"
                IsVisible="{Binding ShowsRecommendations}" views:Motion.Appear="Fade">
      <DockPanel Margin="4,0,0,0">
        <Button DockPanel.Dock="Right" Name="RefreshRecommendationsButton" Classes="quiet small" Command="{Binding RefreshCommand}"
                ToolTip.Tip="{x:Static t:UiText.RefreshRecommendationsTip}" AutomationProperties.Name="{x:Static t:UiText.RefreshRecommendationsName}"
                AutomationProperties.HelpText="{x:Static t:UiText.RefreshRecommendationsTip}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Data="{StaticResource IconRegenerate}" />
            <TextBlock Text="{x:Static t:UiText.RefreshRecommendations}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{x:Static t:UiText.RecommendedQuestions}" />
      </DockPanel>

      <Border Classes="card recommendations" Padding="4" IsVisible="{Binding Recommendations.Count, Converter={x:Static d:Converters.IsPositive}}">
        <ItemsControl Name="RecommendedQuestions" ItemsSource="{Binding Recommendations}"
                      AutomationProperties.Name="{x:Static t:UiText.RecommendedQuestionsListName}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecommendedQuestionViewModel">
              <DockPanel Classes="recommendation-row">
                <Button DockPanel.Dock="Right" Name="IgnoreRecommendationButton" Classes="quiet small recommendation-ignore" VerticalAlignment="Center" Margin="4,0,4,0"
                        Command="{Binding IgnoreCommand}" ToolTip.Tip="{x:Static t:UiText.IgnoreRecommendation}"
                        AutomationProperties.Name="{Binding IgnoreName}">
                  <PathIcon Data="{StaticResource IconClose}" />
                </Button>
                <Button Name="RecommendedQuestionButton" Classes="entry recommendation" Padding="12,8" Command="{Binding FillCommand}"
                        AutomationProperties.Name="{Binding AutomationName}" ToolTip.Tip="{Binding Reason}">
                  <DockPanel>
                    <PathIcon Classes="entry-icon" Data="{StaticResource IconSparkle}" />
                    <StackPanel Spacing="2">
                      <TextBlock Classes="recommended-question" Text="{Binding Question}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding BasisText}" IsVisible="{Binding HasBasis}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                </Button>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <StackPanel Name="RecommendationBusyLine" Orientation="Horizontal" Spacing="8" Margin="4,2,0,0" IsVisible="{Binding ShowsBusyLine}">
        <views:ActivitySpinner Classes="suggest-spinner" VerticalAlignment="Center" />
        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding BusyText}" />
      </StackPanel>

      <TextBlock Name="RecommendationEmptyHint" Classes="caption" Margin="4,2,0,0" TextWrapping="Wrap" Text="{x:Static t:UiText.NoRecommendationsYet}"
                 IsVisible="{Binding ShowsEmptyHint}" />

      <WrapPanel Name="RecommendationNoteLine" Margin="4,2,0,0" ItemSpacing="4" IsVisible="{Binding HasNote}">
        <TextBlock Name="RecommendationNote" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,4,0" Text="{Binding Note}" />
        <Button Name="RetryRecommendationsButton" Classes="quiet small" Content="{x:Static t:UiText.Retry}" Command="{Binding RefreshCommand}"
                IsVisible="{Binding NoteCanRetry}" AutomationProperties.Name="{x:Static t:UiText.RetryRecommendationsName}" />
        <Button Name="RecommendationSettingsButton" Classes="quiet small" Content="{x:Static t:UiText.OpenSettingsLink}"
                Command="{Binding OpenSettingsCommand}" IsVisible="{Binding NoteNeedsSettings}" />
      </WrapPanel>
    </StackPanel>
  </Grid>
</UserControl>
