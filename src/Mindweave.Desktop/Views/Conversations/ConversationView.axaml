<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Conversations"
             xmlns:v="using:Mindweave.Desktop.Views.Conversations"
             xmlns:d="using:Mindweave.Desktop"
             x:Class="Mindweave.Desktop.Views.Conversations.ConversationView"
             x:DataType="vm:ConversationViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <!-- Where this branch sits: its ancestors (each opens normally) and the passage it was created from. -->
      <StackPanel Name="BranchHeader" Spacing="6" IsVisible="{Binding IsBranch}">
        <ItemsControl Name="LineagePath" ItemsSource="{Binding Lineage}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LineageItem">
              <StackPanel Orientation="Horizontal">
                <Button Classes="link" Content="{Binding Title}"
                        Command="{Binding $parent[v:ConversationView].((vm:ConversationViewModel)DataContext).OpenConversationCommand}"
                        CommandParameter="{Binding Id}" />
                <TextBlock Classes="muted" Text="›" VerticalAlignment="Center" Margin="2,0" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel>
          <Button Name="ReturnButton" DockPanel.Dock="Right" Content="{x:Static d:UiText.ReturnToSource}"
                  Command="{Binding ReturnToSourceCommand}" VerticalAlignment="Top" Margin="8,0,0,0" />
          <Border BorderBrush="{StaticResource QuoteBar}" BorderThickness="3,0,0,0" Padding="10,2">
            <StackPanel Spacing="2">
              <TextBlock Classes="muted" FontSize="12" Text="{x:Static d:UiText.BranchFrom}" />
              <TextBlock Name="QuoteText" Text="{Binding SourceQuote}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </DockPanel>
      </StackPanel>
      <TextBlock Name="SourceNotice" Classes="error" Text="{Binding SourceNotice}" TextWrapping="Wrap"
                 IsVisible="{Binding SourceNotice, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="error" Text="{Binding BranchNotice}" TextWrapping="Wrap"
                 IsVisible="{Binding BranchNotice, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsRenaming}">
        <TextBox Name="RenameBox" Text="{Binding RenameText}" Width="320" />
        <Button Content="{x:Static d:UiText.Save}" Command="{Binding CommitRenameCommand}" IsDefault="True" />
        <Button Content="{x:Static d:UiText.Cancel}" Command="{Binding CancelRenameCommand}" />
      </StackPanel>
      <WrapPanel Orientation="Horizontal" IsVisible="{Binding !IsMissing}">
        <Button Name="RenameButton" Classes="link" Content="{x:Static d:UiText.Rename}" Command="{Binding BeginRenameCommand}"
                IsVisible="{Binding !IsRenaming}" Margin="0,0,12,0" VerticalAlignment="Center" />
        <!-- Summary at any stage (§6.4): its entry and markers, generation progress, the last failure. -->
        <Button Name="SummaryEntry" Classes="link" Content="{Binding SummaryEntryText}" Command="{Binding OpenSummaryCommand}"
                IsVisible="{Binding HasSummary}" Margin="0,0,6,0" VerticalAlignment="Center" />
        <TextBlock Name="SummaryMarkers" Classes="warning" FontSize="12" Text="{Binding SummaryMarkersText}" VerticalAlignment="Center" Margin="0,0,12,0"
                   IsVisible="{Binding SummaryMarkersText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Panel IsVisible="{Binding IsOpen}" VerticalAlignment="Center">
          <Button Name="SummarizeButton" Classes="link" Content="{Binding SummarizeLabel}" Command="{Binding SummarizeCommand}"
                  IsVisible="{Binding RunningSummary, Converter={x:Static ObjectConverters.IsNull}}" VerticalAlignment="Center" />
        </Panel>
        <!-- An archived conversation is never summarized directly (D-021). -->
        <Button Name="RestoreAndSummarizeButton" Classes="link" Content="{x:Static d:UiText.RestoreAndSummarize}" Command="{Binding RestoreAndSummarizeCommand}"
                IsVisible="{Binding IsArchived}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    IsVisible="{Binding RunningSummary, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ProgressBar IsIndeterminate="True" Width="40" VerticalAlignment="Center" />
          <TextBlock Classes="muted" FontSize="12" Text="{x:Static d:UiText.SummaryGenerating}" VerticalAlignment="Center" />
          <Button Name="StopSummaryButton" Classes="link" Content="{x:Static d:UiText.SummaryStop}" Command="{Binding StopSummaryCommand}" />
        </StackPanel>
        <Button Name="ArchiveButton" Classes="link" Content="{x:Static d:UiText.Archive}" Command="{Binding ArchiveCommand}"
                IsVisible="{Binding IsOpen}" Margin="12,0,0,0" VerticalAlignment="Center" />
        <Button Name="DeleteButton" Classes="link" Content="{x:Static d:UiText.Delete}" Command="{Binding DeleteCommand}"
                Margin="12,0,0,0" VerticalAlignment="Center" />
      </WrapPanel>
      <Border Name="ConfirmationPanel" BorderBrush="{StaticResource QuoteBar}" BorderThickness="3,0,0,0" Padding="10,6"
              IsVisible="{Binding Confirmation, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Confirmation.Message, FallbackValue=''}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Name="ConfirmButton" Content="{x:Static d:UiText.Confirm}" Command="{Binding ConfirmCommand}" />
            <Button Content="{x:Static d:UiText.Cancel}" Command="{Binding CancelConfirmationCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ArchiveNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Name="ArchiveNotice" Classes="error" FontSize="12" Text="{Binding ArchiveNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Name="OfferArchiveButton" Classes="link" Content="{x:Static d:UiText.Archive}" Command="{Binding ArchiveCommand}"
                IsVisible="{Binding OfferArchive}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Name="SummaryNotice" Classes="error" FontSize="12" Text="{Binding SummaryNotice}" TextWrapping="Wrap"
                 IsVisible="{Binding SummaryNotice, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Name="SummaryProblem" Classes="error" FontSize="12" Text="{Binding SummaryProblem}" TextWrapping="Wrap"
                 IsVisible="{Binding SummaryProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding !IsMissing}">
      <Button Name="StopButton" Content="{x:Static d:UiText.Stop}" Command="{Binding StopCommand}"
              IsVisible="{Binding RunningAnswer, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Center" />
      <TextBlock Name="ContextUsageLine" FontSize="12" TextWrapping="Wrap" Text="{Binding ContextUsageText}"
                 Classes.muted="{Binding !ContextIsTight}" Classes.warning="{Binding ContextIsTight}"
                 IsVisible="{Binding ContextUsageText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Panel IsVisible="{Binding IsOpen}">
        <v:ComposerView Name="ComposerHost" DataContext="{Binding Composer}" />
      </Panel>
      <!-- Read-only while archived: the way back is a restore, never an answer in the hidden subtree (D-021). -->
      <Border Name="ArchivedPanel" Background="{StaticResource SidebarBackground}" CornerRadius="6" Padding="10,8" IsVisible="{Binding IsArchived}">
        <DockPanel>
          <Button Name="RestoreAndContinueButton" DockPanel.Dock="Right" Content="{x:Static d:UiText.RestoreAndContinue}"
                  Command="{Binding RestoreAndContinueCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
          <TextBlock Name="ArchivedText" Text="{Binding ArchiveText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
    </StackPanel>

    <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl Name="MessageList" ItemsSource="{Binding Messages}" Margin="0,0,12,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MessageItemViewModel">
            <StackPanel Margin="0,8" Spacing="4">
              <!-- Question: right-aligned bubble. -->
              <Border IsVisible="{Binding IsUser}" HorizontalAlignment="Right" MaxWidth="560"
                      Background="{StaticResource SidebarBackground}" CornerRadius="12" Padding="12,8">
                <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" />
              </Border>
              <!-- Answer: Markdown on the page; selecting text in a finished answer offers a branch. -->
              <StackPanel IsVisible="{Binding IsAnswer}" Spacing="4" Opacity="{Binding IsSuperseded, Converter={x:Static d:Converters.SupersededOpacity}}">
                <TextBlock Classes="muted" FontSize="12" Text="{x:Static d:UiText.EarlierAttempt}" IsVisible="{Binding IsSuperseded}" />
                <v:AnswerView IsVisible="{Binding IsAnswer}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsWaiting}">
                  <ProgressBar Name="WaitingBar" IsIndeterminate="True" Width="60" VerticalAlignment="Center" />
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding WaitingLabel}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="muted" FontSize="12" Text="{x:Static d:UiText.ContextCompressedNote}" IsVisible="{Binding WasCompressed}" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="link" Content="{Binding RetryLabel}" IsVisible="{Binding CanRetry}"
                          Command="{Binding $parent[ItemsControl].((vm:ConversationViewModel)DataContext).RetryCommand}" CommandParameter="{Binding}" />
                  <TextBlock FontSize="12" Text="{Binding StateLabel}" TextWrapping="Wrap" VerticalAlignment="Center"
                             Classes.error="{Binding IsProblem}" Classes.muted="{Binding !IsProblem}"
                             IsVisible="{Binding StateLabel, Converter={x:Static ObjectConverters.IsNotNull}}"
                             ToolTip.Tip="{Binding ErrorDetail}" />
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
