<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Conversations"
             x:Class="Mindweave.Desktop.Views.Conversations.AnswerView"
             x:DataType="vm:MessageItemViewModel">
  <!--
    The Markdown renderer is created in code: it is fed either a full parse (finished) or a live builder (streaming).
    The floating 创建分支 action next to a selection is created in code too and shown in the window's overlay layer,
    so neither this answer's bounds, the page's scroll area nor the rows under the answer can clip or cover it.
  -->
  <ContentControl Name="BodyHost" />
</UserControl>
