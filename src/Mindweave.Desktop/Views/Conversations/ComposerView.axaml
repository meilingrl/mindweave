<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mindweave.Desktop.ViewModels.Conversations"
             xmlns:d="using:Mindweave.Desktop"
             x:Class="Mindweave.Desktop.Views.Conversations.ComposerView"
             x:DataType="vm:Composer">
  <StackPanel Spacing="8">
    <!-- Why the last send was refused (or why sending is paused, on a page without its own notice). -->
    <Border Name="NoticePanel" Classes="notice warning" HorizontalAlignment="Left" IsVisible="{Binding ShowNotice}">
      <DockPanel>
        <TextBlock Classes="notice-icon" Text="!" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Name="OpenSettingsFromNotice" Classes="quiet" Content="{x:Static d:UiText.OpenSettingsLink}"
                IsVisible="{Binding ShowSettingsLink}" Tag="settings" Margin="8,0,0,0" />
        <TextBlock Name="Notice" Text="{Binding Notice}" />
      </DockPanel>
    </Border>
    <Border Classes="composer">
      <DockPanel>
        <!-- Send is the page's one primary button; while an answer runs, stop takes its place. -->
        <Panel DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="8,0,0,0">
          <Button Name="SendButton" Classes="primary" Content="{x:Static d:UiText.Send}" Command="{Binding SendCommand}"
                  IsVisible="{Binding !IsAnswerRunning}" MinHeight="34" />
          <!-- Stop is the familiar round button with a square, no label (S7 round 3); its name and tooltip say 停止. -->
          <Button Name="StopButton" Classes="secondary stop" Command="{Binding StopCommand}" IsVisible="{Binding IsAnswerRunning}"
                  ToolTip.Tip="{x:Static d:UiText.Stop}" AutomationProperties.Name="{x:Static d:UiText.Stop}">
            <PathIcon Data="{StaticResource IconStop}" />
          </Button>
        </Panel>
        <TextBox Name="Input" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="220" MinHeight="34"
                 VerticalContentAlignment="Center" PlaceholderText="{x:Static d:UiText.AskPlaceholder}"
                 AutomationProperties.Name="提问" />
      </DockPanel>
    </Border>
  </StackPanel>
</UserControl>
