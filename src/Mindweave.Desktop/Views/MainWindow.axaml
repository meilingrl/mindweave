<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mindweave.Desktop.ViewModels" x:Class="Mindweave.Desktop.Views.MainWindow" x:DataType="vm:RootViewModel"
        Title="Mindweave · Codex" Width="1120" Height="760" MinWidth="880" MinHeight="600" Background="#FAFAF7">
  <Grid RowDefinitions="*,Auto">
    <ContentControl Content="{Binding Content}" />
    <Border Grid.Row="1" IsVisible="{Binding HasCloseError}" Background="#FFF0E5" Padding="16">
      <StackPanel Spacing="10"><SelectableTextBlock Text="{Binding CloseError}" TextWrapping="Wrap" Foreground="#9A4122" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="重试保存" Command="{Binding RetrySaveCommand}" IsEnabled="{Binding !IsClosing}" />
          <Button Content="重试退出" Command="{Binding RetryCloseCommand}" IsEnabled="{Binding !IsClosing}" />
          <Button Content="返回工作台" Command="{Binding ReturnToWorkbenchCommand}" IsEnabled="{Binding !IsClosing}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Grid.RowSpan="2" Background="#99000000" IsVisible="{Binding IsCloseConfirmationVisible}">
      <Border Background="#FAFAF7" CornerRadius="12" Padding="28" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <TextBlock Text="仍有正在生成或排队的任务" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="确认退出将停止这些任务并保存当前内容。取消会继续生成。" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="取消，继续阅读" Command="{Binding CancelCloseCommand}" /><Button Content="停止并退出" Command="{Binding ConfirmCloseCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
