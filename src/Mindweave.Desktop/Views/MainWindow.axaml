<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mindweave.Desktop.ViewModels"
        xmlns:d="using:Mindweave.Desktop"
        x:Class="Mindweave.Desktop.Views.MainWindow"
        x:DataType="vm:RootViewModel"
        Title="Mindweave"
        Width="1100" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
  <Panel>
    <!-- The page gets its own overlay layer (floating cards such as 创建分支 go there), so the window-level scrims
         below draw and hit-test above them, as above the rest of the page. -->
    <VisualLayerManager Name="PageLayers" EnableOverlayLayer="True">
      <ContentControl Content="{Binding Current}" />
    </VisualLayerManager>
    <!--
      Prompts over the window share one dialog surface (S7 round 3): title, a short message, buttons at the right with
      one primary; an action that stops or discards work is in the danger colour. Nothing irreversible happens before
      "stop and quit".
    -->
    <Border Name="ExitTaskPrompt" Classes="dialog-scrim" IsVisible="{Binding Exit.IsTaskPromptOpen}">
      <Border Classes="dialog">
        <StackPanel Spacing="12">
          <TextBlock Classes="dialog-title" Text="{x:Static d:UiText.ExitTitle}" />
          <TextBlock Classes="dialog-body" Text="{Binding Exit.TaskMessage}" />
          <StackPanel Classes="dialog-buttons">
            <Button Name="ExitConfirm" Classes="secondary danger" Content="{x:Static d:UiText.ExitConfirm}" Command="{Binding Exit.StopAndExitCommand}" />
            <Button Name="ExitCancel" Classes="primary" Content="{x:Static d:UiText.ExitCancel}" Command="{Binding Exit.KeepRunningCommand}" IsDefault="True" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Name="ExitSavingPrompt" Classes="dialog-scrim" IsVisible="{Binding Exit.IsBusy}">
      <Border Classes="dialog">
        <TextBlock Classes="dialog-body" Text="{x:Static d:UiText.ExitSaving}" />
      </Border>
    </Border>
    <Border Name="ExitFailedPrompt" Classes="dialog-scrim" IsVisible="{Binding Exit.IsFailed}">
      <Border Classes="dialog">
        <StackPanel Spacing="12">
          <TextBlock Classes="dialog-title" Text="{x:Static d:UiText.ExitSaveFailedTitle}" />
          <TextBlock Classes="dialog-body" Text="{x:Static d:UiText.ExitSaveFailedBody}" />
          <StackPanel Classes="dialog-buttons">
            <Button Name="ExitReturn" Classes="secondary" Content="{x:Static d:UiText.ExitReturn}" Command="{Binding Exit.ReturnCommand}" />
            <Button Name="ExitRetry" Classes="primary" Content="{x:Static d:UiText.ExitRetry}" Command="{Binding Exit.RetryCommand}" IsDefault="True" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Name="LayoutPromptDialog" Classes="dialog-scrim" IsVisible="{Binding LayoutPrompt.IsOpen}">
      <Border Classes="dialog">
        <StackPanel Spacing="12">
          <TextBlock Classes="dialog-title" Text="{x:Static d:UiText.LayoutUnsavedTitle}" />
          <TextBlock Classes="dialog-body" Text="{x:Static d:UiText.LayoutUnsavedBody}" />
          <Border Classes="notice error" IsVisible="{Binding LayoutPrompt.SaveFailed}">
            <DockPanel>
              <TextBlock Classes="notice-icon" Text="!" />
              <TextBlock Text="{x:Static d:UiText.LayoutSaveFailed}" />
            </DockPanel>
          </Border>
          <StackPanel Classes="dialog-buttons">
            <Button Name="LayoutCancel" Classes="quiet" Content="{x:Static d:UiText.Cancel}" Command="{Binding LayoutPrompt.CancelCommand}" IsDefault="True" />
            <Button Name="LayoutDontSave" Classes="secondary" Content="{x:Static d:UiText.LayoutDontSave}" Command="{Binding LayoutPrompt.DontSaveCommand}" />
            <Button Name="LayoutSave" Classes="primary" Content="{x:Static d:UiText.LayoutSaveAndContinue}" Command="{Binding LayoutPrompt.SaveAndContinueCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <!-- Round 4 · topic-delete: the workspace's name typed exactly enables 删除; 取消 is the default and the primary. -->
    <Border Name="WorkspaceDeleteDialog" Classes="dialog-scrim" IsVisible="{Binding WorkspaceDeletion.IsOpen}">
      <Border Classes="dialog">
        <StackPanel Spacing="12" DataContext="{Binding WorkspaceDeletion}" x:DataType="vm:WorkspaceDeletionViewModel">
          <TextBlock Classes="dialog-title" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Name="WorkspaceDeleteContents" Classes="dialog-body" Text="{Binding Contents}" />
          <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="{Binding TypeNamePrompt}" TextWrapping="Wrap" />
            <TextBox Name="WorkspaceDeleteName" Text="{Binding TypedName}" AutomationProperties.Name="{Binding TypeNamePrompt}" />
          </StackPanel>
          <Border Name="WorkspaceDeleteProblem" Classes="notice error" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel>
              <TextBlock Classes="notice-icon" Text="!" />
              <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <TextBlock Classes="caption" Text="{x:Static d:UiText.WorkspaceDeleting}" IsVisible="{Binding IsDeleting}" />
          <StackPanel Classes="dialog-buttons">
            <Button Name="WorkspaceDeleteConfirm" Classes="secondary danger" Content="{x:Static d:UiText.Delete}" Command="{Binding DeleteCommand}" />
            <Button Name="WorkspaceDeleteCancel" Classes="primary" Content="{x:Static d:UiText.Cancel}" Command="{Binding CancelCommand}" IsDefault="True" IsCancel="True" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
