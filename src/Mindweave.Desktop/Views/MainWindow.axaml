<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mindweave.Desktop.ViewModels"
        x:Class="Mindweave.Desktop.Views.MainWindow"
        x:DataType="vm:RootViewModel"
        Title="Mindweave"
        Width="1100" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
  <!-- The content is a RootView, put in by the code: a language switch replaces it and keeps the window (§6.7). -->
</Window>
