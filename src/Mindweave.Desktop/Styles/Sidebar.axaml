<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Mindweave.Desktop.Views">
  <!-- Sidebar: the needs-attention marker, the collapse toggle and splitter, row status and multi-select. -->
  <!-- The needs-attention marker in the sidebar: a small round "!" (running and unread: under Row status below). -->
  <Style Selector="Border.attention-badge">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="CornerRadius" Value="7.5" />
    <Setter Property="Background" Value="{DynamicResource NoticeErrorBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NoticeErrorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.attention-badge > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource NoticeErrorIcon}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The collapse / expand toggle: a familiar icon-only control, the tooltip names it and its shortcut. -->
  <Style Selector="Button.quiet.sidebar-toggle">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource NavIcon}" />
  </Style>
  <Style Selector="Button.quiet.sidebar-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="Button.quiet.sidebar-toggle PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Ellipse.sidebar-attention">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="Fill" Value="{DynamicResource NoticeErrorIcon}" />
    <Setter Property="Stroke" Value="{DynamicResource WindowBackground}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,-3,-4,0" />
  </Style>
  <!-- The splitter: invisible at rest (the sidebar's own divider shows), an accent line while hovered or dragged. -->
  <Style Selector="Border.sidebar-splitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeWestEast" />
  </Style>
  <Style Selector="Border.sidebar-splitter > Border.sidebar-splitter-line">
    <Setter Property="Width" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.sidebar-splitter:pointerover > Border.sidebar-splitter-line, Border.sidebar-splitter.dragging > Border.sidebar-splitter-line">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- Row status: the row's marker column, running spinner, unread dot. -->
  <!-- A fixed column at the row's right end, present with or without a marker, so a title never shifts or re-trims. -->
  <Style Selector="Panel.row-marker">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="v|ActivitySpinner.row-spinner">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Ellipse.unread-dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- The collapsed sidebar's expand button: the same dot as attention, in the accent colour for a new answer. -->
  <Style Selector="Ellipse.sidebar-attention.unread">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- Multi-select (requirements v0.12 §8.2): selected rows, the 选择 entry, the bar. -->
  <!-- A selected row: its own accent tint (CheckedRow), clearly apart from the grey of the conversation being shown in both themes. -->
  <Style Selector="Button.nav.checked">
    <Setter Property="Background" Value="{DynamicResource CheckedRow}" />
  </Style>
  <Style Selector="Button.nav.checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CheckedRowHover}" />
  </Style>
  <!-- The box sits at the row's right edge, outside the marker column, so all boxes share one column whatever the depth. -->
  <Style Selector="Border.row-check">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Margin" Value="8,0,-2,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.nav:pointerover Border.row-check">
    <Setter Property="BorderBrush" Value="{DynamicResource MutedText}" />
  </Style>
  <Style Selector="Border.row-check.checked, Button.nav:pointerover Border.row-check.checked">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.row-check PathIcon">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentText}" />
  </Style>
  <Style Selector="ToggleButton.select-toggle">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="ToggleButton.select-toggle PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource NavIcon}" />
  </Style>
  <Style Selector="ToggleButton.select-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverRow}" />
  </Style>
  <Style Selector="ToggleButton.select-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BadgeAccentBackground}" />
  </Style>
  <Style Selector="ToggleButton.select-toggle:checked PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- The bar: a raised strip on the window colour, the count on the left, the actions on the right, a thin rule before the way out. -->
  <Style Selector="Border.selection-bar">
    <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,4,4,4" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #14000000" />
  </Style>
  <Style Selector="TextBlock.selection-count">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.selection-bar Button.small">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="Margin" Value="2,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.selection-bar Button.small PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="Border.bar-divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="5,0,3,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
  </Style>
  <Style Selector="Button.bar-icon">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.bar-icon PathIcon">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
  </Style>
  <!-- New answers in other workspaces (2026-11-10): the closed picker's count badge, and the pop-up hints. -->
  <!-- A pill in the accent colour, the sidebar dot grown to hold a number; it scales from its centre when it pulses. -->
  <Style Selector="Border.news-badge">
    <Setter Property="MinWidth" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="CornerRadius" Value="8.5" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- Once, about 600 ms, never looping: swells a little and dims, then settles (2026-11-10). -->
  <Style Selector="Border.news-badge.pulsing">
    <Style.Animations>
      <Animation Duration="0:0:0.6" Easing="CubicEaseOut" IterationCount="1">
        <KeyFrame Cue="0%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="30%">
          <Setter Property="ScaleTransform.ScaleX" Value="1.3" />
          <Setter Property="ScaleTransform.ScaleY" Value="1.3" />
          <Setter Property="Opacity" Value="0.75" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.news-badge > TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentText}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A raised card like the selection's floating actions, a little larger; the whole card except × is one button. -->
  <Style Selector="Border.news-toast">
    <Setter Property="Width" Value="320" />
    <Setter Property="Background" Value="{DynamicResource FloatingBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="{DynamicResource FloatingShadow}" />
  </Style>
  <Style Selector="Button.toast-body">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.toast-body:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverRow}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="Button.toast-body TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.quiet.toast-close">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="2,0,2,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.quiet.toast-close PathIcon">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
  </Style>
</Styles>
