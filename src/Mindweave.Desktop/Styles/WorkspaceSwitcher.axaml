<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Mindweave.Desktop.Views">
  <!--
    Workspaces (2026-11-10): the sidebar's switcher, its menu and the inline new-workspace form, and the rows of
    设置 › 工作区. Quiet rows that belong to the sidebar rather than form fields: a tint on hover, a stronger one while
    pressed or open, an accent ring only for keyboard focus. Every colour is a theme token (Themes/Colors.axaml).
  -->

  <!-- The closed switcher: its name, the news badge and a chevron, in one rounded row. -->
  <Style Selector="Button.workspace-switcher">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="10,0,9,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.workspace-switcher:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.workspace-switcher.open /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverRow}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="Button.workspace-switcher:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
  </Style>
  <Style Selector="Button.workspace-switcher:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.switcher-name">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The chevron turns over while the menu is open. -->
  <Style Selector="PathIcon.switcher-chevron">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource NavIcon}" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.workspace-switcher:pointerover PathIcon.switcher-chevron">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="Button.workspace-switcher.open PathIcon.switcher-chevron">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>

  <!-- The menu: the floating card of the settings' suggestion list; it fades in and settles from 4 px above. -->
  <Style Selector="Border.workspace-menu">
    <Setter Property="Background" Value="{DynamicResource DialogBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Margin" Value="0,0,0,18" />
    <Setter Property="BoxShadow" Value="{DynamicResource MenuShadow}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translateY(-4px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.workspace-menu.shown">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translateY(0px)" />
  </Style>
  <Style Selector="Button.switcher-row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="8,6,10,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.switcher-row:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.switcher-row:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverRow}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.switcher-row:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.switcher-row:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
  </Style>
  <!-- The open workspace: semibold with an accent check, never a filled band. -->
  <Style Selector="Button.switcher-row.current">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Panel.switcher-check">
    <Setter Property="Width" Value="14" />
    <Setter Property="Margin" Value="0,0,9,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Panel.switcher-check PathIcon">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.switcher-row.footer">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource QuietActionText}" />
  </Style>
  <Style Selector="Button.switcher-row.footer Panel.switcher-check PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavIcon}" />
  </Style>
  <Style Selector="Border.switcher-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
  </Style>

  <!-- The inline new-workspace form: a small card under the switcher, its actions right-aligned and compact. -->
  <Style Selector="Border.new-workspace-form">
    <Setter Property="Margin" Value="0,2,0,6" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.new-workspace-form Button.primary.small">
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <!-- 设置 › 工作区: one card of rows; the open one tagged 当前; actions are quiet and right-aligned. -->
  <Style Selector="Border.workspace-row">
    <Setter Property="Padding" Value="14,10,8,10" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.workspace-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHover}" />
  </Style>
  <Style Selector="Border.workspace-row-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="14,0" />
    <Setter Property="Background" Value="{DynamicResource CardBorder}" />
  </Style>
  <Style Selector="TextBlock.workspace-row-name">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The name line and the rename box are one height, so a row does not grow when its name turns into a box. -->
  <Style Selector="DockPanel.workspace-name-line">
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="TextBox.workspace-rename">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!--
    Suggested names under a rename box (2026-11-11): quiet outlined chips that read as choices, not actions; hover and
    keyboard focus pick out the one that would be used. Theme tokens only, so both themes follow.
  -->
  <Style Selector="Button.suggestion-chip">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
    <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" BorderBrush="{DynamicResource FocusRing}" CornerRadius="14" Margin="-3" AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.suggestion-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BadgeAccentBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BadgeAccentText}" />
  </Style>
  <Style Selector="Button.suggestion-chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CheckedRowHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
  </Style>
  <Style Selector="v|ActivitySpinner.suggest-spinner">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- The rename row's 建议名称: the spark in the accent colour marks the one action that asks the model. -->
  <Style Selector="Button.suggest-names PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
</Styles>
