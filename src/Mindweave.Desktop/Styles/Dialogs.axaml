<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Mindweave.Desktop.Views">
  <!-- Dialogs: one surface for every prompt over the window. -->
  <!-- Dialogs: one surface for every prompt over the window — title, short message, buttons right-aligned with one primary. -->
  <!-- Shown: the scrim fades in, the dialog rises 8 px and grows from 98 % (Views/Motion.cs); closing is instant. -->
  <Style Selector="Border.dialog-scrim">
    <Setter Property="v:Motion.Appear" Value="Dialog" />
    <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
  </Style>
  <Style Selector="Border.dialog">
    <!-- Tab stays inside an open dialog (health check 2026-11-12); the window gives it the focus when it opens. -->
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
    <Setter Property="Background" Value="{DynamicResource DialogBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusDialog}" />
    <Setter Property="Padding" Value="24,22,24,20" />
    <Setter Property="Width" Value="420" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BoxShadow" Value="{DynamicResource DialogShadow}" />
  </Style>
  <!-- A dialog that explains several consequences, one short sentence each (the restore confirmation, 2026-11-12). -->
  <Style Selector="Border.dialog.wide">
    <Setter Property="Width" Value="480" />
  </Style>
  <!-- The share dialog (docs/design/sharing.md §6.3): as wide as its picture needs, and never taller than the window (what does not fit scrolls). -->
  <Style Selector="Border.dialog.share">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="MaxWidth" Value="760" />
    <Setter Property="Margin" Value="24" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.share-canvas">
    <Setter Property="Height" Value="248" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource SummaryNetworkBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
  </Style>
  <Style Selector="TextBlock.share-day">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource SummaryNetworkCaption}" />
  </Style>
  <!-- A conversation: its dot on the line, its tick and title just above it. -->
  <Style Selector="CheckBox.share-dot">
    <Setter Property="Height" Value="46" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="CheckBox.share-dot /template/ Ellipse.share-dot-fill">
    <Setter Property="Fill" Value="{DynamicResource SummaryNetworkBackground}" />
    <Setter Property="Stroke" Value="{DynamicResource SummaryNetworkEdge}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>
  <Style Selector="CheckBox.share-dot:checked /template/ Ellipse.share-dot-fill">
    <Setter Property="Fill" Value="{DynamicResource SummaryNetworkNode}" />
    <Setter Property="Stroke" Value="{DynamicResource SummaryNetworkNode}" />
  </Style>
  <Style Selector="CheckBox.share-dot /template/ Ellipse.share-ring">
    <Setter Property="Stroke" Value="{DynamicResource SummaryNetworkEdge}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="CheckBox.share-dot:checked /template/ Ellipse.share-ring">
    <Setter Property="Stroke" Value="{DynamicResource SummaryNetworkNode}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="CheckBox.share-dot /template/ Ellipse.share-focus">
    <Setter Property="Fill" Value="{DynamicResource SummaryNetworkHaloHover}" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="CheckBox.share-dot:pointerover /template/ Ellipse.share-focus">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="CheckBox.share-dot:focus-visible /template/ Ellipse.share-focus">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Stroke" Value="{DynamicResource SummaryNetworkRingSelected}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector="CheckBox.share-dot /template/ Border.share-tick">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{DynamicResource SummaryNetworkEdge}" />
    <Setter Property="Background" Value="{DynamicResource SummaryNetworkBackground}" />
  </Style>
  <Style Selector="CheckBox.share-dot:checked /template/ Border.share-tick">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="CheckBox.share-dot /template/ Border.share-tick > PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentText}" />
  </Style>
  <Style Selector="CheckBox.share-dot /template/ TextBlock.share-name">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource SummaryNetworkBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource SummaryNetworkLabelRead}" />
  </Style>
  <Style Selector="CheckBox.share-dot:checked /template/ TextBlock.share-name">
    <Setter Property="Foreground" Value="{DynamicResource SummaryNetworkLabel}" />
  </Style>
  <Style Selector="Border.dialog Ellipse.dialog-bullet">
    <Setter Property="Width" Value="5" />
    <Setter Property="Height" Value="5" />
    <Setter Property="Margin" Value="2,8,10,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Fill" Value="{DynamicResource MutedText}" />
  </Style>
  <Style Selector="Border.dialog TextBlock.dialog-title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="Border.dialog TextBlock.dialog-body">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
  </Style>
  <!-- A field in a prompt has the controls' corner, like the buttons under it (2026-11-10). -->
  <Style Selector="Border.dialog TextBox">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
  </Style>
  <Style Selector="Border.dialog StackPanel.dialog-buttons">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
</Styles>
