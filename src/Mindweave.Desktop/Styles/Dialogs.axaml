<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Mindweave.Desktop.Views">
  <!-- Dialogs: one surface for every prompt over the window. -->
  <!-- Dialogs: one surface for every prompt over the window — title, short message, buttons right-aligned with one primary. -->
  <!-- Shown: the scrim fades in, the dialog rises 8 px and grows from 98 % (Views/Motion.cs); closing is instant. -->
  <Style Selector="Border.dialog-scrim">
    <Setter Property="v:Motion.Appear" Value="Dialog" />
    <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
  </Style>
  <Style Selector="Border.dialog">
    <!-- Tab stays inside an open dialog (health check 2026-11-12); the window gives it the focus when it opens. -->
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
    <Setter Property="Background" Value="{DynamicResource DialogBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="24,22,24,20" />
    <Setter Property="Width" Value="420" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BoxShadow" Value="{DynamicResource DialogShadow}" />
  </Style>
  <!-- A dialog that explains several consequences, one short sentence each (the restore confirmation, 2026-11-12). -->
  <Style Selector="Border.dialog.wide">
    <Setter Property="Width" Value="480" />
  </Style>
  <Style Selector="Border.dialog Ellipse.dialog-bullet">
    <Setter Property="Width" Value="5" />
    <Setter Property="Height" Value="5" />
    <Setter Property="Margin" Value="2,8,10,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Fill" Value="{DynamicResource MutedText}" />
  </Style>
  <Style Selector="Border.dialog TextBlock.dialog-title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="Border.dialog TextBlock.dialog-body">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
  </Style>
  <!-- A field in a prompt has the controls' 6 px corner, like the buttons under it (2026-11-10). -->
  <Style Selector="Border.dialog TextBox">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.dialog StackPanel.dialog-buttons">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
</Styles>
