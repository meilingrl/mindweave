<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Motion (s7-ui-polish.md, 2026-11-10). Hover, press and selection colours switch at once, as macOS sidebars and
    menus do: a colour fade from Transparent (white at zero alpha) passed through a pale grey on the way in and out and
    read as a flash (user feedback, 2026-11-10). Only opacity and a 2 px nudge move here; nothing changes size, so no
    layout runs per frame and input is never delayed. Loaded by App only while Motion.Enabled (off in headless tests and screenshots, which then capture
    settled states). Panels and prompts appearing are in Views/Motion.cs (the Appear attached property).
  -->
  <!-- A row's chevron brightens and moves 2 px towards where it leads. -->
  <Style Selector="Button.entry PathIcon.entry-chevron">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <!-- Auto-hiding scroll bars fade in and out with the pointer instead of blinking. -->
  <Style Selector="ScrollViewer.autohide /template/ ScrollBar#PART_VerticalScrollBar">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
</Styles>
