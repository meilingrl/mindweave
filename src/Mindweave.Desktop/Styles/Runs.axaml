<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Runs (requirements §10.4.4, agent platform phase 2): the quiet activity line above an answer's text and its steps.
       Their own file, so the conversation styles stay as they are. -->
  <Style Selector="StackPanel.run-activity">
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="Button.run-activity">
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="-4,0,0,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
  </Style>
  <Style Selector="PathIcon.run-activity">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="PathIcon.run-activity.chevron">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
  </Style>
  <Style Selector="PathIcon.run-activity.chevron.expanded">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <!-- The reasoning fold (requirements §10.4.4 v0.21): quieter than the answer, the same thin line as a step, and short,
       following the newest reasoning. -->
  <Style Selector="Border.reasoning">
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="10,2,0,2" />
    <Setter Property="MaxWidth" Value="680" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="ScrollViewer.reasoning">
    <Setter Property="MaxHeight" Value="200" />
  </Style>
  <Style Selector="SelectableTextBlock.reasoning">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>
  <!-- A step: a thin line on the left, like a quotation, so the steps read as notes about the answer, not as its text. -->
  <Style Selector="Border.run-step">
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="10,4,0,4" />
    <Setter Property="MaxWidth" Value="680" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="SelectableTextBlock.run-step-title">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="SelectableTextBlock.run-step-outcome">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
  </Style>
  <Style Selector="SelectableTextBlock.run-step-outcome.problem">
    <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
  </Style>
  <!-- A failed step's failure block (D2 §2.1): its first line reads as the step's outcome did. -->
  <Style Selector="ContentControl.run-step-failure SelectableTextBlock#FailureHeadline">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
  </Style>
  <Style Selector="Button.run-step-link">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Margin" Value="-6,0,8,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
  </Style>
  <!-- Phase 3 (requirements §10.4.5): the approval card in an answer, and the 出处 list under it. -->
  <Style Selector="Border.approval">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="MaxWidth" Value="560" />
    <Setter Property="BorderBrush" Value="{DynamicResource NoticeWarningBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBlock.approval-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="SelectableTextBlock.address">
    <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- Phase 4 (requirements §10.4.6, decision M16): the arguments of a third-party call on its card. -->
  <Style Selector="Border.arguments">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="SelectableTextBlock.arguments">
    <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="StackPanel.citations">
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="MaxWidth" Value="680" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.citation">
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Margin" Value="-6,0,0,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
  </Style>
  <Style Selector="TextBlock.citation-number">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
    <Setter Property="MinWidth" Value="28" />
  </Style>
  <Style Selector="TextBlock.citation-number.plain">
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
  </Style>
  <Style Selector="Grid.plain-citation">
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style Selector="TextBlock.citation-title">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.citation-address">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource LinkText}" />
  </Style>
  <!-- The web search switch beside "+": the same size and hit area, the globe alone. 自动 draws it in the text colour,
       关 muted, 开 in the accent colour on a soft accent ground (the pill corners come from the shared "+" style). -->
  <Style Selector="Button.attach.web-search PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="Button.attach.web-search.off PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
  </Style>
  <Style Selector="Button.attach.web-search.on PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource BadgeAccentText}" />
  </Style>
  <Style Selector="Button.attach.web-search.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BadgeAccentBackground}" />
  </Style>
  <Style Selector="Button.attach.web-search:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
</Styles>
