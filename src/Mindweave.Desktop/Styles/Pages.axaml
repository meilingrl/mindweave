<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:Mindweave.Desktop.Views.Pages">
  <!-- Single pages: archived rows, the explore home mark and the recovery page's backup rows. -->
  <!-- Archived page rows: the whole row lights up on hover; the name opens, the actions sit at the right. -->
  <Style Selector="Border.archived-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="Border.archived-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverRow}" />
  </Style>
  <Style Selector="Button.list-name.archived-name">
    <Setter Property="Padding" Value="2,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.list-name.archived-name:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Explore home: a soft round mark above the page's one primary action. -->
  <!-- The summary network's legend card: raised over the canvas, as the selection's floating action is over the text. -->
  <Style Selector="Border.legend-card">
    <Setter Property="Background" Value="{DynamicResource FloatingBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorder}" />
    <Setter Property="BoxShadow" Value="{DynamicResource FloatingShadow}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector="Border.home-mark">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Background" Value="{DynamicResource BadgeAccentBackground}" />
  </Style>
  <Style Selector="Border.home-mark > PathIcon">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Foreground" Value="{DynamicResource BadgeAccentText}" />
  </Style>
  <!-- Recovery page: backups as rows in a card, the date first. -->
  <Style Selector="Border.backup-row">
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- 设置 › 使用统计 (2026-11-12): large figures, the inline price editor, empty purposes dimmed; the chart draws its own
       focus ring around the bar it is on, so the control-wide adorner is off. -->
  <!-- A backup's size and actions: at the end of its line, on a narrow page a second line. -->
  <Style Selector="Grid.backup-end">
    <Setter Property="Grid.Column" Value="4" />
  </Style>
  <Style Selector="Grid.backup-line.narrow > Grid.backup-end">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.ColumnSpan" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <!-- What a summary's version covers: between the marks and the actions, on a narrow page under them. -->
  <Style Selector="TextBlock.history-coverage">
    <Setter Property="Grid.Column" Value="5" />
    <Setter Property="Margin" Value="4,0,8,0" />
  </Style>
  <Style Selector="Grid.history-line.narrow > TextBlock.history-coverage">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.ColumnSpan" Value="6" />
    <Setter Property="Margin" Value="0,2,8,0" />
  </Style>
  <Style Selector="StackPanel.history-actions">
    <Setter Property="Grid.Column" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Grid.history-line.narrow > StackPanel.history-actions">
    <Setter Property="Grid.Row" Value="2" />
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.ColumnSpan" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="-8,2,0,0" />
  </Style>
  <!-- "Link to…" waiting for a click: its two buttons beside the hint, over a narrow canvas under it. -->
  <Style Selector="WrapPanel.link-pick-actions">
    <Setter Property="DockPanel.Dock" Value="Right" />
  </Style>
  <Style Selector="Border.link-pick-line.narrow WrapPanel.link-pick-actions">
    <Setter Property="DockPanel.Dock" Value="Bottom" />
    <Setter Property="Margin" Value="-4,4,0,0" />
  </Style>
  <!-- Below a certain width (v:Narrow) the statistics' rows stand on two lines instead of cutting their ends off. -->
  <Style Selector="UniformGrid.activity-grid">
    <Setter Property="Columns" Value="4" />
  </Style>
  <Style Selector="ItemsControl.activity.narrow UniformGrid.activity-grid">
    <Setter Property="Columns" Value="2" />
  </Style>
  <Style Selector="TextBlock.purpose-usage">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="MaxWidth" Value="320" />
  </Style>
  <Style Selector="Grid.purpose-row.narrow > TextBlock.purpose-usage">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="TextAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.stat-value">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="Border.price-editor">
    <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <Style Selector="Border.price-editor TextBlock.field-label">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style Selector="Grid.purpose-row.empty">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="p|UsageChart">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
</Styles>
