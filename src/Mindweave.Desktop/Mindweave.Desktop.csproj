<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Mindweave</AssemblyName>
    <RootNamespace>Mindweave.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The source-generated native calls of MacFilePanel. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Mindweave.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mindweave.Application\Mindweave.Application.csproj" />
    <ProjectReference Include="..\Mindweave.Infrastructure\Mindweave.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="LiveMarkdown.Avalonia" />
    <PackageReference Include="LiveMarkdown.Avalonia.Math" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mindweave.Desktop.Tests" />
  </ItemGroup>
  <!-- Which build this is, for the version line in settings: the SDK appends the commit (SourceRevisionId, from git
       or passed by scripts/daily.sh, which builds from an export without .git) to the informational version, and the
       commit's date is stamped here. A build from the source package has neither and shows only the version. -->
  <Target Name="MindweaveCommitDate" BeforeTargets="GetAssemblyAttributes" Condition="'$(MindweaveCommitDate)' == ''">
    <!-- %25 is a literal '%' in MSBuild; Exec runs a batch file on Windows, where it must be doubled. -->
    <PropertyGroup>
      <_MindweaveDateFormat Condition="'$(OS)' == 'Windows_NT'">%25%25cs</_MindweaveDateFormat>
      <_MindweaveDateFormat Condition="'$(OS)' != 'Windows_NT'">%25cs</_MindweaveDateFormat>
    </PropertyGroup>
    <Exec Command="git log -1 --format=$(_MindweaveDateFormat)" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MindweaveGitDate" />
      <Output TaskParameter="ExitCode" PropertyName="_MindweaveGitExit" />
    </Exec>
    <PropertyGroup>
      <MindweaveCommitDate Condition="'$(_MindweaveGitExit)' == '0'">$(_MindweaveGitDate)</MindweaveCommitDate>
    </PropertyGroup>
  </Target>
  <Target Name="MindweaveCommitDateAttribute" AfterTargets="MindweaveCommitDate" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup Condition="'$(MindweaveCommitDate)' != ''">
      <AssemblyMetadata Include="MindweaveCommitDate" Value="$(MindweaveCommitDate)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Licences of the third-party packages the application ships, next to the executable in every build and publish
         (health check 2026-11-12, dependencies-1). Regenerate with scripts/third-party-notices.py after changing packages. -->
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The application icon, generated by scripts/icons/app-icon.cs. The .ico is the icon of the Windows program
         (ApplicationIcon above) and of the window; the .icns goes next to the executable so that whatever makes a
         macOS bundle (scripts/daily.sh) can put it into Resources. -->
    <AvaloniaResource Include="Assets\Mindweave.ico" />
    <None Include="Assets\Mindweave.icns" Link="Mindweave.icns" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- User-visible text (Text/UiText*.cs) is used across the project. -->
    <Using Include="Mindweave.Desktop.Text" />
  </ItemGroup>
</Project>
